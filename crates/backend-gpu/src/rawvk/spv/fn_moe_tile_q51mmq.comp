#version 450

// fn_moe_tile_q51mmq (plans/96 G3) — q5_1 MoE 전문가 타일 int8 MMQ.
// q51_sg1(coopmat f16, 6.2ms/회) 대응 MMQ 판 시험. 구 스칼라 원식:
//   acc += yd·( d·(Σnib·b + Σhi·b) + mn·Σb ), sb 승순 — 그대로.
// q5_1 블록 24B = 6워드: [d|mn][qh][qs×4]. hi 비트: qh>>4k의 4비트를
// 바이트 위치 (0,1,2,3)→(4,12,20,28) 비트로 확장(fn_moe_tile_q51 원식).
// 1-wave 64스레드 × 64가중행×16할당행(v3 기하) — sdot4p→OpSDot.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][16];       // 0..7: nib, 8..15: hi 확장
shared float sAd[64];         // d
shared float sAm[64];         // mn
shared uint sB[16][8];
shared float sBd[16];
shared int sLive;  // plans/96: 밴드 내 실제(센티널 아닌) 행 수
shared float sBsum[16]; // plans/96: quant 사전계산합 — sBw 폐지

int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];
    int nt = int(min(16u, rp - uint(r0e)));
    uint row_words = uint(n_sub) * 6u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int tr = int(tid);
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    // plans/96: 밴드 실제 행 수(루프 불변) — 1회 계산.
    int live_cnt = 0;
    for (int q2 = 0; q2 < 16; q2++) {
        if (r0e + q2 < int(rp) && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
    }
    sLive = live_cnt;
    barrier();

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A: q5_1 → [nib 4워드][hi 4워드] + (d, mn).
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint wb = ebase + uint(row) * row_words + uint(sb) * 6u;
                vec2 dm2 = unpackHalf2x16(w0c[wb]);
                sAd[tr] = dm2.x;
                sAm[tr] = dm2.y;
                uint qh = w0c[wb + 1u];
                uint qsw0 = w0c[wb + 2u], qsw1 = w0c[wb + 3u];
                uint qsw2 = w0c[wb + 4u], qsw3 = w0c[wb + 5u];
                for (int k = 0; k < 8; k++) {
                    uint qs4 = (k & 3) == 0 ? qsw0 : (k & 3) == 1 ? qsw1 : (k & 3) == 2 ? qsw2 : qsw3;
                    uint nib = (k < 4) ? (qs4 & 0x0F0F0F0Fu) : ((qs4 >> 4) & 0x0F0F0F0Fu);
                    uint hb = (qh >> (4 * k)) & 0xFu;
                    uint hb_p = (hb & 1u) << 4 | (hb & 2u) << 11 | (hb & 4u) << 18 | (hb & 8u) << 25;
                    sA[tr][k] = nib;
                    sA[tr][8 + k] = hb_p;
                }
            } else {
                sAd[tr] = 0.0; sAm[tr] = 0.0;
                for (int p = 0; p < 16; p++) sA[tr][p] = 0u;
            }
        }
        // ── B: 16행 × 8워드 + 바이트합.
        {
            for (int i = int(tid); i < live_cnt * 8; i += 64) {  // plans/96: 실제 행만
                int rb = i >> 3;
                int p = i & 7;
                if (rb < nt) {
                    uint pr_ = perm_pad[uint(r0e + rb)];
                    uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                    uint wv = xq[base + uint(sb * 8 + p)];
                    sB[rb][p] = wv;
                    int ws = int(wv);
if (p == 0) {
                        sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                        uint qsb = qw + (uint(n_in) >> 5);
                        sBsum[rb] = float(int(xq[base + qsb + uint(sb * 2)])
                                      + int(xq[base + qsb + uint(sb * 2) + 1u]));
                    }
                } else {
                    sB[rb][p] = 0u;
                    if (p == 0) sBd[rb] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: Σ(nib+hi)·b는 nib·b + hi·b 두 내적으로 — sb 승순.
        {
            int ra[16];
            for (int p = 0; p < 16; p++) ra[p] = int(sA[tr][p]);
            float ad = sAd[tr], am = sAm[tr];
            for (int c = 0; c < live_cnt; c++) {  // plans/96: 실제 행만 MMA(패딩 스킵)(37.5% ALU)
                // plans/96: 2누산기 트리(정수 exact).
                int qa = sdot4p(uint(ra[0]), sB[c][0]) + sdot4p(uint(ra[2]), sB[c][2])
                       + sdot4p(uint(ra[4]), sB[c][4]) + sdot4p(uint(ra[6]), sB[c][6])
                       + sdot4p(uint(ra[8]), sB[c][0]) + sdot4p(uint(ra[10]), sB[c][2])
                       + sdot4p(uint(ra[12]), sB[c][4]) + sdot4p(uint(ra[14]), sB[c][6]);
                int qb = sdot4p(uint(ra[1]), sB[c][1]) + sdot4p(uint(ra[3]), sB[c][3])
                       + sdot4p(uint(ra[5]), sB[c][5]) + sdot4p(uint(ra[7]), sB[c][7])
                       + sdot4p(uint(ra[9]), sB[c][1]) + sdot4p(uint(ra[11]), sB[c][3])
                       + sdot4p(uint(ra[13]), sB[c][5]) + sdot4p(uint(ra[15]), sB[c][7]);
                int qsum = qa + qb;
                                acc[c] += sBd[c] * (ad * float(qsum) + am * sBsum[c]);
            }
        }
        barrier();
    }

    // ── 드레인: 직접산란.
    if (tr < nrow) {
        for (int c = 0; c < 16; c++) {
            if (c < nt) {
                uint pr2 = perm_pad[uint(r0e + c)];
                if (pr2 != 0xFFFFFFFFu) {
                    outv[pr2 * pc.n_out + uint(row0 + tr)] = acc[c];
                }
            }
        }
    }
}
