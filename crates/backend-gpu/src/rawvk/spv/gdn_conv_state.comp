#version 450
// gdn_conv_state (plans/20) — rawhip gdn_conv_state 미러 (레이스 프리 재설계).
// t행 배치 conv 후 링 갱신: st[j] = (t-k+1+j ≥ 0) ? qkv[t-k+1+j] : st_old[t+j].
// st_new[j]는 다음 배치 시작 기준 (k-1-j)스텝 이전 입력 = 절대위치 t-(k-1)+j.
// 폴백 j'=t+j는 idx<0 ⟺ j'<k-1 — 링 범위 내 보장 (이전 버전 idx 1-오프로
// st_old[3] OOB 판독 — conv 상태가 1토큰분만 적립되는 원인).
// grid (ceil(ch/64), 1).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Qkv { float qkv[]; };  // [t][ch]
layout(binding = 1) buffer St { float st[]; };             // [k-1][ch]
layout(push_constant) uniform PC { int ch; int k; int t; } pc;
void main() {
    int c = int(gl_GlobalInvocationID.x);
    if (c >= pc.ch) return;
    for (int j = 0; j < pc.k - 1; j++) {
        int idx = pc.t - pc.k + 1 + j;
        st[j * pc.ch + c] = idx >= 0 ? qkv[idx * pc.ch + c]
                                      : st[(pc.t + j) * pc.ch + c];
    }
}
