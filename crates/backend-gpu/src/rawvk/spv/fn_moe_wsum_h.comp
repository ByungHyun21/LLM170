#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// fn_moe_wsum_h (plans/105) — moe_wsum의 packed f16 ys 입력 변형(my f16 버스).
// 산술: 동일 순서 k 승순 누산 — ys 원소만 f16 사전 반올림.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Ys { uint ysw[]; };   // packed f16
layout(binding = 1) readonly buffer Wt { float wt[]; };
layout(binding = 2) buffer Out { float o[]; };
layout(push_constant) uniform PC { uint n; uint k; uint total; } pc;

float unpack16(uint w, uint hi) {
    uint h = hi != 0u ? (w >> 16) : (w & 0xFFFFu);
    float sgn = (h & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.total) return;
    uint tok = j / pc.n;
    uint c = j % pc.n;
    float acc = 0.0;
    for (uint kk = 0u; kk < pc.k; kk++) {
        uint idx = ((tok * pc.k + kk) * pc.n + c);
        float y = unpack16(ysw[idx >> 1], idx & 1u);
        acc += wt[tok * pc.k + kk] * y;
    }
    o[j] = acc;
}
