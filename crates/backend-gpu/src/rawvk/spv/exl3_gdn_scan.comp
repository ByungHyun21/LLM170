#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// exl3_gdn_scan v3 (plans/121 F2) — FLA 스타일, 전 LDS 상주.
// v1(전진대입 private dcol[64])은 scratch spill + st 재독으로 53ms/디스패치.
// v2는 private ks_acc/qs_acc[32] 동적 인덱스가 이 드라이버 컴파일러에서
// 유입 상태≠0일 때 오염(프로브 확증: S0=0 정상·S0≠0 오차 9e-2) → v3은
// ks/qs도 LDS f16로 이동, private 동적 배열 완전 제거.
// Stile은 16행×8패스(상태 전역 접근 청크당 1회 유지).
// LDS 예산 60.5KB: sk8+sv8+A2+KQ2+KS8+QS8+dc(f32)16+Stile8+misc0.5.
//   rhs(i,tid) = bp_i·(sv(i,tid) − exp(g_i)·KS(i,tid))
//   dc(i,tid)  = rhs − Σ_{j<i} A[i][j]·dc(j,tid)   (열 tid 독립, 순차 i)
//   o(i,tid)   = exp(g_i)·QS(i,tid) + Σ_{p≤i} KQ[i][p]·dc(p,tid)
// CS=32는 환원 분해 변경(규칙 10a) — scan-check 프로브로 산술 검증.
// 그리드: x = 48 V-헤드 WG. WG=128(= d_state). T≤8은 CPU AR 경로.

layout(local_size_x = 128) in;

layout(binding = 0) readonly buffer QB { float q[]; };    // [T][2048] (h_k·d)
layout(binding = 1) readonly buffer KB { float k[]; };    // [T][2048] L2 norm(HF)
layout(binding = 2) readonly buffer VB { float v[]; };    // [T][6144] lc 순열
layout(binding = 3) readonly buffer BGB { float bg[]; };  // [T][96] beta|g lc
layout(binding = 4) coherent buffer STB { float st[]; };  // [layer][h_v][d*d] r/w
layout(binding = 5) writeonly buffer OB { float outv[]; }; // [T][6144] o_lc
layout(push_constant) uniform PC {
    uint t_len;
    uint h_k; // 16
    uint h_v; // 48
    uint d;   // 128
    uint layer;
} pc;

#define CS 32
#define TILE 16

shared float16_t sk[CS * 128];  // 청크 k
shared float16_t sv[CS * 128];  // 청크 v
shared float16_t A[CS * CS];    // k·k 가중 (strict lower)
shared float16_t KQ[CS * CS];   // q·k 가중 (lower incl diag)
shared float16_t KS[CS * 128];  // k·S 상태 투영
shared float16_t QS[CS * 128];  // q·S·qscale 상태 투영
shared float dc[CS * 128];      // 전진대입 결과 (f32)
shared float Stile[TILE * 128]; // S 16행 타일 (f32, 8패스)
shared float bp[CS];
shared float gcs[CS + 1];
shared float wsm[CS];

void main() {
    uint h = gl_WorkGroupID.x;
    uint kh = h % pc.h_k;
    uint tid = gl_LocalInvocationID.x;
    uint n_chunks = (pc.t_len + CS - 1u) / CS;
    float qscale = inversesqrt(float(pc.d));
    uint st_h = pc.layer * pc.h_v * pc.d * pc.d + h * pc.d * pc.d;

    for (uint c = 0u; c < n_chunks; c++) {
        uint t0 = c * CS;
        uint n = min(pc.t_len - t0, CS);

        // ── P1 스테이징: k/v f16 + beta/g 누적 ──
        for (uint e = tid; e < CS * 128u; e += 128u) {
            uint t = e / 128u;
            uint dv = e % 128u;
            bool live = t < n;
            sk[e] = float16_t(live ? k[(t0 + t) * (pc.h_k * pc.d) + kh * 128u + dv] : 0.0);
            sv[e] = float16_t(live ? v[(t0 + t) * (pc.h_v * pc.d) + h * 128u + dv] : 0.0);
        }
        if (tid < CS) {
            float acc = 0.0;
            for (uint t = 0u; t < CS; t++) {
                acc += (t < n) ? bg[(t0 + t) * (2u * pc.h_v) + pc.h_v + h] : 0.0;
                gcs[t] = acc;
            }
            gcs[CS] = acc;
            bp[tid] = (tid < n) ? bg[(t0 + tid) * (2u * pc.h_v) + h] : 0.0;
        }
        barrier();

        // ── P2 A/KQ 빌드: 행 i 순차, tid<32가 j 담당(k·k·q·k 도트) ──
        for (uint i = 0u; i < CS; i++) {
            if (tid < CS && i < n) {
                uint j = tid;
                float dk = 0.0;
                float dq = 0.0;
                uint qbase = (t0 + i) * (pc.h_k * pc.d) + kh * 128u;
                for (uint s2 = 0u; s2 < 128u; s2++) {
                    float kj = float(sk[j * 128u + s2]);
                    dk += float(sk[i * 128u + s2]) * kj;
                    dq += q[qbase + s2] * kj;
                }
                float bi = bp[i];
                A[i * CS + j] = float16_t((j < i) ? dk * bi * exp(gcs[i] - gcs[j]) : 0.0);
                KQ[i * CS + j] = float16_t((j <= i) ? dq * qscale * exp(gcs[i] - gcs[j]) : 0.0);
            }
        }
        barrier();

        // ── P3 KS/QS: S 16행 타일 8패스 — LDS f16 누적(스레드 자기 열만) ──
        for (uint e = tid; e < CS * 128u; e += 128u) {
            KS[e] = float16_t(0.0);
            QS[e] = float16_t(0.0);
        }
        barrier();
        for (uint pass_ = 0u; pass_ < 8u; pass_++) {
            uint s2b = pass_ * TILE;
            for (uint s2p = 0u; s2p < TILE; s2p++) {
                Stile[s2p * 128u + tid] = st[st_h + (s2b + s2p) * pc.d + tid];
            }
            barrier();
            for (uint i = 0u; i < CS; i++) {
                float ak = 0.0;
                float aq = 0.0;
                uint qbase = (t0 + i) * (pc.h_k * pc.d) + kh * 128u;
                for (uint s2p = 0u; s2p < TILE; s2p++) {
                    float s_el = Stile[s2p * 128u + tid];
                    ak += float(sk[i * 128u + s2b + s2p]) * s_el;
                    aq += q[qbase + s2b + s2p] * s_el;
                }
                uint ib = i * 128u + tid;
                KS[ib] = float16_t(float(KS[ib]) + ak);
                QS[ib] = float16_t(float(QS[ib]) + aq * qscale);
            }
            barrier();
        }

        // ── P4+P5 전진대입 + 출력 (dc LDS f32, i 순차·열 tid 독립) ──
        for (uint i = 0u; i < n; i++) {
            float rhs = bp[i] * (float(sv[i * 128u + tid]) - exp(gcs[i]) * float(KS[i * 128u + tid]));
            for (uint j = 0u; j < i; j++) {
                float aij = float(A[i * CS + j]);
                if (aij != 0.0) rhs -= aij * dc[j * 128u + tid];
            }
            dc[i * 128u + tid] = rhs;
            float oi = exp(gcs[i]) * float(QS[i * 128u + tid]);
            for (uint p = 0u; p <= i; p++) {
                float w = float(KQ[i * CS + p]);
                if (w != 0.0) oi += w * dc[p * 128u + tid];
            }
            outv[(t0 + i) * (pc.h_v * pc.d) + h * 128u + tid] = oi;
        }
        barrier();

        // ── P6 상태 갱신: st = st·exp(g_tot) + Σ_j k_j·w_j·dc_j ──
        {
            float gtot = gcs[CS];
            float gt_exp = exp(gtot);
            if (tid < CS) {
                wsm[tid] = (tid < n) ? exp(gtot - gcs[tid]) : 0.0;
            }
            barrier();
            for (uint s2 = 0u; s2 < 128u; s2++) {
                float acc = st[st_h + s2 * pc.d + tid] * gt_exp;
                for (uint j = 0u; j < n; j++) {
                    acc += float(sk[j * 128u + s2]) * wsm[j] * dc[j * 128u + tid];
                }
                st[st_h + s2 * pc.d + tid] = acc;
            }
            memoryBarrierBuffer();
            barrier();
        }
    }
}
