#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv6_q6 (plans/33) — llama iqs lane 리맵을 q6_K에 적용. 블록 210B:
// ql 128B @0, qh 64B @128, sc 16B @192 (i8 직접), d f16 @208.
// ql 바이트 m(0..127): lo니블 → 원소 (m>>6)*128 + (m&63), hi니블 → +64.
// qh 바이트 = (m>>6)*32 + (m&31); lo 비트쌍 = m&32 ? bits2-3 : bits0-1,
// hi 비트쌍 = m&32 ? bits6-7 : bits4-5. 스케일 is = (m>>6)*8 + (m&63)/16
// + (lo: m&32?2:0) + (hi: m&32?6:4). 210B 블록 → 워드 리매핑 (rowb%4 ∈ {0,2}).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

shared float sh_dl[64][16];  // d·sc — 블록당 16 (n 2× 8)
shared uint sh_qh[48][16];   // qh 16워드 (64B) — 워드 어셈블후 저장

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_blk = n_in >> 8;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;

    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        uint rowb = row * n_blk * 210u;
        // 패스1: sc/d → LDS, qh 16워드 → LDS (워드 어셈블)
        for (uint b = tid; b < n_blk; b += 32u) {
            uint bw = rowb + b * 210u;
            // d f16 @208 — 워드 걸침 가능 (rowb%4 ∈ {0,2}; 210%4=2 → (rowb+208)%4 ∈ {0,2})
            uint dwi = (bw + 208u) >> 2;
            uint drem = (bw + 208u) & 3u;
            uint dw = WG(dwi);
            uint db = (dw >> (drem * 8u)) & 0xFFFFu;
            if (drem >= 2u) {
                uint w2 = WG(dwi + 1u);
                db = ((dw >> (drem * 8u)) | (w2 << ((4u - drem) * 8u))) & 0xFFFFu;
            }
            float d = unpackHalf2x16(db).x;
            // sc 16B @192 = 워드 4개 ((bw+192)%4 == rowb%4 ∈ {0,2})
            uint swi = (bw + 192u) >> 2;
            uint srem = (bw + 192u) & 3u;
            uint sw[5];
            sw[0] = WG(swi);
            sw[1] = WG(swi + 1u);
            sw[2] = WG(swi + 2u);
            sw[3] = WG(swi + 3u);
            sw[4] = WG(swi + 4u);
            for (uint j = 0u; j < 16u; j++) {
                uint absb = srem + j;   // sc 16B 전체 (워드 4+1개 걸침)
                uint sc8 = (sw[absb >> 2] >> ((absb & 3u) * 8u)) & 0xFFu;
                int sc8i = int(sc8) << 24 >> 24;   // int 시프트 = 산술(부호확장)
                sh_dl[b][j] = d * float(sc8i);
            }
            // qh 64B @128 = 16워드 — (bw+128)%4 == rowb%4
            uint qwi = (bw + 128u) >> 2;
            uint qrem = (bw + 128u) & 3u;
            if (qrem == 0u) {
                for (uint i = 0u; i < 16u; i++) sh_qh[b][i] = WG(qwi + i);
            } else {
                uint prev = WG(qwi);
                for (uint i = 0u; i < 16u; i++) {
                    uint nx = WG(qwi + 1u + i);
                    sh_qh[b][i] = (prev >> (qrem * 8u)) | (nx << ((4u - qrem) * 8u));
                    prev = nx;
                }
            }
        }
        barrier();
        // 패스2: ql 선형 스윕 — 레인 L이 ql 바이트 [4L..4L+4) (=워드 1개)
        float pacc = 0.0;
        for (uint b = 0u; b < n_blk; b++) {
            uint bw = rowb + b * 210u;
            uint lw = (bw >> 2) + tid;              // ql 워드 (rowb%4 보정 포함: bw>>2)
            uint lrem = bw & 3u;
            uint wv = WG(lw);
            if (lrem != 0u) {
                uint nx = WG(lw + 1u);
                wv = (wv >> (lrem * 8u)) | (nx << ((4u - lrem) * 8u));
            }
            // 레인의 4 ql 바이트 = 절대 ql 바이트 4L..4L+3
            for (uint k = 0u; k < 4u; k++) {
                uint m = tid * 4u + k;
                uint n = m >> 6;
                uint mm = m & 63u;
                uint byte_v = (wv >> (8u * k)) & 0xFFu;
                uint qhb = (sh_qh[b][(n * 32u + (m & 31u)) >> 2] >> (8u * ((n * 32u + (m & 31u)) & 3u))) & 0xFFu;
                uint is_base = n * 8u + ((mm & 31u) >> 4);
                // lo 니블 → 원소 n*128+mm
                uint qsel_lo = (mm & 32u) != 0u ? ((qhb >> 2u) & 3u) : (qhb & 3u);
                int q_lo = int(byte_v & 0xFu) | int(qsel_lo << 4);
                float dl_lo = sh_dl[b][is_base + ((mm & 32u) != 0u ? 2u : 0u)];
                pacc += dl_lo * float(q_lo - 32) * xa[base + b * 256u + n * 128u + mm];
                // hi 니블 → 원소 n*128+64+mm
                uint qsel_hi = (mm & 32u) != 0u ? ((qhb >> 6u) & 3u) : ((qhb >> 4u) & 3u);
                int q_hi = int((byte_v >> 4u) & 0xFu) | int(qsel_hi << 4);
                float dl_hi = sh_dl[b][is_base + ((mm & 32u) != 0u ? 6u : 4u)];
                pacc += dl_hi * float(q_hi - 32) * xa[base + b * 256u + n * 128u + 64u + mm];
            }
        }
        acc[r] = pacc;
        barrier();
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
