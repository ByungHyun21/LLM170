#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer Abuf { uint8_t a[]; };
layout(binding = 1) readonly buffer Bbuf { int8_t b[]; };
layout(binding = 2) buffer Cbuf { int c[]; };
shared uint8_t sa[16][32];
shared int8_t sb[16][32];
shared int sc[16][16];
void main() {
    uint tid = gl_LocalInvocationID.x;
    for (int i = int(tid); i < 16*32; i += 64) {
        int m = i >> 5, k = i & 31;
#ifdef BASIS_T1
        sa[m][k] = uint8_t((m + k) % 16);   // 램프
        sb[m][k] = int8_t(k == m ? 1 : 0);  // 항등
#else
        // 부호 프로브: A[0][k]=1 전체, B[0][k]=k-16(음수 포함).
        sa[m][k] = uint8_t(m == 0 ? 1 : 0);
        sb[m][k] = int8_t(m == 0 ? (k - 16) : 0);
#endif
    }
    barrier();
    coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma0, ma1;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb0, mb1;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    // 매핑 직독: 로드된 A/B 타일을 그대로 스토어(요소 배치 확인).
    coopMatLoad(ma0, a, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb0, b, 0, 32, gl_CooperativeMatrixLayoutColumnMajor);
#ifdef DUMP_A
    {
        shared uint8_t sd[16][16];
        if (true) {
            coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> tmp =
                coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
            // u8→int 직접 스토어 불가 — 요소 전사는 불가하므로 곱 경로 유지.
        }
    }
#endif
    acc = coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    acc = coopMatMulAdd(ma0, mb0, acc);
    coopMatLoad(ma1, a, 16, 32, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb1, b, 16, 32, gl_CooperativeMatrixLayoutColumnMajor);
    acc = coopMatMulAdd(ma1, mb1, acc);
    coopMatStore(acc, sc[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (int i = int(tid); i < 256; i += 32) {
        int m = i >> 4, r = i & 15;
        int want = 0;
        for (int k = 0; k < 32; k++) want += int(sa[m][k]) * int(sb[r][k]);
        c[i] = sc[m][r];  // 원시값(호스트서 가설 대조)
    }
}
