#version 450

// fn_tile_q8d (plans/96 G3) — dense q8_0 MMQ, q51mmq 승리 기하(1-wave
// 64스레드 × 64가중행 × 16토큰)의 dense 판. 구 q8mmq(64×64/256스레드,
// 202 t/s 부정)와 다른 기하. A측 q8_0_relayout(q8r) 무손실 배치 — dense
// q8mmq 자산. 산술: acc += d_a·d_b·Σ(q·b), sb 승순 f32 누산(정수 exact).
// MoE 판과의 차이: rowexp/perm 없음 — B행=토큰 직접, out[토큰][n_out].
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };   // q8r 전체
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint xq_w;
} pc;

shared uint sA[64][8];
shared float sAd[64];
shared uint sB[16][8];
shared float sBd[16];

int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

void main() {
    uint bid = gl_WorkGroupID.x;   // 가중 64행 블록
    uint tidy = gl_WorkGroupID.y;  // 토큰 16 블록
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int t0 = int(tidy) * 16;
    int nt = int(min(16u, pc.t - uint(t0)));
    uint qw = uint(n_in >> 2);
    uint row_words = qw + uint(n_sub);

    int tr = int(tid);
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A: q8r 직판독.
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint rbase = uint(row) * row_words;
                for (int p = 0; p < 8; p++) {
                    sA[tr][p] = w0c[rbase + uint(sb * 8 + p)];
                }
                sAd[tr] = uintBitsToFloat(w0c[rbase + qw + uint(sb)]);
            } else {
                for (int p = 0; p < 8; p++) sA[tr][p] = 0u;
                sAd[tr] = 0.0;
            }
        }
        // ── B: 토큰 16행.
        {
            for (int i = int(tid); i < 16 * 8; i += 64) {
                int rb = i >> 3;
                int p = i & 7;
                if (rb < nt) {
                    uint base = uint(t0 + rb) * pc.xq_w;
                    sB[rb][p] = xq[base + uint(sb * 8 + p)];
                    if (p == 0) {
                        sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    }
                } else {
                    sB[rb][p] = 0u;
                    if (p == 0) sBd[rb] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 자기 가중행 × 16토큰.
        {
            int ra[8];
            for (int p = 0; p < 8; p++) ra[p] = int(sA[tr][p]);
            float ad = sAd[tr];
            for (int c = 0; c < 16; c++) {
                int qsum = 0;
                for (int p = 0; p < 8; p++) {
                    qsum += sdot4p(uint(ra[p]), sB[c][p]);
                }
                acc[c] += sBd[c] * (ad * float(qsum));
            }
        }
        barrier();
    }

    // ── 드레인: out[토큰][n_out].
    if (tr < nrow) {
        for (int c = 0; c < 16; c++) {
            if (c < nt) {
                outv[uint(t0 + c) * pc.n_out + uint(row0 + tr)] = acc[c];
            }
        }
    }
}
