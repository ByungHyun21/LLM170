#version 450
// copy_off (plans/19 Phase A) — src[0..n) → dst[dst_off..dst_off+n).
// MTP concat(enorm|hnorm)용 오프셋 복사. t=1 검증 경로 불변 (신규 커널).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Src { float s[]; };
layout(std430, binding = 1) buffer Dst { float d[]; };
layout(push_constant) uniform PC { int n; int dst_off; } pc;
void main() {
    int j = int(gl_GlobalInvocationID.x);
    if (j >= pc.n) return;
    d[pc.dst_off + j] = s[j];
}
