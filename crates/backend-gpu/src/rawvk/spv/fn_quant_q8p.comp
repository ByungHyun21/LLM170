#version 450
#extension GL_KHR_shader_subgroup_basic : require

// fn_quant_q8p (plans/105 원장 80 — 클린 재구현) — mxsel 생산 직후 1회 팩 정량.
// 레이아웃(블록=32원소당 10워드, 행블록 순): [qs 8워드][d f32][Σ 정수 u32].
// 산술은 quant_q8과 문자 동일 — Σ = int(s0)+int(s1)는 |Σ|≤4064 정수라 u32 비트 보존.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Xbuf { float xf[]; };
layout(binding = 1) buffer Qbuf { uint xq[]; };
layout(push_constant) uniform PC {
    uint n_in; uint t; uint row_words;   // row_words = (n_in/32)*10
} pc;

void main() {
    uint tok = gl_WorkGroupID.y;
    uint lb = gl_WorkGroupID.x * 64u + gl_LocalInvocationID.x;
    uint nblk = pc.n_in >> 5;
    if (lb >= nblk) return;
    uint base = tok * pc.n_in;
    uint qbase = tok * pc.row_words + lb * 10u;
    int b = int(lb) << 5;
    float amax = 0.0;
    for (int i = 0; i < 32; i++) amax = max(amax, abs(xf[base + uint(b + i)]));
    float d = amax / 127.0f;
    float id = d != 0.0f ? 1.0f / d : 0.0f;
    uint qs0 = 0u, qs1 = 0u;
    for (int wi = 0; wi < 8; wi++) {
        uint word = 0u;
        for (int k = 0; k < 4; k++) {
            float xv = xf[base + uint(b + wi * 4 + k)] * id;
            float r = xv >= 0.0 ? float(int(xv + 0.5)) : -float(int(0.5 - xv));
            float c = clamp(r, -127.0, 127.0);
            word |= (uint(int(c)) & 0xFFu) << uint(k * 8);
        }
        xq[qbase + uint(wi)] = word;
        uint sd = 0u;
        for (int k = 0; k < 4; k++) {
            int bytev = int((word >> uint(8 * k)) & 0xFFu) << 24 >> 24;
            sd += uint(bytev);
        }
        if (wi < 4) qs0 += sd; else qs1 += sd;
    }
    xq[qbase + 8u] = floatBitsToUint(d);
    xq[qbase + 9u] = qs0 + qs1;
}
