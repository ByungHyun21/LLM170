#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : enable

// fn_moe_tile_llmmq (plans/105 P2 — llama.cpp mul_mmq(MUL_MAT_ID) 포트).
// 원판 대비 결정적 차이: BN=64 토큰 밴드(원판 16) — 평균 10행/전문가 ≥
// 커버 → 전문가 가중을 정확히 1회 판독하는 WG(원판은 핫 전문가 2-3밴드
// 재판독). A는 raw 블록 리팩(스케일 산수 iqs==0만) 후 워프 타일 레지스터
// MMA(WM32×WN32, TM4/TN2 — 스레드당 16 누산기, A 레지스터 재사용 ×4).
// 산술: 32블록당 8개 int 내적 + (d·s·qsum − dmin·m·Σb) 항등식 — 원판
// mmq와 동일 문자·승순(블록 경계 오름차순).
// 실측 근거: llama 노드 타이밍 q4_K MUL_MAT_ID 2897µs/콜 vs 원판 4690µs.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 11) readonly buffer Pm { uint perm[]; };   // 컴팩트(전문가 정렬)
layout(binding = 12) readonly buffer Off { uint offv[]; };  // [ne+1]
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words;
    uint xq_w; uint ne; uint row_words_p;
} pc;

#define BM 64
#define BN 32
#define BK 32
#define BK_STEP 4
#define WM 32
#define WN 32
#define WMITER 2
#define TM 4
#define TN 2
#define WARP 32
#define WNITER ((WM * WN) / (WARP * TM * TN * WMITER))
#define WSUBM (WM / WMITER)
#define WSUBN (WN / WNITER)

// 캐시 — 스칼라 공유배열(구조체 복사는 패처 수렴 규칙을 깬다).
shared uint  buf_aq[BK_STEP * BM][4];
shared vec2 buf_ad[BK_STEP * BM];
shared uint  buf_bq[BK_STEP * BN][8];
shared vec2  buf_bd[BK_STEP * BN];
shared int shared_eq_cnt;

// sdot4p 센티널 — build_spv가 OpSDot로 자동 패치.
int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

float f16x(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    uint e = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int nkb = n_in >> 5;              // 32원소 블록 수
    int row0 = int(gl_WorkGroupID.x) * BM;
    int nrow = int(min(uint(BM), pc.n_out - uint(row0)));
    uint row_lo = offv[e];
    uint row_hi = offv[e + 1u];
    if (row_lo >= row_hi || nrow <= 0) return;

    uint qw = uint(n_in >> 2);
    uint row_words = uint(n_in >> 8) * 36u;   // q4_K 144B 슈퍼블록 = 36워드
    uint ebase = e * (pc.per_expert_bytes >> 2);

    // 워프 타일 좌표(llama 원식).
    const uint warp_i = tid / WARP;
    const uint tiw = tid % WARP;
    const uint tiwr = tiw % (WSUBM / TM);
    const uint tiwc = tiw / (WSUBM / TM);
    const uint warp_r = warp_i % (BM / WM);
    const uint warp_c = warp_i / (BM / WM);
    // A 스테이징 분담: 64스레드 × QUANT_R2 → 행당 1스레드/2블록.
    const uint loadr_a = tid % 16u;   // (BK/QUANT_R_MMQ=2)/2 … 단순화: 워드 담당
    const uint loadc_a = tid / 16u;

    for (uint sg = row_lo; sg < row_hi; sg += BN) {
        int live = int(min(uint(BN), row_hi - sg));
        float sums[WMITER * TM * WNITER * TN];
        [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN; i++) sums[i] = 0.0;

        for (int g = 0; g < nkb; g += BK_STEP) {
            int lim = min(BK_STEP, nkb - g);
            // ── A: W6 — 오라클(검증) 산술로 평면 8워드 스테이징.
            {
                int arow = row0 + int(tid);
                // ── A/B 스테이징(W21) — 행 우선 스레드 재분할(코얼레싱):
            // A: 스레드 t = (행 t>>2, 블록 t&3) — 4스레드가 같은 행의
            // 연속 블록 워드열을 판독. B: 스레드 t = (행 t>>2, 블록 t&3).
            {
                int srow = row0 + int(tid >> 2);
                int sq = int(tid & 3u);
                if (srow < int(pc.n_out) && sq < lim) {
                    int gb = g + sq;
                    int j = gb & 7;
                    uint wq4 = ebase + uint(srow) * row_words + uint(gb >> 3) * 36u;
                    float d = f16x(w0c[wq4] & 0xFFFFu);
                    float dmin = f16x(w0c[wq4] >> 16);
                    uint s_v, m_v;
                    if (j < 4) {
                        uint b_s = (w0c[wq4 + 1u] >> (uint(j) * 8u)) & 0xFFu;
                        uint b_m = (w0c[wq4 + 2u] >> (uint(j) * 8u)) & 0xFFu;
                        s_v = b_s & 63u; m_v = b_m & 63u;
                    } else {
                        uint b_p4  = (w0c[wq4 + 3u] >> (uint(j - 4) * 8u)) & 0xFFu;
                        uint b_j   = (w0c[wq4 + 2u] >> (uint(j - 4) * 8u)) & 0xFFu;
                        uint b_lo  = (w0c[wq4 + 1u] >> (uint(j - 4) * 8u)) & 0xFFu;
                        s_v = (b_p4 & 0xFu) | ((b_lo >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((b_j >> 6) << 4);
                    }
                    buf_ad[sq * BM + (int(tid) >> 2)] = vec2(d * float(s_v), dmin * float(m_v));
                    uint qb2 = wq4 + 4u + uint((j >> 1) * 8u);
                    uint nib2 = (j & 1) != 0 ? 4u : 0u;
                    [[unroll]] for (int w = 0; w < 4; w++) {
                        uint w0 = w0c[qb2 + uint(w * 2)];
                        uint w1 = w0c[qb2 + uint(w * 2 + 1)];
                        uint v0 = (w0 >> nib2) & 0x0F0F0F0Fu;
                        uint v1 = (w1 >> nib2) & 0x0F0F0F0Fu;
                        buf_aq[sq * BM + (int(tid) >> 2)][w] = v0 | (v1 << 4);
                    }
                } else if (sq < BK_STEP) {
                    buf_ad[sq * BM + (int(tid) >> 2)] = vec2(0.0);
                    for (int w = 0; w < 4; w++) buf_aq[sq * BM + (int(tid) >> 2)][w] = 0u;
                }
                // 행 16..63은 2패스 — 나머지 행들도 같은 코드가 stride로 커버
                // 없음: 64스레드/4 = 16행/패스 → 4패스 필요. 간단히 루프:
                for (int pass = 1; pass < 4; pass++) {
                    int r2 = int(tid >> 2) + pass * 16;
                    int q2 = sq;
                    if (row0 + r2 < int(pc.n_out) && q2 < lim) {
                        int gb2 = g + q2;
                        int j2 = gb2 & 7;
                        uint wq4b = ebase + uint(row0 + r2) * row_words + uint(gb2 >> 3) * 36u;
                        float db = f16x(w0c[wq4b] & 0xFFFFu);
                        float dminb = f16x(w0c[wq4b] >> 16);
                        uint s_v2, m_v2;
                        if (j2 < 4) {
                            uint b_s = (w0c[wq4b + 1u] >> (uint(j2) * 8u)) & 0xFFu;
                            uint b_m = (w0c[wq4b + 2u] >> (uint(j2) * 8u)) & 0xFFu;
                            s_v2 = b_s & 63u; m_v2 = b_m & 63u;
                        } else {
                            uint b_p4  = (w0c[wq4b + 3u] >> (uint(j2 - 4) * 8u)) & 0xFFu;
                            uint b_j   = (w0c[wq4b + 2u] >> (uint(j2 - 4) * 8u)) & 0xFFu;
                            uint b_lo  = (w0c[wq4b + 1u] >> (uint(j2 - 4) * 8u)) & 0xFFu;
                            s_v2 = (b_p4 & 0xFu) | ((b_lo >> 6) << 4);
                            m_v2 = (b_p4 >> 4) | ((b_j >> 6) << 4);
                        }
                        buf_ad[q2 * BM + r2] = f16vec2(float16_t(db * float(s_v2)), float16_t(dminb * float(m_v2)));
                        uint qb3 = wq4b + 4u + uint((j2 >> 1) * 8u);
                        uint nib3 = (j2 & 1) != 0 ? 4u : 0u;
                        [[unroll]] for (int w = 0; w < 4; w++) {
                            uint w0 = w0c[qb3 + uint(w * 2)];
                            uint w1 = w0c[qb3 + uint(w * 2 + 1)];
                            uint v0 = (w0 >> nib3) & 0x0F0F0F0Fu;
                            uint v1 = (w1 >> nib3) & 0x0F0F0F0Fu;
                            buf_aq[q2 * BM + r2][w] = v0 | (v1 << 4);
                        }
                    }
                }
            }
            {
                for (int i = int(tid); i < live * BK_STEP; i += 64) {
                    int rb = i / BK_STEP;
                    int q = i % BK_STEP;
                    int sb = g + q;
                    uint pr_ = perm[sg + uint(rb)];
                    // 팩 레이아웃(원장 80): [qs8][d f32][Σ u32] 블록당 10워드.
                    uint pbase = pr_ * pc.row_words_p + uint(sb) * 10u;
                    buf_bd[q * BN + rb] = vec2(uintBitsToFloat(xq[pbase + 8u]),
                                               float(int(xq[pbase + 9u])));
                    for (int w = 0; w < 8; w++) {
                        buf_bq[q * BN + rb][w] = xq[pbase + uint(w)];
                    }
                }
                for (int i = live * BK_STEP + int(tid); i < BK_STEP * BN; i += 64) {
                    int rb = i / BK_STEP;
                    int q = i % BK_STEP;
                    buf_bd[q * BN + rb] = vec2(0.0, 0.0);
                    for (int w = 0; w < 8; w++) buf_bq[q * BN + rb][w] = 0u;
                }
            }
            memoryBarrierShared();
            barrier();
            // 자기검증: MMA 첫 (wsic=0,cc=0,wsir=0,cr=0) 슬롯에서 전 워드 비교 후 eq 반영.
            {
                uint arow2 = warp_r * WM + tiwr * TM;
                for (int q = 0; q < lim; q++) {
                    int gb = g + q;
                    int j = gb & 7;
                    uint wq4 = ebase + uint(row0 + int(arow2)) * row_words + uint(gb >> 3) * 36u;
                    uint qb3 = wq4 + 4u + uint((j >> 1) * 8u);
                    bool hi3 = (j & 1) != 0;
                    for (int w3 = 0; w3 < 8; w3++) {
                        uint wd3 = w0c[qb3 + w3];
                        uint g3 = hi3 ? ((wd3 >> 4) & 0x0F0F0F0Fu) : (wd3 & 0x0F0F0F0Fu);
                        if (buf_aq[q * BM + arow2][w3] != g3) shared_eq_cnt = 1;
                    }
                }
            }
            barrier();
            for (int q = 0; q < lim; q++) {
                int gb = g + q;
                int j = gb & 7;
                [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                    [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                        int tok_i = int(warp_c * WN + wsic * WSUBN + tiwc * TN + cc);
                        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                            [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                                const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                                if (tok_i < live) {
                                    uint pr_ = perm[sg + uint(tok_i)];
                                    uint base = pr_ * pc.xq_w;
                                    float bd = uintBitsToFloat(xq[base + qw + uint(gb)]);
                                    uint qsb2 = qw + (uint(n_in) >> 5);
                                    float bs = float(int(xq[base + qsb2 + uint(gb * 2)])
                                                   + int(xq[base + qsb2 + uint(gb * 2) + 1u]));
                                    // A행 글로벌 직독(오라클과 동일 체인)
                                    uint p0 = buf_aq[q * BM + warp_r * WM + wsir * WSUBM + tiwr * TM + cr][0];
                                    uint p1 = buf_aq[q * BM + warp_r * WM + wsir * WSUBM + tiwr * TM + cr][1];
                                    uint p2 = buf_aq[q * BM + warp_r * WM + wsir * WSUBM + tiwr * TM + cr][2];
                                    uint p3 = buf_aq[q * BM + warp_r * WM + wsir * WSUBM + tiwr * TM + cr][3];
                                    uint bbase = q * BN + warp_c * WN + wsic * WSUBN + tiwc * TN + cc;
                                    int qsum = sdot4p((p0      ) & 0x0F0F0F0Fu, buf_bq[bbase][0])
                                             + sdot4p((p0 >> 4 ) & 0x0F0F0F0Fu, buf_bq[bbase][1])
                                             + sdot4p((p1      ) & 0x0F0F0F0Fu, buf_bq[bbase][2])
                                             + sdot4p((p1 >> 4 ) & 0x0F0F0F0Fu, buf_bq[bbase][3])
                                             + sdot4p((p2      ) & 0x0F0F0F0Fu, buf_bq[bbase][4])
                                             + sdot4p((p2 >> 4 ) & 0x0F0F0F0Fu, buf_bq[bbase][5])
                                             + sdot4p((p3      ) & 0x0F0F0F0Fu, buf_bq[bbase][6])
                                             + sdot4p((p3 >> 4 ) & 0x0F0F0F0Fu, buf_bq[bbase][7]);
                                    vec2 ad2 = vec2(buf_ad[q * BM + warp_r * WM + wsir * WSUBM + tiwr * TM + cr]);
                                    vec2 bd2 = buf_bd[q * BN + warp_c * WN + wsic * WSUBN + tiwc * TN + cc];
                                    sums[sums_idx] += bd2.x * (ad2.x * float(qsum) - ad2.y * bd2.y);
                                }
                            }
                        }
                    }
                }
            }
            barrier();
        }

        // ── 드레인: 워프 타일 → 산란(원식, live 가드).
        {
            const uint dr = row0 + warp_r * WM;
            const uint dc = warp_c * WN;
            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                    const uint dr_w = uint(int(dr) + int(wsir * WSUBM + tiwr * TM));
                    [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                        int row_i = int(dc + wsic * WSUBN + tiwc * TN + cc);
                        if (row_i >= live) break;
                        uint pr_ = perm[sg + uint(row_i)];
                        [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                            if (int(dr_w) + int(cr) < int(row0) + nrow) {
                                const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                                outv[pr_ * pc.n_out + dr_w + cr] = sums[sums_idx];
                            }
                        }
                    }
                }
            }
        }
        }
        barrier();
    }
}
