#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_ARB_gpu_shader_fp64 : enable

// silu_mul — HIP silu_mul 포트 (exp_cr f64 호너 다항 비트 재현).
// 곱셈 수축 방지: GLSL fma() 명시 사용.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Gbuf { float g[]; };
layout(binding = 1) readonly buffer Ubuf { float u[]; };
layout(binding = 2) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC { uint n; } pc;

float exp_cr(float xf) {
    double x = double(xf);
    if (x > 88.72) return uintBitsToFloat(0x7f800000u);
    if (x < -103.97) return 0.0;
    const double LN2_HI = 6.93147180369123816490e-01;
    const double LN2_LO = 1.90821492927058770002e-10;
    const double INV_LN2 = 1.44269504088896338700e+00;
    double kd = trunc(x * INV_LN2 + 0.5 * sign(x * INV_LN2)); // rint
    int k = int(kd);
    double r = fma(-kd, LN2_HI, x);
    r = fma(-kd, LN2_LO, r);
    double p = 1.0lf / 1307674368000.0lf;
    p = fma(p, r, 1.0lf / 479001600.0lf);
    p = fma(p, r, 1.0lf / 39916800.0lf);
    p = fma(p, r, 1.0lf / 3628800.0lf);
    p = fma(p, r, 1.0lf / 362880.0lf);
    p = fma(p, r, 1.0lf / 40320.0lf);
    p = fma(p, r, 1.0lf / 5040.0lf);
    p = fma(p, r, 1.0lf / 720.0lf);
    p = fma(p, r, 1.0lf / 120.0lf);
    p = fma(p, r, 1.0lf / 24.0lf);
    p = fma(p, r, 1.0lf / 6.0lf);
    p = fma(p, r, 0.5lf);
    p = fma(p, r, 1.0lf);
    p = fma(p, r, 1.0lf);
    p = fma(p, r, 1.0lf);
    if (k > 127) return uintBitsToFloat(0x7f800000u);
    // 2^k 스케일 — ldexp (k ∈ [-151, 127])
    return float(p * ldexp(1.0lf, k));
}

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    float v = g[j];
    outv[j] = (v / (1.0 + exp_cr(-v))) * u[j];
}
