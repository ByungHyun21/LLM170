#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_ARB_gpu_shader_fp64 : enable

// silu_mul — HIP silu_mul 포트 (exp_cr f64 호너 다항 비트 재현).
// 곱셈 수축 방지: GLSL fma() 명시 사용.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Gbuf { float g[]; };
layout(binding = 1) readonly buffer Ubuf { float u[]; };
layout(binding = 2) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC { uint n; } pc;

float exp_cr(float xf) {
    // f32 exp (HIP 실측과 스텝1-3 일치한 구성)
    return exp(xf);
}

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    float v = g[j];
    outv[j] = (v / (1.0 + exp_cr(-v))) * u[j];
}
