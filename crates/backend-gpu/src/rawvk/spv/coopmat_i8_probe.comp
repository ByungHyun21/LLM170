#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require

// coopmat_i8_probe (plans/99) — INT8 coopmat(u8×i8→i32) 네이티브 판정.
// RADV 26.2.3이 i8 coopmat 12종 노출 — f16 에뮬(74GB/s)과 달리 네이티브
// WMMA(v_wmma_i32_iu8)면 MMQ 2-4배 직결. R회 누산 반복으로 처리량 측정.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer Abuf { uint8_t a[]; };
layout(binding = 1) readonly buffer Bbuf { int8_t b[]; };
layout(binding = 2) buffer Cbuf { int c[]; };

void main() {
    // coopmat 연산은 스코프 전체 균일 실행 필수 — 조기 return 금지.
    coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    coopMatLoad(ma, a, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb, b, 0, 16, gl_CooperativeMatrixLayoutColumnMajor);
    #ifdef CM8_IDENT
    const uint R = 1u;
#else
    const uint R = 1024u;
#endif
    for (uint i = 0; i < R; i++) {
        acc = coopMatMulAdd(ma, mb, acc);
    }
    coopMatStore(acc, c, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
