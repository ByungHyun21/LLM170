#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv6_q4 (plans/33) — llama iqs lane 리맵을 q4_K에 적용. 블록 144B(워드정렬):
// d/min f16 @0, scales 12B @4, qs 128B @16(워드 4..35).
// 바이트 j(0..127): p=j>>5, l=j&31 — lo니블 → 원소 64p+l (스케일 2p),
// hi니블 → 원소 64p+32+l (2p+1). dot = dl·q·y − dml·y.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3c[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

const uint BLK_W = 36u;   // 144B / 4
shared float sh_dl[96][8];
shared float sh_dml[96][8];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_blk = n_in >> 8;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;

    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        uint roww = row * n_blk * BLK_W;
        // 패스1: 헤더 → LDS (d·sc, dm·mn 8쌍 — q5 검증 산법)
        for (uint b = tid; b < n_blk; b += 32u) {
            uint bw = roww + b * BLK_W;
            uint w0v = WG(bw);
            vec2 dm = unpackHalf2x16(w0v);
            uint w1v = WG(bw + 1u);   // scales 12B = 워드 1..3 (워드정렬)
            uint w2v = WG(bw + 2u);
            uint w3v = WG(bw + 3u);
            for (uint j = 0u; j < 8u; j++) {
                uint sc, mn;
                if (j < 4u) {
                    sc = (w1v >> (8u * j)) & 63u;
                    mn = (w2v >> (8u * j)) & 63u;
                } else {
                    uint b84 = (w3v >> (8u * (j - 4u))) & 0xFFu;
                    uint bj  = (w2v >> (8u * (j - 4u))) & 0xFFu;
                    uint qm4 = (w1v >> (8u * (j - 4u))) & 0xFFu;
                    sc = (b84 & 0xFu) | ((qm4 >> 6u) << 4);
                    mn = (b84 >> 4u) | ((bj >> 6u) << 4);
                }
                sh_dl[b][j] = dm.x * float(sc);
                sh_dml[b][j] = dm.y * float(mn);
            }
        }
        barrier();
        // 패스2: qs 선형 스윕 — 레인 L이 워드 4+L (연속 128B)
        float pacc = 0.0;
        for (uint b = 0u; b < n_blk; b++) {
            uint wv = WG(roww + b * BLK_W + 4u + tid);
            for (uint k = 0u; k < 4u; k++) {
                uint j = tid * 4u + k;          // qs 바이트 0..127
                uint p = j >> 5;
                uint l = j & 31u;
                uint byte_v = (wv >> (8u * k)) & 0xFFu;
                float y0 = xa[base + b * 256u + p * 64u + l];
                float y1 = xa[base + b * 256u + p * 64u + 32u + l];
                pacc += sh_dl[b][2u * p]         * float(byte_v & 0xFu) * y0
                      - sh_dml[b][2u * p] * y0;
                pacc += sh_dl[b][2u * p + 1u]     * float(byte_v >> 4u)  * y1
                      - sh_dml[b][2u * p + 1u] * y1;
            }
        }
        acc[r] = pacc;
        barrier();
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
