#version 450
#extension GL_KHR_shader_subgroup_basic : require

// rms_wide (plans/92 P4.1) — rms 의 256스레드/행 판(대형 t 프리필 전용).
// plans/89: 인터리브 로드(레인 u = 원소 i*W+u) — 레인 연속 세그면 인접 레인
// 주소가 멀어 트랜잭션 낭비(실측 8GB/s).
// plans/92 P4: 32→256스레드/행 — t=512 프리필에서 32스레드판은 16K스레드로
// 과소 병렬이라 2.7GB/s급(FN 청크 rms 261ms, [ts] FRAME_TIME). 축산
// 그룹화만 변경(f32 부분합 체인 32→256, f64 순서 결합은 유지) — 값은
// CPU 미러와 ±ulp, vk-frame-check·게이트로 검증.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Xbuf { float x[]; };
layout(binding = 1) readonly buffer Wbuf { float wv[]; };
layout(binding = 2) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n; uint t; uint w_reps; float eps;
} pc;

shared double seg[256];
shared float invs;

void main() {
    uint row = gl_WorkGroupID.x;
    uint u = gl_LocalInvocationID.x;
    uint n = pc.n;
    if (row >= pc.t) return;
    int xb = int(row * n);
    int steps = int((n + 255u) >> 8u);
    float acc = 0.0;
    for (int i = 0; i < steps; i++) {
        int k = i * 256 + int(u);
        if (uint(k) < n) {
            float dv = x[xb + k];
            acc += dv * dv;
        }
    }
    seg[u] = double(acc);
    barrier();
    if (u == 0u) {
        double sum = 0.0lf;
        for (int u2 = 0; u2 < 256; u2++) sum += seg[u2];
        float scale32 = float(sqrt(sum / double(n) + double(pc.eps)));
        invs = 1.0 / scale32;
    }
    barrier();
    // plans/84 B: w_reps — hip rms_finish와 동일 규약, w[(row % w_reps)*n + i].
    // w_reps=1이면 기존 산술과 동일(값경로 불변).
    int wbase = int((row % max(pc.w_reps, 1u)) * pc.n);
    float iv = invs;
    for (int i = 0; i < steps; i++) {
        int k = i * 256 + int(u);
        if (uint(k) < n) outv[xb + k] = x[xb + k] * iv * wv[wbase + k];
    }
}
