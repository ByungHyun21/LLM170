#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv7_q5 (plans/33) — y-LDS 스테이징. gemv6 계측: WG당 y글로벌 판독 160KB vs
// 가중 28KB (y 5.7배 과다 — 행마다 y 재판독). 여기선 블록당 y 256플로트를
// LDS에 1회 스테이징, 8행이 LDS에서 판독. 베리어 2/블록.
// 기하는 gemv6_q5 동일 (검증).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3c[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

const uint BLK_W = 44u;
shared float sy[256];        // 이 블록의 y — 1KB (스케일은 행루프 내 직접 전개)

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_blk = n_in >> 8;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;
    uint qi = tid;
    uint P = qi >> 3;
    uint l4 = (qi & 7u) * 4u;

    for (uint b = 0u; b < n_blk; b++) {
        // y 스테이징: 레인이 8플로트 (32×8=256)
        for (uint i = tid * 8u; i < tid * 8u + 8u; i++) {
            sy[i] = xa[base + b * 256u + i];
        }
        barrier();   // y 스테이징 완료 후 dot
        // y 서브합 (레인 고정): 이 워드의 lo 4 + hi 4
        float yv0[4]; float yv1[4];
        for (uint k = 0u; k < 4u; k++) {
            yv0[k] = sy[P * 64u + l4 + k];
            yv1[k] = sy[P * 64u + 32u + l4 + k];
        }
        float ysum0 = yv0[0] + yv0[1] + yv0[2] + yv0[3];
        float ysum1 = yv1[0] + yv1[1] + yv1[2] + yv1[3];
        // 8행 dot — 가중 워드 행별 + 헤더 4워드 행별
        for (uint r = 0u; r < RPF; r++) {
            uint row = row0 + r;
            if (row >= pc.n_out) break;
            uint bw = row * n_blk * BLK_W + b * BLK_W;
            // 헤더 (이 행 이 블록) — 4워드 + 전개 (dl0/dl1/dml0/dml1)
            uint w0v = WG(bw);
            vec2 dm = unpackHalf2x16(w0v);
            uint w1v = WG(bw + 1u);
            uint w2v = WG(bw + 2u);
            uint w3v = WG(bw + 3u);
            float dl[2]; float dml[2];
            // j = 2P, 2P+1
            for (uint jj = 0u; jj < 2u; jj++) {
                uint j = 2u * P + jj;
                uint sc, mn;
                if (j < 4u) {
                    sc = (w1v >> (8u * j)) & 63u;
                    mn = (w2v >> (8u * j)) & 63u;
                } else {
                    uint b84 = (w3v >> (8u * (j - 4u))) & 0xFFu;
                    uint bj  = (w2v >> (8u * (j - 4u))) & 0xFFu;
                    uint qm4 = (w1v >> (8u * (j - 4u))) & 0xFFu;
                    sc = (b84 & 0xFu) | ((qm4 >> 6u) << 4);
                    mn = (b84 >> 4u) | ((bj >> 6u) << 4);
                }
                dl[jj] = dm.x * float(sc);
                dml[jj] = dm.y * float(mn);
            }
            uint qv = WG(bw + 12u + qi);
            uint qhw = WG(bw + 4u + (qi & 7u));
            uint bit_lo = 1u << (2u * P);
            uint bit_hi = 2u << (2u * P);
            float s0 = 0.0, s1 = 0.0;
            uint qhb0 = qhw & 0xFFu, qhb1 = (qhw >> 8u) & 0xFFu;
            uint qhb2 = (qhw >> 16u) & 0xFFu, qhb3 = (qhw >> 24u) & 0xFFu;
            int q00 = int(qv & 0xFu) + ((qhb0 & bit_lo) != 0u ? 16 : 0);
            int q01 = int((qv >> 8u) & 0xFu) + ((qhb1 & bit_lo) != 0u ? 16 : 0);
            int q02 = int((qv >> 16u) & 0xFu) + ((qhb2 & bit_lo) != 0u ? 16 : 0);
            int q03 = int((qv >> 24u) & 0xFu) + ((qhb3 & bit_lo) != 0u ? 16 : 0);
            s0 = float(q00) * yv0[0] + float(q01) * yv0[1] + float(q02) * yv0[2] + float(q03) * yv0[3];
            int q10 = int((qv >> 4u) & 0xFu) + ((qhb0 & bit_hi) != 0u ? 16 : 0);
            int q11 = int((qv >> 12u) & 0xFu) + ((qhb1 & bit_hi) != 0u ? 16 : 0);
            int q12 = int((qv >> 20u) & 0xFu) + ((qhb2 & bit_hi) != 0u ? 16 : 0);
            int q13 = int((qv >> 28u) & 0xFu) + ((qhb3 & bit_hi) != 0u ? 16 : 0);
            s1 = float(q10) * yv1[0] + float(q11) * yv1[1] + float(q12) * yv1[2] + float(q13) * yv1[3];
            acc[r] += dl[0] * s0 - dml[0] * ysum0;
            acc[r] += dl[1] * s1 - dml[1] * ysum1;
        }
        barrier();
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
