#version 450

// exl3_gdn_l2perm (plans/121 F1) — alpha/beta dot + L2 norm + lc 순열:
// 그리드 (T, 48): 각 WG이 (토큰, V-헤드) 쌍 — 완전 병렬.
// ab dot: 5120/128 = 40 MAC/스레드 → shared reduction.
// L2: K-헤드 kh의 q/k 128원소 norm(헤드 kh를 갖는 V-헤드 3개가 중복 수행 —
// 멱등이라 무해). v 순열: 헤드 h의 128원소 복사.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer QB { float q_in[]; };   // [T][2048] conv 출력(HF)
layout(binding = 1) readonly buffer KB { float k_in[]; };   // [T][2048] conv 출력(HF)
layout(binding = 2) readonly buffer VB { float v_in[]; };   // [T][6144] conv 출력(HF)
layout(binding = 3) readonly buffer XB { float xn[]; };     // [T][5120] xtb
layout(binding = 4) readonly buffer AB { float abuf[]; };   // [2][48][5120]
layout(binding = 5) readonly buffer AL { float alog[]; };   // [48]
layout(binding = 6) readonly buffer DT { float dtb[]; };    // [48]
layout(binding = 7) writeonly buffer QOB { float q_out[]; }; // [T][2048]
layout(binding = 8) writeonly buffer KOB { float k_out[]; }; // [T][2048]
layout(binding = 9) writeonly buffer VOB { float v_out[]; }; // [T][6144] lc
layout(binding = 10) writeonly buffer BGB { float bg[]; };   // [T][96] beta|g lc
layout(push_constant) uniform PC {
    uint t_len;
    uint h_k; // 16
    uint h_v; // 48
    uint d;   // 128
    uint layer; // GDN 층 인덱스(상수 오프셋)
} pc;

const float eps = 1e-6;

float sigmoid_f(float x) { return 1.0 / (1.0 + exp(-x)); }
float softplus_f(float x) { return x > 20.0 ? x : log(1.0 + exp(x)); }
uint hf_to_lc(uint hh) { return 3u * (hh % pc.h_k) + hh / pc.h_k; }

shared float red[128];

void main() {
    uint t = gl_WorkGroupID.y;
    uint h = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (t >= pc.t_len || h >= pc.h_v) return;

    // ── alpha dot ──
    float pa = 0.0;
    for (uint i = tid; i < 5120u; i += 128u) {
        pa += xn[t * 5120u + i] * abuf[pc.layer * 2u * pc.h_v * 5120u + h * 5120u + i];
    }
    red[tid] = pa;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float a_val = red[0];
    barrier();

    // ── beta dot ──
    float pb = 0.0;
    for (uint i = tid; i < 5120u; i += 128u) {
        pb += xn[t * 5120u + i] * abuf[pc.layer * 2u * pc.h_v * 5120u + pc.h_v * 5120u + h * 5120u + i];
    }
    red[tid] = pb;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float b_val = red[0];
    barrier();

    // ── g + beta → BGB (lc) ──
    uint j = hf_to_lc(h);
    if (tid == 0u) {
        float al = alog[pc.layer * pc.h_v + h];
        float dt = dtb[pc.layer * pc.h_v + h];
        float ssm_a = -exp(al);
        bg[t * 96u + j] = sigmoid_f(b_val);
        bg[t * 96u + 48u + j] = softplus_f(a_val + dtb[h]) * ssm_a;
    }

    // ── L2 norm q/k (K-헤드 kh) — V-헤드 h가 K-헤드 kh=h%h_k를 담당.
    // 같은 kh를 갖는 3개 V-헤드(h, h+16, h+32)가 중복 계산 — 멱등.
    // tid가 h%3==0인 헤드만 수행(중복 회피 — 첫 V-헤드가 담당).
    if (h < pc.h_k) { // h = kh (V-헤드 0..15 = K-헤드 0..15)
        uint kh = h;
        float qv = q_in[t * 2048u + kh * pc.d + tid];
        red[tid] = qv * qv;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) {
            if (tid < s) red[tid] += red[tid + s];
            barrier();
        }
        float q_inv = inversesqrt(red[0] + eps);
        barrier();
        q_out[t * 2048u + kh * pc.d + tid] = qv * q_inv;

        float kv = k_in[t * 2048u + kh * pc.d + tid];
        red[tid] = kv * kv;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) {
            if (tid < s) red[tid] += red[tid + s];
            barrier();
        }
        float k_inv = inversesqrt(red[0] + eps);
        barrier();
        k_out[t * 2048u + kh * pc.d + tid] = kv * k_inv;
    }

    // ── v lc 순열 ──
    v_out[t * 6144u + j * pc.d + tid] = v_in[t * 6144u + h * pc.d + tid];
}
