#version 450

// fn_moe_tile_q5kmmq (plans/96 G3) — q5_K MoE 전문가 타일 int8 MMQ.
// 구 스칼라 FnMoeTileQ5k(29ms/회) 대체. q4_K MMQ v3의 1-wave 64스레드
// 기하·스케일 추출(scale_min_k4 동일) 재사용 — 스테이징만 q5_K:
//   nib5 = ql 니블 | ((qh>>비트)&1)<<4   (CPU deq_q5_k와 동일 매핑)
//   산술: acc += yd·( (d·sc)·Σ(nib5·b) − (dmin·m)·Σb ), sb 승순.
// 블록 176B = 44워드: [d|dmin][scales 3][qh 8][qs 32].
// sdot4p 센티널 → OpSDot 패치. 드레인 직접산란(패딩 센티널 가드).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][8];
shared float sAd[64];
shared float sAm[64];
shared uint sB[16][8];
shared float sBd[16];
shared int sLive;  // plans/96: 밴드 내 실제(센티널 아닌) 행 수
shared int sBw[16][8];

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

// 블록 워드 wq의 scales 12B에서 i번째 바이트.
uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];
    int nt = int(min(16u, rp - uint(r0e)));
    uint row_words = uint(n_in >> 8) * 44u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int tr = int(tid);
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    // plans/96: 밴드 실제 행 수(루프 불변) — 1회 계산.
    int live_cnt = 0;
    for (int q2 = 0; q2 < 16; q2++) {
        if (r0e + q2 < int(rp) && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
    }
    sLive = live_cnt;
    barrier();

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A: q5_K → 패킹 5비트 + 스케일. 블록 로컬 j = sb&7.
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint wq = ebase + uint(row) * row_words + uint(sb >> 3) * 44u;
                if (true) {
                    float d = f16_exact(w0c[wq] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq] >> 16);
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq, j) & 63u;
                        m_v = sbyte(wq, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq, j) >> 6) << 4);
                    }
                    sAd[tr] = d * float(s_v);
                    sAm[tr] = dmin * float(m_v);
                }
                int it = (sb & 7) >> 1;
                bool hi = (sb & 1) != 0;
                // 하이비트: qh 워드 wq+4+p에서 비트 (2*it + hi) — 바이트별.
                uint hsh = uint(2 * it + (hi ? 1 : 0));
                uint qbase = wq + 12u + uint(it * 8);
                for (int p = 0; p < 8; p++) {
                    uint qw_ = w0c[qbase + uint(p)];
                    uint nib = hi ? ((qw_ >> 4) & 0x0F0F0F0Fu) : (qw_ & 0x0F0F0F0Fu);
                    uint qhw = w0c[wq + 4u + uint(p)];
                    uint hib = ((qhw >> hsh) & 0x01010101u) << 4;
                    sA[tr][p] = nib | hib;
                }
            } else {
                sAd[tr] = 0.0; sAm[tr] = 0.0;
                for (int p = 0; p < 8; p++) sA[tr][p] = 0u;
            }
        }
        // ── B: 16행 × 8워드 + 바이트합(단일 기록자).
        {
            for (int i = int(tid); i < live_cnt * 8; i += 64) {  // plans/96: 실제 행만
                int rb = i >> 3;
                int p = i & 7;
                if (rb < nt) {
                    uint pr_ = perm_pad[uint(r0e + rb)];
                    uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                    uint wv = xq[base + uint(sb * 8 + p)];
                    sB[rb][p] = wv;
                    int ws = int(wv);
                    sBw[rb][p] = ((ws << 24) >> 24) + ((ws << 16) >> 24)
                               + ((ws << 8) >> 24) + (ws >> 24);
                    if (p == 0) {
                        sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    }
                } else {
                    sB[rb][p] = 0u;
                    sBw[rb][p] = 0;
                    if (p == 0) sBd[rb] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 자기 가중행 × 16열, sb 승순.
        {
            int ra[8];
            for (int p = 0; p < 8; p++) ra[p] = int(sA[tr][p]);
            float ad = sAd[tr], am = sAm[tr];
            for (int c = 0; c < live_cnt; c++) {  // plans/96: 실제 행만 MMA(패딩 스킵)
                int qsum = 0;
                for (int p = 0; p < 8; p++) {
                    qsum += sdot4p(uint(ra[p]), sB[c][p]);
                }
                int bs = sBw[c][0] + sBw[c][1] + sBw[c][2] + sBw[c][3]
                       + sBw[c][4] + sBw[c][5] + sBw[c][6] + sBw[c][7];
                acc[c] += sBd[c] * (ad * float(qsum) - am * float(bs));
            }
        }
        barrier();
    }

    // ── 드레인: 직접산란.
    if (tr < nrow) {
        for (int c = 0; c < 16; c++) {
            if (c < nt) {
                uint pr2 = perm_pad[uint(r0e + c)];
                if (pr2 != 0xFFFFFFFFu) {
                    outv[pr2 * pc.n_out + uint(row0 + tr)] = acc[c];
                }
            }
        }
    }
}
