#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
// plans/84 B — NormGated(sigmoid z): out = rms(o_행)·σ(z)·w[헤드].
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Ov { float o[]; };
layout(binding = 1) readonly buffer Zb { float z[]; };
layout(binding = 2) readonly buffer Wb { float w[]; };
layout(binding = 3) buffer Out { float outv[]; };
layout(push_constant) uniform PC { uint d; uint n_h; float eps; } pc;
shared double seg[64];
void main() {
    uint row = gl_WorkGroupID.x;
    uint u = gl_LocalInvocationID.x;
    uint d = pc.d;
    int chunk = int((d + 63u) >> 6u);
    int lo = int(u) * chunk;
    int xb = int(row * d);
    int wb = int((row % pc.n_h) * d);
    float part = 0.0;
    if (uint(lo) < d) {
        int hi = min(lo + chunk, int(d));
        for (int i = lo; i < hi; i++) { float dv = o[xb + i]; part += dv * dv; }
    }
    seg[u] = double(part);
    barrier();
    if (u == 0u) {
        double sum = 0.0lf;
        for (int j = 0; j < 64; j++) if (uint(j * chunk) < d) sum += seg[j];
        seg[0] = sum;
    }
    barrier();
    float inv = 1.0 / float(sqrt(seg[0] / double(d) + double(pc.eps)));
    for (uint i = u; i < d; i += 64u)
        outv[xb + int(i)] = o[xb + int(i)] * inv * w[wb + int(i)] * (1.0 / (1.0 + exp(-z[xb + int(i)])));
}
