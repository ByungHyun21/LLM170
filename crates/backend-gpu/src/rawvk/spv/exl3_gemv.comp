#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// exl3_gemv (plans/118 §3-1) — EXL3 트렐리스 GEMV (m=1 디코드 경로):
// S[n] = Σ_k A_had[k] · Wq[k,n], Wq는 trellis에서 즉석 디코드.
// 참조: exllamav3 CPU scalar_tiles + decode_state_scalar/decode_mul1_scalar
// (moe_mul1.cpp), GPU 누산 구조 = exl3_gemv_kernel.cuh FragC_h(f16 누산,
// FOLD 케이던스 폴딩) — plans/118 §6 검증 명세의 GLSL 직이식.
//
// v5 (2026-10-04): f16x2 누산 통일(사용자 결정). 쌍 (r=2j, 2j+1)은 동일
// 출력열·인접 a_had(같은 u32 워드)이라 f16vec2 FMA 1회/쌍 — f32 2회의
// 절반. 정밀도는 참조와 동일 클래스: f16 누산 + 4 k-타일마다 f32 폴드
// (참조 FOLD=4 케이던스). CMP 스톡 정합(FFMA 1/32 쓰로틀 회피, §1.1)
// 겸용 — 이 커널이 APU·CMP 공통 경로.
//
// v6 (plans/120 A1): 트렐리스 타일 협력 스테이징 — 기존 약점은 8× L1/L2
// 판독 증폭(16쓰레드가 32워드 타일을 제각각 흩어져 판독). WG 커버
// 8 n-타일 × words32 = 연속 블록을 협력 코얼레스드 적재해 smem에 두고
// 추출은 smem에서 — 추출 산술(addr16/시프트/마스크)은 v5와 동일 →
// 비트동일. A_had 8워드도 WG 공통이라 함께 스테이징.
//
// v3 계습: 스레드 불변 addr16 사전계산·바이트합 6연산·k-분할 부분합
// [seg][n](결정적, had_out이 합산). 실측 v3(f32 누산) = 61-85 GB/s.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer AhB { uint ah16[]; };  // f16 쌍팩 [k/2]
layout(binding = 1) readonly buffer TreB { uint tre[]; };  // trellis u32 뷰
layout(binding = 2) writeonly buffer SB { float s[]; };    // f32 [nseg][n]
layout(push_constant) uniform PC {
    uint ktiles;
    uint ntiles;
    uint K;        // bpw(정수부) — u16 폭 16K
} pc;

// mul1 코드북 — plans/118 §6.2. 바이트합 6연산(16비트 레인 합 ≤510).
float mul1_decode(uint w) {
    uint x = w * 0x83DCD12Du;
    uint p = (x & 0x00FF00FFu) + ((x >> 8u) & 0x00FF00FFu);
    uint sum = (p & 0xFFFFu) + (p >> 16u);
    return (1024.0 + float(sum)) * 0.00676727294921875 - 10.3828125;
}

// 스테이징 버퍼(전역 스코프 — GLSL shared는 함수 내 선언 불가):
// 8 n-타일 × words32(K≤6 → 48워드) + a_had 8워드.
shared uint stg[8u * 48u];
shared uint ahstg[8u];

void main() {
    uint nt0 = gl_WorkGroupID.x * 8u;
    if (nt0 >= pc.ntiles) return;
    uint seg = gl_WorkGroupID.y;
    uint nseg = gl_NumWorkGroups.y;
    uint ktb = pc.ktiles * seg / nseg;
    uint kte = pc.ktiles * (seg + 1u) / nseg;
    uint c = gl_LocalInvocationID.x & 15u;
    uint ntl = gl_LocalInvocationID.x >> 4u;
    uint tid = gl_LocalInvocationID.x;
    uint words32 = 8u * pc.K;
    uint stg_words = 8u * words32;
    float acc = 0.0;          // f32 폴드 누산(4 k-타일마다)
    f16vec2 acc2 = f16vec2(float16_t(0.0));

    // 스레드 불변 주소 사전 계산 — r=0..15 워드의 (i0·i1·시프트).
    // t는 tensor_core_perm 역: (4*(c&7) + ((r&7)>>1))*8
    //   + ((r>>3)*2 + (r&1) + ((c>>3)*4)).
    uint addr16[16];
    for (uint r = 0u; r < 16u; r++) {
        uint t = (4u * (c & 7u) + ((r & 7u) >> 1u)) * 8u
               + ((r >> 3u) * 2u + (r & 1u) + ((c >> 3u) * 4u));
        uint b0 = t * pc.K + (pc.K + 256u * pc.K - 16u);
        uint b1 = b0 + 16u;
        uint i0 = (b0 >> 5u) % words32;
        uint i1 = ((b1 - 1u) >> 5u) % words32;
        uint sh = (((b1 - 1u) >> 5u) + 1u) * 32u - b1;
        addr16[r] = i0 | (i1 << 8u) | (sh << 16u);
    }

    for (uint kb = ktb; kb < kte; kb += 8u) {
        uint nk = min(8u, kte - kb);
        for (uint ktl = 0u; ktl < nk; ktl++) {
            uint tbase = ((kb + ktl) * pc.ntiles + nt0) * words32;
            uint ahb = ((kb + ktl) * 16u) >> 1u;   // a_had u32 오프셋
            // 협력 적재 — tid → 연속 u32(코얼레스드).
            for (uint w = tid; w < stg_words; w += 128u) {
                stg[w] = tre[tbase + w];
            }
            if (tid < 8u) ahstg[tid] = ah16[ahb + tid];
            barrier();
            uint ahw0 = ahstg[0];
            uint ahw1 = ahstg[1];
            uint ahw2 = ahstg[2];
            uint ahw3 = ahstg[3];
            uint ahw4 = ahstg[4];
            uint ahw5 = ahstg[5];
            uint ahw6 = ahstg[6];
            uint ahw7 = ahstg[7];
            // 쌍 8개(j=0..7) — 쌍당 f16x2 FMA 1회. 추출은 smem(ntl 타일)에서.
            #define EXL3_P(j, ahw) \
            { \
                uint a16e = addr16[2u * (j)]; \
                uint we = (((a16e >> 16u) == 0u) \
                    ? (stg[ntl * words32 + ((a16e >> 8u) & 0xFFu)] & 0xFFFFu) \
                    : (((stg[ntl * words32 + ((a16e >> 8u) & 0xFFu)] >> (a16e >> 16u)) \
                        | (stg[ntl * words32 + (a16e & 0xFFu)] << (32u - (a16e >> 16u)))) & 0xFFFFu)); \
                uint a16o = addr16[2u * (j) + 1u]; \
                uint wo = (((a16o >> 16u) == 0u) \
                    ? (stg[ntl * words32 + ((a16o >> 8u) & 0xFFu)] & 0xFFFFu) \
                    : (((stg[ntl * words32 + ((a16o >> 8u) & 0xFFu)] >> (a16o >> 16u)) \
                        | (stg[ntl * words32 + (a16o & 0xFFu)] << (32u - (a16o >> 16u)))) & 0xFFFFu)); \
                vec2 av32 = unpackHalf2x16(ahw); \
                acc2 += f16vec2(av32.x, av32.y) \
                      * f16vec2(float16_t(mul1_decode(we)), float16_t(mul1_decode(wo))); \
            }
            EXL3_P(0, ahw0) EXL3_P(1, ahw1) EXL3_P(2, ahw2) EXL3_P(3, ahw3)
            EXL3_P(4, ahw4) EXL3_P(5, ahw5) EXL3_P(6, ahw6) EXL3_P(7, ahw7)
            #undef EXL3_P
            // 참조 FOLD 케이던스 — 4 k-타일마다 f32 폴드(전역 카운트).
            if (((kb + ktl) & 3u) == 3u) {
                acc += float(acc2.x) + float(acc2.y);
                acc2 = f16vec2(float16_t(0.0));
            }
            barrier(); // 다음 k-타일 스테이징 전 전 소진 보장
        }
    }
    acc += float(acc2.x) + float(acc2.y);
    uint nt = nt0 + ntl;
    if (nt < pc.ntiles) s[seg * pc.ntiles * 16u + nt * 16u + c] = acc;
}
