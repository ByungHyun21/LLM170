#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv6_q8 (plans/33) — llama iqs lane 리맵 q8_0. 블록 34B: d f16@0, qs 32B i8@2.
// 레인 L = qs 바이트 L = 원소 L (32레인=32바이트 완전 매핑). 가장 단순한 타입.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3c[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_sub = n_in >> 5;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;

    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        uint rowb = row * n_sub * 34u;
        float pacc = 0.0;
        for (uint sb = 0u; sb < n_sub; sb++) {
            uint bw = rowb + sb * 34u;   // 블록 바이트 기준
            uint dwi = bw >> 2;
            uint drem = bw & 3u;         // 34%4=2 → 짝수블록 0, 홀수 2
            uint dw = WG(dwi);
            uint db = (dw >> (drem * 8u)) & 0xFFFFu;
            if (drem == 2u) {
                db = ((dw >> 16u) | (WG(dwi + 1u) << 16u)) & 0xFFFFu;
            }
            float d = unpackHalf2x16(db).x;
            // qs 바이트 tid: 절대 바이트 bw+2+tid — 워드 (bw+2+tid)>>2
            uint qi = (bw + 2u + tid) >> 2;
            uint qb_rem = (bw + 2u + tid) & 3u;
            uint q8 = (WG(qi) >> (qb_rem * 8u)) & 0xFFu;
            int q8i = int(q8) << 24 >> 24;   // 산술 시프트 부호확장
            pacc += d * float(q8i) * xa[base + sb * 32u + tid];
        }
        acc[r] = pacc;
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
