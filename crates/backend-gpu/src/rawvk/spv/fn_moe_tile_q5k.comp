#version 450
#extension GL_ARB_gpu_shader_int64 : enable

// fn_moe_tile_q5k (plans/89 P1.1c) — MoE 그룹 프리필 q5_K 16×16 스칼라 타일.
// FN UD-Q4_K_XL의 gate/up 역할 일부가 q5_K — 레거시 루프 대체.
// 블록 176B(256원소): [d f16][min f16][scales 12B][qh 32B][ql 128B].
// 요소(슈퍼블록 내 j_glob): it=j_glob>>6, hilo=(j_glob>>5)&1, l=j_glob&31;
// w = d·s(it·2+hilo)·((ql[48+it·32+l] 니블) + qh[l]>>(2it+hilo)&1 ? 16:0)
//     − min·m(it·2+hilo). 산술: 요소급 f32 직렬(신규 클래스).
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Yg { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

uint Wsel(uint c, uint o) {
    if (c == 0u) return w0c[o];
    if (c == 1u) return w1c[o];
    if (c == 2u) return w2c[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4c[o];
    if (c == 5u) return w5c[o];
    if (c == 6u) return w6c[o];
    return w7c[o];
}

// 16행 × 44워드 = 2.75KB.
shared uint sh[16 * 44];

uint byte_at(uint wi, uint b) {
    return (sh[wi + (b >> 2)] >> uint((b & 3u) * 8u)) & 0xFFu;
}

void main() {
    int ox = int(gl_LocalInvocationID.x);
    int rx = int(gl_LocalInvocationID.y);
    int o = int(gl_WorkGroupID.x) * 16 + ox;
    uint r0 = gl_WorkGroupID.y * 16u;
    uint rp = pc.mode == 1u ? pc.rows : rows_pad[0];
    if (r0 >= rp) return;
    uint e = pc.mode == 1u ? 0u : rowexp[r0];
    uint n_in = pc.n_in;
    uint n_super = n_in >> 8;
    uint row_bytes = n_super * 176u;
    int tid = int(gl_LocalInvocationID.y * 16u + gl_LocalInvocationID.x);
    uint r = r0 + uint(rx);
    uint xr0 = (pc.mode == 1u ? r : perm_pad[r]) * pc.xq_w;
    uint xw_base = n_in >> 2;
    float acc = 0.0;
    for (uint sIdx = 0u; sIdx < n_super; sIdx++) {
        for (uint row = 0u; row < 16u; row++) {
            uint orow = gl_WorkGroupID.x * 16u + row;
            if (orow >= pc.n_out) break;
            uint64_t wbase = uint64_t(e) * uint64_t(pc.per_expert_bytes)
                           + uint64_t(orow) * uint64_t(row_bytes) + uint64_t(sIdx) * 176u;
            uint w0 = uint(wbase >> 2);
            uint c0 = w0 / pc.chunk_words;
            uint srow = row * 44u;
            for (uint col = uint(tid); col < 44u; col += 256u) {
                uint wi = w0 + col;
                uint c = wi / pc.chunk_words;
                sh[srow + col] = Wsel(c, wi - c * pc.chunk_words);
            }
        }
        barrier();
        if (o < int(pc.n_out) && r < rp) {
            uint srow = uint(ox) * 44u;
            vec2 dm = unpackHalf2x16(sh[srow]);
            float d = dm.x, dmin = dm.y;
            // scales 12바이트 — scale_min_k4(core) 충실 이식.
            uint sc[12];
            for (uint k = 0u; k < 12u; k++) sc[k] = byte_at(srow, 4u + k);
            for (uint jg = 0u; jg < 8u; jg++) {          // 32원소 서브블록
                uint sj = jg;                            // jg = it*2+hilo (블록 순서와 동일)
                uint s_v, m_v;
                if (sj < 4u) {
                    s_v = sc[sj] & 63u;
                    m_v = sc[sj + 4u] & 63u;
                } else {
                    s_v = (sc[sj + 4u] & 0xFu) | ((sc[sj - 4u] >> 6) << 4);
                    m_v = (sc[sj + 4u] >> 4) | ((sc[sj] >> 6) << 4);
                }
                float ds0 = d * float(s_v);
                float ds1 = dmin * float(m_v);
                uint it = jg >> 1;
                uint hilo = jg & 1u;
                uint lbase = 48u + it * 32u;
                float yd = uintBitsToFloat(xq[xr0 + xw_base + sIdx * 8u + jg]);
                for (uint l = 0u; l < 32u; l++) {
                    uint qlb = byte_at(srow, lbase + l);
                    uint nib = hilo == 0u ? (qlb & 0xFu) : (qlb >> 4);
                    uint qhb = (byte_at(srow, 16u + l) >> uint(it * 2u + hilo)) & 1u;
                    float w = float(nib) + (qhb != 0u ? 16.0 : 0.0);
                    uint xw = xr0 + sIdx * 64u + ((jg * 32u + l) >> 2);
                    uint xb = (xq[xw] >> uint(((jg * 32u + l) & 3u) * 8u)) & 0xFFu;
                    int bs = int(xb) << 24 >> 24;
                    acc += (ds0 * w - ds1) * (yd * float(bs));
                }
            }
        }
        barrier();
    }
    if (o < int(pc.n_out) && r < rp) {
        outv[r * pc.n_out + uint(o)] = acc;
    }
}
