#version 450

// exl3_attn_fwd (plans/121 F2b) — 인과 어텐션 + 게이트 → xtb 직결.
// 그리드 (T, 24 q헤드). WG=256(=head_dim). GQA 6:1.
// kv_len ≤ 1024: 스코어 3패스 재계산(max → sumexp → AV) — CPU 미러와 동일
// 산술(exp(s−max)·v 누적 후 1회 정규화 — 10a). q는 LDS 파괴 금지.

layout(local_size_x = 256) in;

layout(binding = 0) readonly buffer QHB { float qh[]; };   // [T][6144]
layout(binding = 1) readonly buffer KKC { float kc[]; };   // [cap][1024]
layout(binding = 2) readonly buffer VKC { float vc[]; };   // [cap][1024]
layout(binding = 3) readonly buffer QGB { float qg[]; };   // [T][12288] gate
layout(binding = 4) writeonly buffer OB { float outv[]; }; // [T][6144]
layout(push_constant) uniform PC {
    uint t_len;
    uint pos0;
} pc;

shared float qs[256];
shared float w[256];

float score(uint row, uint kh) {
    // 스레드당 1행 스트림 판독(k 행 1KB) — q는 LDS 브로드캐스트.
    float s = 0.0;
    uint kb = row * 1024u + kh * 256u;
    for (uint d = 0u; d < 256u; d++) {
        s += qs[d] * kc[kb + d];
    }
    return s * 0.0625; // 1/sqrt(256)
}

void main() {
    uint t = gl_WorkGroupID.x;
    uint h = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint kh = h / 6u;
    uint kv_len = pc.pos0 + t + 1u;

    qs[tid] = qh[t * 6144u + h * 256u + tid];
    barrier();

    // 패스 1: 전역 max
    float gmax = -1e30;
    for (uint base = 0u; base < kv_len; base += 256u) {
        uint row = base + tid;
        w[tid] = (row < kv_len) ? score(row, kh) : -1e30;
        barrier();
        for (uint st = 128u; st > 0u; st >>= 1u) {
            if (tid < st) w[tid] = max(w[tid], w[tid + st]);
            barrier();
        }
        gmax = max(gmax, w[0]);
        barrier();
    }
    // 패스 2: sumexp
    float wsum = 0.0;
    for (uint base = 0u; base < kv_len; base += 256u) {
        uint row = base + tid;
        float e = 0.0;
        if (row < kv_len) e = exp(score(row, kh) - gmax);
        w[tid] = e;
        barrier();
        for (uint st = 128u; st > 0u; st >>= 1u) {
            if (tid < st) w[tid] += w[tid + st];
            barrier();
        }
        wsum += w[0];
        barrier();
    }
    // 패스 3: AV — 블록별 e는 LDS(w) 공유, 스레드당 dim 1 고정(v 행 연속 — coalesced)
    float acc = 0.0;
    for (uint base = 0u; base < kv_len; base += 256u) {
        uint row = base + tid;
        float e = 0.0;
        if (row < kv_len) e = exp(score(row, kh) - gmax);
        w[tid] = e;
        barrier();
        for (uint r2 = 0u; base + r2 < kv_len && r2 < 256u; r2++) {
            acc += w[r2] * vc[(base + r2) * 1024u + kh * 256u + tid];
        }
        barrier();
    }
    float g = qg[t * 12288u + h * 512u + 256u + tid];
    float sg = 1.0 / (1.0 + exp(-g));
    outv[t * 6144u + h * 256u + tid] = (acc / wsum) * sg;
}
