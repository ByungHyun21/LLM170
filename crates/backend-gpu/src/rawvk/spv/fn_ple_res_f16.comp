#version 450

// fn_ple_res_f16 (plans/103) — q4_ple_residual의 res_hc f16 버스 판.
// res[s·n+i] += value[i]·gate + conv_out[s·n+i] — 산술은 f32 승격, 저장은
// packed f16. 짝수 i 스레드가 (i,i+1) 단일 워드 읽기-수정-기록(단일 소유).
layout(local_size_x = 256) in;
layout(binding = 0) buffer ResB { uint resw[]; };
layout(binding = 1) readonly buffer ValB { float value[]; };
layout(binding = 2) readonly buffer GateB { float gate_out[]; };
layout(binding = 3) readonly buffer ConvB { float conv_out[]; };
layout(push_constant) uniform PC {
    uint n_embd; uint hc; uint t;
} pc;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= int(pc.n_embd) || (i & 1) == 1) return;   // 홀수 i는 짝 파트너가 처리
    for (uint ti = 0u; ti < pc.t; ti++) {
        float v0 = value[ti * pc.n_embd + uint(i)];
        float v1 = value[ti * pc.n_embd + uint(i) + 1u];
        for (uint s = 0u; s < pc.hc; s++) {
            uint idx = ti * pc.hc * pc.n_embd + s * pc.n_embd + uint(i);
            float g = gate_out[ti * pc.hc + s];
            vec2 h = unpackHalf2x16(resw[idx >> 1u]);
            resw[idx >> 1u] = packHalf2x16(vec2(
                h.x + v0 * g + conv_out[idx],
                h.y + v1 * g + conv_out[idx + 1u]));
        }
    }
}
