#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv4_xs (plans/31) — llama 아키텍처 iq4_xs. 구조는 gemv4_q8 동일
// (32스레드, f32 활성, 8행/WG, subgroupAdd). iq4_xs 블록: 256원소/블록,
// ql 128B(하위니블 lo/상위 hi 열 분리) + qh 32B(2비트) + ls 2B(6비트 스케일)
// + d f16 = 136B... 실제 GGUF iq4_xs: ql[128] + qh[32] + sc/lut 스케일 2B + d 2B.
// 열 기하 (CPU dot_q4xs 미러): 원소 k → byte ql[(k%128)... k<128: ql[k>>1] 하니블,
// k>=128: ql[(k&127)>>1] 상니블; qh 비트: qh[k>>1]의 (k&1) 비트.
// 스케일: ls 6비트 → sc-32, 블록당 1개(q4_xs는 서브블록 스케일 1개).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Kbuf { uint ktab[]; };  // iq4nl 바이트 LUT
layout(binding = 11) readonly buffer YV4 { vec4 yv4[]; };   // xa의 vec4 뷰
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint ty; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;


uint WG(uint idx) {
    // chunk_words = 2의 거듭제곱(=max_ssbo.min) → 시프트/마스크 (워드당 정수 나눗셈 제거)
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

shared uint skt[256];   // iq4nl LUT — llama init_iq_shmem 방식 (LDS gather)

void main() {
    // ktab 협동 스테이징: 256엔트리 × u32 = 1KB — WG당 1회
    for (uint i = gl_LocalInvocationID.x; i < 256u; i += 32u) {
        skt[i] = ktab[i];
    }
    barrier();
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;
    uint n_sub = n_in >> 5;          // 32원소 서브블록
    uint blocks = n_in >> 8;
    for (uint sb = tid; sb < n_sub; sb += 32u) {
        vec4 yy[8];
        for (uint k = 0; k < 8u; k++) yy[k] = yv4[(base + sb * 32u + 4u * k) >> 2u];
        uint blk = sb >> 3;
        uint ib = sb & 7u;
        for (uint r = 0u; r < RPF; r++) {
            uint row = row0 + r;
            if (row >= pc.n_out) break;
            uint rowb = row * blocks * 136u + blk * 136u;  // 블록 바이트 기준
            // d f16 @0
            uint wd = WG(rowb >> 2);
            float d = unpackHalf2x16(wd >> ((rowb & 3u) * 8u)).x;
            // scales_h u16 @2, scales_l @4 (6+4비트 조립 — CPU 미러)
            uint sh = (WG((rowb + 2u) >> 2) >> (((rowb + 2u) & 3u) * 8u)) & 0xFFFFu;
            // u16이 워드 경계 걸침 가능 (rowb%4: 136k+blk*136 mod4 = 0,2 교차)
            if (((rowb + 2u) & 3u) == 3u) {
                uint w2 = WG(((rowb + 2u) >> 2) + 1u);
                sh = (sh & 0xFFu) | ((w2 & 0xFFu) << 8);
            }
            uint slw = WG((rowb + 4u + (ib >> 1)) >> 2);
            uint slb = (slw >> (((rowb + 4u + (ib >> 1)) & 3u) * 8u)) & 0xFFu;
            int ls = int((slb >> (4u * (ib & 1u))) & 0xFu) | (int((sh >> (2u * ib)) & 3u) << 4);
            float dl = d * float(ls - 32);
            float ysum = 0.0;
            // qs 16B @8+ib*16 — 4워드
            uint qb = rowb + 8u + ib * 16u;
            for (uint k = 0; k < 4u; k++) {
                uint bytei = qb + k * 4u;
                uint wv32 = WG(bytei >> 2);
                uint rem = (bytei & 3u);
                if (rem != 0u) {
                    uint w2 = WG((bytei >> 2) + 1u);
                    wv32 = (wv32 >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
                }
                for (uint b = 0; b < 4u; b++) {
                    uint t2 = skt[(wv32 >> (8u * b)) & 0xFFu];
                    int vlo = (int(t2 & 0xFFu) << 24) >> 24;   // 부호 확장
                    int vhi = (int(t2 >> 8u) << 24) >> 24;
                    // k*4+b (lo열)와 16+k*4+b (hi열) — yy 워드 인접 페어
                    uint w0i = (k * 4u + b) >> 2u, w1i = (16u + k * 4u + b) >> 2u;
                    float ylo = yy[w0i][(k * 4u + b) & 3u];
                    float yhi = yy[w1i][(16u + k * 4u + b) & 3u];
                    ysum += float(vlo) * ylo + float(vhi) * yhi;
                }
            }
            acc[r] += dl * ysum;
        }
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
