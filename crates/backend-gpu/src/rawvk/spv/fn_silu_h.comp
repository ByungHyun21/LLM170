#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// fn_silu_h (plans/105) — silu_mul의 packed f16 입력 변형(mgu/mup f16 버스).
// 산술: 원소당 (v / (1.0 + exp(-v))) * u — silu_mul과 동일 문자, 입력만
// f16 사전 반올림(hout 클래스). 출력 f32(mglu — down quant 경로 불변).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Gbuf { uint gw[]; };   // packed f16 쌍
layout(binding = 1) readonly buffer Ubuf { uint uw[]; };   // packed f16 쌍
layout(binding = 2) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC { uint n; } pc;   // 원소 수

float unpack16(uint w, uint hi) {
    uint h = hi != 0u ? (w >> 16) : (w & 0xFFFFu);
    float sgn = (h & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;   // 워드 = 2원소
    uint e0 = i * 2u;
    if (e0 >= pc.n) return;
    vec2 gv = vec2(unpack16(gw[i], 0u), unpack16(gw[i], 1u));
    vec2 uv = vec2(unpack16(uw[i], 0u), unpack16(uw[i], 1u));
    outv[e0] = (gv.x / (1.0 + exp(-gv.x))) * uv.x;
    if (e0 + 1u < pc.n) {
        outv[e0 + 1u] = (gv.y / (1.0 + exp(-gv.y))) * uv.y;
    }
}
