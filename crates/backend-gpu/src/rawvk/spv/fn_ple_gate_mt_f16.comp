#version 450
#extension GL_ARB_gpu_shader_int64 : enable

// fn_ple_gate_mt (plans/93 개정판) — PLE gate 병렬: 워크그룹(256스레드)이
// (s,ti)를 공동 처리. 서브그룹 연산 금지 — AMD wave64에서 lane 32..63이
// 경계 외 판독하던 원판 결함(subgroupSize=32 가정) 제거. 공유메모리
// 트리 축소(f32) → f64 결합으로 원판 정밀도 클래스 유지.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer ResB { uint resw[]; };  // plans/103: packed f16 res_hc
layout(binding = 1) readonly buffer KeyB { float key[]; };
layout(binding = 2) readonly buffer ValB { float value[]; };
layout(binding = 3) readonly buffer NkB { float nk[]; };
layout(binding = 4) readonly buffer NqB { float nq[]; };
layout(binding = 5) readonly buffer NcB { float nc[]; };
layout(binding = 6) buffer GatedB { float gated[]; };
layout(binding = 7) buffer GateB { float gate_out[]; };
layout(push_constant) uniform PC {
    float eps; uint n_embd; uint hc; uint t;
} pc;

shared float red[256];

float exp_cr_exact(float xf) {
    double x = double(xf);
    if (x > 88.72) return uintBitsToFloat(0x7f800000u);
    if (x < -103.97) return 0.0;
    const double LN2_HI = 6.93147180369123816490e-01;
    const double LN2_LO = 1.90821492927058770002e-10;
    const double INV_LN2 = 1.44269504088896338700e+00;
    double kd = roundEven(x * INV_LN2);
    int k = int(kd);
    double r = fma(-kd, LN2_HI, x);
    r = fma(-kd, LN2_LO, r);
    double p = 1.0 / 1307674368000.0;
    p = fma(p, r, 1.0 / 479001600.0);
    p = fma(p, r, 1.0 / 39916800.0);
    p = fma(p, r, 1.0 / 3628800.0);
    p = fma(p, r, 1.0 / 362880.0);
    p = fma(p, r, 1.0 / 40320.0);
    p = fma(p, r, 1.0 / 5040.0);
    p = fma(p, r, 1.0 / 720.0);
    p = fma(p, r, 1.0 / 120.0);
    p = fma(p, r, 1.0 / 24.0);
    p = fma(p, r, 1.0 / 6.0);
    p = fma(p, r, 0.5);
    p = fma(p, r, 1.0);
    p = fma(p, r, 1.0);
    if (k > 127) return uintBitsToFloat(0x7f800000u);
    if (k < -126) return 0.0;
    uint64_t eb = (uint64_t(k + 1023)) << 52;
    double scale = uint64BitsToDouble(eb);
    return float(p * scale);
}

// 공유메모리 트리 축소 후 red[0] = Σ red[i] (f32 트리 순서).
void wg_reduce() {
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (gl_LocalInvocationID.x < stride) {
            red[gl_LocalInvocationID.x] += red[gl_LocalInvocationID.x + stride];
        }
        barrier();
    }
}

float rget(uint k) {
    // plans/103 f16 변형 — res_hc packed f16 원소 접근자.
    vec2 h = unpackHalf2x16(resw[k >> 1u]);
    return (k & 1u) == 0u ? h.x : h.y;
}

void main() {
    // 워크그룹 = (s, ti) 1개 — 서브그룹 크기 무관.
    int s = int(gl_WorkGroupID.x);
    int ti = int(gl_WorkGroupID.y);
    uint lid = gl_LocalInvocationID.x;
    uint n = pc.n_embd;
    if (s >= int(pc.hc) || ti >= int(pc.t)) return;

    uint kbase = uint(ti) * pc.hc * n + uint(s) * n;
    uint rbase = kbase;
    uint nks = uint(s) * n;
    uint vbase = uint(ti) * n;

    // ── RMS(key): 스트라이드 f32 부분합 → 공유 트리 → f64 보정.
    float ksq_part = 0.0;
    for (uint i = lid; i < n; i += 256u) {
        float dv = key[kbase + i];
        ksq_part += dv * dv;
    }
    red[lid] = ksq_part;
    wg_reduce();
    float sk = 1.0 / float(sqrt(double(red[0]) / double(n) + double(pc.eps)));
    // plans/94 R1: red[0] 소비(위 판독) 완료를 전 웨이브가 확인한 뒤에만
    // red 슬롯 재사용 — 소비-재사용 사이 배리어 없으면 wave0이 다음 축소
    // 부분합을 red[0]에 먼저 써서 늦은 웨이브의 sk/sq를 오염(간헐 값 오류).
    barrier();

    // ── RMS(res) — 동일 구조.
    float rsq_part = 0.0;
    for (uint i = lid; i < n; i += 256u) {
        float dv = rget(rbase + i);
        rsq_part += dv * dv;
    }
    red[lid] = rsq_part;
    wg_reduce();
    float sq = 1.0 / float(sqrt(double(red[0]) / double(n) + double(pc.eps)));
    barrier();

    // ── dot: (key*sk*nk) · (res*sq*nq) — 스트라이드 + 공유 트리.
    float dot_part = 0.0;
    for (uint i = lid; i < n; i += 256u) {
        float a = (key[kbase + i] * sk) * nk[nks + i];
        float b = (rget(rbase + i) * sq) * nq[nks + i];
        dot_part += a * b;
    }
    red[lid] = dot_part;
    wg_reduce();
    float dotv = red[0] / sqrt(float(n));
    barrier();

    // ── gate — 레인 0만 기록 (스칼라).
    float mag = max(abs(dotv), 1e-6);
    float g = 1.0 / (1.0 + exp_cr_exact(dotv >= 0.0 ? -sqrt(mag) : sqrt(mag)));
    if (lid == 0u) {
        gate_out[uint(ti) * pc.hc + uint(s)] = g;
    }

    // ── plans/94 R2: gated를 전역 왕복(write→barrier→read) 대신 레지스터 보유.
    // GLSL barrier()는 WorkgroupMemory만 순서 보장 — SSBO 재판독은
    // memoryBarrierBuffer 의존이었음. gv=value·g를 레지스터에서 직접 제곱합
    // 축소하면 위험 자체가 사라지고 전역 판독 1회·기록 1회로 절감.
    // 산술은 기존과 비트 동일: 부분합 순서(스트라이드 i=lid..n)·최종 결합
    // ((value·g)·sg)·nc 그대로.
    float gsq_part = 0.0;
    for (uint i = lid; i < n; i += 256u) {
        float gv = value[vbase + i] * g;
        gsq_part += gv * gv;
    }
    red[lid] = gsq_part;
    wg_reduce();
    float sg = 1.0 / float(sqrt(double(red[0]) / double(n) + double(pc.eps)));

    for (uint i = lid; i < n; i += 256u) {
        gated[kbase + i] = value[vbase + i] * g * sg * nc[nks + i];
    }
}
