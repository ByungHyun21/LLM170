#version 450

// exl3_gdn_gate (plans/121 F1) — norm_gated + 역순열 → xtb 직접 기록:
// o_lc(rms_norm)·silu(z) → gated(HF) → xtb. GPU 상주 완결.
// 그리드: (T, 48): 각 WG이 (토큰, V-헤드) — 완전 병렬.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer OB { float o_lc[]; };   // [T][6144] (lc)
layout(binding = 1) readonly buffer ZB { float z[]; };       // [T][6144] (HF)
layout(binding = 2) readonly buffer NW { float nw[]; };      // [128] ssm_norm_w
layout(binding = 3) writeonly buffer GB { float gated[]; };  // [T][6144] (HF) → xtb
layout(push_constant) uniform PC {
    uint t_len;
    uint h_k; // 16
    uint h_v; // 48
    uint d;   // 128
    uint layer; // GDN 층(norm_w 오프셋)
} pc;

const float eps = 1e-6;
float silu_f(float x) { return x / (1.0 + exp(-x)); }

// lc → HF 역순열(qwen35 미러)
uint lc_to_hf(uint i) { return 3u * (i % pc.h_k) + i / pc.h_k; }
// (참고: hf_to_lc(h) = 3*(h%16)+h/16 — 이는 자기 자신이 아님. 역함수 필요.)
// hf_to_lc: h → j = 3*(h%16) + h/16. 역: j → h. j = 3*q + r (q=h/16, r=h%16).
// h = r*16 + q. j에서 q = ? j = 3*(h%16) + h/16 → j/3 = h%16 + h/48.
// 간단히: 모든 h에 대해 hf_to_lc(h)==j인 h 탐색 — 48이라 전수 가능하나
// 닫힌형: j가 주어지면 h = (j/3)*16 + (j%3)*16... 아니.
// 정확히: hf_to_lc(h) = 3*(h mod 16) + floor(h/16). h = a*16+b (a<3, b<16).
// j = 3*b + a. So b = j/3 (0..15), a = j%3 (0..2). h = (j%3)*16 + j/3.
uint lc_to_hf2(uint j) { return (j % 3u) * 16u + j / 3u; }

shared float red[128];

void main() {
    uint t = gl_WorkGroupID.y;
    uint h = gl_WorkGroupID.x;  // HF 헤드
    uint tid = gl_LocalInvocationID.x;
    if (t >= pc.t_len || h >= pc.h_v) return;

    // 이 헤드(h)는 lc 인덱스 j = hf_to_lc(h)의 o를 소비
    uint j = 3u * (h % pc.h_k) + h / pc.h_k;

    // ── rms_norm(o_lc[j]) × ssm_norm_w ──
    float ov = o_lc[t * 6144u + j * pc.d + tid];
    red[tid] = ov * ov;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float inv = inversesqrt(red[0] / float(pc.d) + eps);
    barrier();

    // ── gated[t][h] = rms(o) * silu(z[t][h]) ──
    float zv = z[t * 6144u + h * pc.d + tid];
    gated[t * 6144u + h * pc.d + tid] = ov * inv * nw[pc.layer * 128u + tid] * silu_f(zv);
}
