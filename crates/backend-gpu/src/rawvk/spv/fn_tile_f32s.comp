#version 450

// fn_tile_f32s (plans/95 P1) — 스키니 f32 밀집 GEMM (n_out ≤ 512, t ≥ 2).
// fn_tile_f32의 grid (⌈n_out/16⌉,⌈t/16⌉)는 n_out=4(hc down)에서 WG 32개·
// 활성 스레드 128개로 점유 붕괴 + 스레드당 K=10240 직렬 체인 → 실측 0.85GB/s.
// 본 판: WG = 16출력×16토큰, 256스레드 = (ks 16 K-분할)×(tx 16 토큰).
// 직렬 체인 1/16, w는 ks레인 32원소 청크 연속 판독(라인 완전 소비).
// 산술(출력 원소당, 결정적 고정 순서): 슬라이스 순서 × 청크(c) 내 직렬 f32
// 누산 → 최종 ks=0..15 직렬 합. mm_f32b(서브그룹 트리)과 동일 허용 클래스
// (원장 §8 — 게이트 3회로 판정). dty=0(f32) 전용.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer W0 { float w0[]; };
layout(binding = 1) readonly buffer W0u { uint w0u[]; };  // BF16 뷰(dty=1)
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint dty; uint words_per_row;
} pc;

shared float shx[16][512];   // x 슬라이스: 16토큰 × 512원소 (32KB)
shared float racc[16 * 16 * 16]; // (o*16+tx)*16 + ks 부분합 (16KB)

void main() {
    const uint tx = gl_LocalInvocationID.x & 15u;   // 토큰 레인
    const uint ks = gl_LocalInvocationID.x >> 4;    // K-분할 레인 (0..15)
    const uint o0 = gl_WorkGroupID.x * 16u;
    const uint t0 = gl_WorkGroupID.y * 16u;
    const uint tid = gl_LocalInvocationID.x;

    float acc[16];
    for (uint o = 0u; o < 16u; o++) acc[o] = 0.0;

    for (uint s0 = 0u; s0 < pc.n_in; s0 += 512u) {
        const uint lim = min(512u, pc.n_in - s0);
        // ── x 스테이징(협동, 4원소 벡터): 16토큰 × lim 원소.
        // (16*lim이 4의 배수 가정 — 실형상 n_in=2560/10240은 512의 배수)
        // 죽은 토큰 행은 0행 판독으로 클램프(결과 미사용, OOB 회피).
        for (uint e = tid * 4u; e < 16u * lim; e += 1024u) {
            const uint row = e / lim;
            const uint col = e - row * lim;
            const uint r = min(t0 + row, pc.t - 1u);
            const uint xbase = r * pc.n_in + s0 + col;
            shx[row][col]     = xa[xbase];
            shx[row][col + 1u] = xa[xbase + 1u];
            shx[row][col + 2u] = xa[xbase + 2u];
            shx[row][col + 3u] = xa[xbase + 3u];
        }
        barrier();
        // ── MAC: 이 스레드의 K 청크 [ks*32, ks*32+32) × 16출력.
        if (lim == 512u) {
            const uint c0 = ks * 32u;
            if (pc.dty == 0u) {
                for (uint o = 0u; o < 16u; o++) {
                    if (o0 + o >= pc.n_out) break;
                    const uint wb = (o0 + o) * pc.n_in + s0 + c0;
                    float a = acc[o];
                    for (uint c = 0u; c < 32u; c++) {
                        a += w0[wb + c] * shx[tx][c0 + c];
                    }
                    acc[o] = a;
                }
            } else {
                // plans/96: BF16 — 워드당 2원소. c0=ks*32는 2의 배수(32k)이므로
                // 청크는 항상 워드 정렬: 워드 인덱스 (s0+c0)>>1 부터 16워드.
                for (uint o = 0u; o < 16u; o++) {
                    if (o0 + o >= pc.n_out) break;
                    const uint wb = (o0 + o) * (pc.n_in >> 1) + ((s0 + c0) >> 1);
                    float a = acc[o];
                    for (uint hw = 0u; hw < 16u; hw++) {
                        vec2 wp = unpackHalf2x16(w0u[wb + hw]);
                        a += wp.x * shx[tx][c0 + hw * 2u];
                        a += wp.y * shx[tx][c0 + hw * 2u + 1u];
                    }
                    acc[o] = a;
                }
            }
        } else {
            // 꼬리 슬라이스 — 청크 경계 가드. n_in은 2의 배수(BF16 워드 정렬
            // — 실형상 2560). 요소 단위 루프로 경계 처리.
            for (uint o = 0u; o < 16u; o++) {
                if (o0 + o >= pc.n_out) break;
                float a = acc[o];
                for (uint c = ks * 32u; c < min((ks + 1u) * 32u, lim); c++) {
                    float wv;
                    if (pc.dty == 0u) {
                        wv = w0[(o0 + o) * pc.n_in + s0 + c];
                    } else {
                        uint w2 = w0u[(o0 + o) * (pc.n_in >> 1) + ((s0 + c) >> 1)];
                        wv = unpackHalf2x16((c & 1u) == 0u ? w2 : (w2 >> 16)).x;
                    }
                    a += wv * shx[tx][c];
                }
                acc[o] = a;
            }
        }
        barrier();
    }

    // ── ks 축소: 부분합 LDS 기록 → (o,tx)당 1스레드 직렬 합(고정 순서).
    for (uint o = 0u; o < 16u; o++) {
        racc[(o * 16u + tx) * 16u + ks] = acc[o];
    }
    barrier();
    // tid → (o = tid/16, tx = tid%16): 256출력/WG.
    const uint ro = tid >> 4;
    const uint rt = tid & 15u;
    if (o0 + ro < pc.n_out && t0 + rt < pc.t) {
        float s = 0.0;
        for (uint k = 0u; k < 16u; k++) s += racc[(ro * 16u + rt) * 16u + k];
        outv[(t0 + rt) * pc.n_out + o0 + ro] = s;
    }
}
