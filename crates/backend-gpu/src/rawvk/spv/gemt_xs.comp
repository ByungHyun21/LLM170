#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require
// gemt_xs (plans/32) — iq4_xs 프리필 타일 GEMM. 가중 블록을 WG당 1회 로드해
// 32토큰 청크에 전량 적용 (가중 트래픽 = 16GB/스텝, 토큰 수 무관).
// 구조: WG 64스레드 = 8행 × 8토큰슬롯, 각 스레드 1행 × 4토큰 담당.
// k서브(32원소)마다 Y[tok32][sub32]를 LDS 스테이징, W는 레지스터, f32 FMA.
// 기하는 gemv4_xs와 동일 (136B/256원소, ktab shared).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };   // [t][n_in]
layout(binding = 9) buffer Obuf { float outv[]; };          // [t][n_out]
layout(binding = 10) readonly buffer Kbuf { uint ktab[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask;
} pc;

const uint ROWS = 8u;    // 행/WG
const uint TOKC = 32u;   // 토큰 청크

shared float sy[TOKC][32];   // Y 청크 스테이징 [tok][sub 내 32원소]
shared uint skt[256];        // iq4nl LUT

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    for (uint i = tid; i < 256u; i += 64u) skt[i] = ktab[i];
    barrier();

    uint row0 = gl_WorkGroupID.x * ROWS;      // .x = 행 블록
    uint tok0 = gl_WorkGroupID.y * TOKC;      // .y = 토큰 청크
    uint n_in = pc.n_in;
    uint t = pc.t;
    uint nt = min(TOKC, t - tok0);            // 이 청크의 실제 토큰 수
    uint n_sub = n_in >> 5;
    uint blocks = n_in >> 8;

    // 스레드 배치: rslot = tid / 8 (0..7행), tslot4 = (tid & 7) * 4 (4토큰)
    uint rslot = tid >> 3;
    uint tslot = (tid & 7u) * 4u;
    uint row = row0 + rslot;
    if (row >= pc.n_out) return;

    float acc[4];
    acc[0] = acc[1] = acc[2] = acc[3] = 0.0;

    for (uint sb = 0u; sb < n_sub; sb++) {
        // Y 스테이징: 64스레드 × (nt*32/64) 원소
        for (uint i = tid; i < TOKC * 32u; i += 64u) {
            uint tk = i >> 5, kk = i & 31u;
            if (tk < nt) {
                sy[tk][kk] = xa[(tok0 + tk) * n_in + sb * 32u + kk];
            }
        }
        barrier();

        // 이 (row, sb)의 가중 — 스레드당 1행씩 (8행 = 8스레드그룹이 공유?)
        // 각 스레드은 자기 row만: 블록 기하는 gemv4_xs와 동일
        uint blk = sb >> 3;
        uint ib = sb & 7u;
        uint rowb = row * blocks * 136u + blk * 136u;
        uint wd = WG(rowb >> 2);
        float d = unpackHalf2x16(wd >> ((rowb & 3u) * 8u)).x;
        uint sh = (WG((rowb + 2u) >> 2) >> (((rowb + 2u) & 3u) * 8u)) & 0xFFFFu;
        if (((rowb + 2u) & 3u) == 3u) {
            uint w2 = WG(((rowb + 2u) >> 2) + 1u);
            sh = (sh & 0xFFu) | ((w2 & 0xFFu) << 8);
        }
        uint slw = WG((rowb + 4u + (ib >> 1)) >> 2);
        uint slb = (slw >> (((rowb + 4u + (ib >> 1)) & 3u) * 8u)) & 0xFFu;
        int ls = int((slb >> (4u * (ib & 1u))) & 0xFu) | (int((sh >> (2u * ib)) & 3u) << 4);
        float dl = d * float(ls - 32);

        // qs 16B @8+ib*16 — 4워드 (스레드당 자기 row 것)
        uint qb = rowb + 8u + ib * 16u;
        float p0 = 0.0, p1 = 0.0, p2 = 0.0, p3 = 0.0;
        for (uint k = 0u; k < 4u; k++) {
            uint bytei = qb + k * 4u;
            uint wv32 = WG(bytei >> 2);
            uint rem = (bytei & 3u);
            if (rem != 0u) {
                uint w2 = WG((bytei >> 2) + 1u);
                wv32 = (wv32 >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
            }
            [[unroll]] for (uint b = 0u; b < 4u; b++) {
                uint t2 = skt[(wv32 >> (8u * b)) & 0xFFu];
                float vlo = float((int(t2 & 0xFFu) << 24) >> 24);
                float vhi = float((int(t2 >> 8u) << 24) >> 24);
                uint e0 = k * 4u + b;         // lo열 원소
                uint e1 = 16u + k * 4u + b;   // hi열 원소
                // 4토큰 축산 — W 원소 1개당 4 FMA (가중 재사용의 핵)
                p0 += vlo * sy[tslot + 0u][e0] + vhi * sy[tslot + 0u][e1];
                p1 += vlo * sy[tslot + 1u][e0] + vhi * sy[tslot + 1u][e1];
                p2 += vlo * sy[tslot + 2u][e0] + vhi * sy[tslot + 2u][e1];
                p3 += vlo * sy[tslot + 3u][e0] + vhi * sy[tslot + 3u][e1];
            }
        }
        acc[0] += dl * p0;
        acc[1] += dl * p1;
        acc[2] += dl * p2;
        acc[3] += dl * p3;
        barrier();
    }
    [[unroll]] for (uint j = 0u; j < 4u; j++) {
        uint tk = tslot + j;
        if (tk < nt) outv[(tok0 + tk) * pc.n_out + row] = acc[j];
    }
}
