#version 450
// gdn_conv_t (plans/19) — rawhip gdn_conv(t=1)/gdn_conv_t2(t>1) 미러.
// grid (ceil(ch/64), t) — 인과 conv: 이전 '입력'만 참조.
// t=1: 링 상태 갱신 포함 (shift+push — rawhip gdn_conv 대칭).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Qkv { float qkv[]; };  // [t][ch]
layout(binding = 1) readonly buffer Cw { float cw[]; };    // [ch][k]
layout(binding = 2) buffer St { float st[]; };             // [k-1][ch] 링
layout(binding = 3) buffer Out { float outv[]; };          // [t][ch]
layout(push_constant) uniform PC { int ch; int k; int t; } pc;
float exp_cr(float xf) {
    double x = double(xf);
    if (x > 88.72) return uintBitsToFloat(0x7f800000u);
    if (x < -103.97) return 0.0;
    const double LN2_HI = 6.93147180369123816490e-01;
    const double LN2_LO = 1.90821492927058770002e-10;
    const double INV_LN2 = 1.44269504088896338700e+00;
    double kd = roundEven(x * INV_LN2);
    int k = int(kd);
    double r = fma(-kd, LN2_HI, x);
    r = fma(-kd, LN2_LO, r);
    double p = 1.0lf / 1307674368000.0lf;
    p = fma(p, r, 1.0lf / 479001600.0lf);
    p = fma(p, r, 1.0lf / 39916800.0lf);
    p = fma(p, r, 1.0lf / 3628800.0lf);
    p = fma(p, r, 1.0lf / 362880.0lf);
    p = fma(p, r, 1.0lf / 40320.0lf);
    p = fma(p, r, 1.0lf / 5040.0lf);
    p = fma(p, r, 1.0lf / 720.0lf);
    p = fma(p, r, 1.0lf / 120.0lf);
    p = fma(p, r, 1.0lf / 24.0lf);
    p = fma(p, r, 1.0lf / 6.0lf);
    p = fma(p, r, 0.5lf);
    p = fma(p, r, 1.0lf);
    p = fma(p, r, 1.0lf);
    p = fma(p, r, 1.0lf);
    if (k > 127) return uintBitsToFloat(0x7f800000u);
    return float(p * ldexp(1.0lf, k));
}

void main() {
    int c = int(gl_GlobalInvocationID.x);
    int ti = int(gl_WorkGroupID.y);
    if (c >= pc.ch || ti >= pc.t) return;
    float sum = cw[c * pc.k + (pc.k - 1)] * qkv[ti * pc.ch + c];
    for (int j = 0; j < pc.k - 1; j++) {
        int pos = ti - (pc.k - 1) + j;
        float xv = pos >= 0 ? qkv[pos * pc.ch + c]
                            : st[(pos + (pc.k - 1)) * pc.ch + c];
        sum += cw[c * pc.k + j] * xv;
    }
    // 링 갱신 (t=1 전제): shift 후 최신 입력 push (rawhip gdn_conv와 동일 순서).
    if (pc.t == 1) {
        for (int j = 0; j < pc.k - 2; j++) st[j * pc.ch + c] = st[(j + 1) * pc.ch + c];
        st[(pc.k - 2) * pc.ch + c] = qkv[ti * pc.ch + c];
    }
    float oc = sum / (1.0 + exp(-sum));
    outv[ti * pc.ch + c] = oc;
}
