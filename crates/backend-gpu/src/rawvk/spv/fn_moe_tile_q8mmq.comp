#version 450

// fn_moe_tile_q8mmq (plans/96 G3) — q8_0 MoE 전문가 타일 int8 MMQ.
// 구 스칼라 FnMoeTileQ8(24ms/회) 대체. A측은 q8_0_relayout 무손실 배치
// ([n_in 바이트 i8][n_in/32 f32 d] 행렬 — dense q8mmq 자산 재사용)로
// 워드정렬 — 니블 전개 없이 i8 직결. 산술: acc += d_a·d_b·Σ(q·b),
// sb 승순 f32 누산, 정수부 exact. 타일 64가중행×16할당행(1-wave 64스레드).
// sdot4p 센티널 → OpSDot 패치. 드레인 직접산란(패딩 센티널 가드).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };   // q8r 릴레이아웃(전체 스택)
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][8];
shared float sAd[64];
shared uint sB[16][8];
shared float sBd[16];
shared int sLive;  // plans/96: 밴드 내 실제(센티널 아닌) 행 수

// sdot4p 센티널 — OpSDot 치환(패처 실패 시 종료).
int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;   // 16행 밴드
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];
    int nt = int(min(16u, rp - uint(r0e)));
    uint qw = uint(n_in >> 2);          // 행당 i8 워드수(q8r)
    // q8r 행 폭 = qw + n_sub 워드(스케일 f32).
    uint row_words = qw + uint(n_sub);
    uint ebase = e * (pc.per_expert_bytes >> 2);

    int tr = int(tid);                  // 가중행 = 스레드(1-wave)
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A: q8r 직판독 — 니블 전개 없음.
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint rbase = ebase + uint(row) * row_words;
                for (int p = 0; p < 8; p++) {
                    sA[tr][p] = w0c[rbase + uint(sb * 8 + p)];
                }
                sAd[tr] = uintBitsToFloat(w0c[rbase + qw + uint(sb)]);
            } else {
                for (int p = 0; p < 8; p++) sA[tr][p] = 0u;
                sAd[tr] = 0.0;
            }
        }
        // ── B: 16행 × 8워드 — 스레드 분담.
        {
            if (tid == 0u) {
                int live = 0;
                for (int q = 0; q < 16; q++) {
                    if (r0e + q < int(rp) && perm_pad[uint(r0e + q)] != 0xFFFFFFFFu) live = q + 1;
                }
                sLive = live;
            }
            for (int i = int(tid); i < 16 * 8; i += 64) {
                int rb = i >> 3;
                int p = i & 7;
                int sbi = sb;
                if (rb < nt) {
                    uint pr_ = perm_pad[uint(r0e + rb)];
                    uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                    sB[rb][p] = xq[base + uint(sbi * 8 + p)];
                    if (p == 0) {
                        sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sbi)]);
                    }
                } else {
                    sB[rb][p] = 0u;
                    if (p == 0) sBd[rb] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 자기 가중행 × 16열, sb 승순.
        {
            int ra[8];
            for (int p = 0; p < 8; p++) ra[p] = int(sA[tr][p]);
            float ad = sAd[tr];
            for (int c = 0; c < sLive; c++) {  // plans/96: 실제 행만 MMA(패딩 스킵)
                int qsum = 0;
                for (int p = 0; p < 8; p++) {
                    qsum += sdot4p(uint(ra[p]), sB[c][p]);
                }
                acc[c] += sBd[c] * (ad * float(qsum));
            }
        }
        barrier();
    }

    // ── 드레인: 직접산란.
    if (tr < nrow) {
        for (int c = 0; c < 16; c++) {
            if (c < nt) {
                uint pr2 = perm_pad[uint(r0e + c)];
                if (pr2 != 0xFFFFFFFFu) {
                    outv[pr2 * pc.n_out + uint(row0 + tr)] = acc[c];
                }
            }
        }
    }
}
