#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv4 (plans/31) — llama mul_mat_vec 아키텍처 포트, q8_0.
// 32스레드 WG(wave32), rpf행/WG(y 레지스터 재사용), f32 활성 직결,
// y를 vec4로 로드(llama data_b_v4 방식), subgroupAdd 축소.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };   // [t][n_in] f32 활성
layout(binding = 9) buffer Obuf { float outv[]; };          // [t][n_out]
layout(binding = 10) readonly buffer YV4 { vec4 yv4[]; };   // xa의 vec4 뷰 (동일 버퍼 재바인딩)
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint ty; uint t; uint chunk_words; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx / pc.chunk_words;
    uint o = idx - c * pc.chunk_words;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_sub = n_in >> 5;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;
    for (uint sb = tid; sb < n_sub; sb += 32u) {
        uint byte0 = sb * 34u;
        uint qw = (byte0 + 2u) / 4u;
        bool al = ((byte0 + 2u) & 3u) == 0u;
        // y 32원소를 vec4×8로 로드 — 모든 행이 공유
        vec4 yy[8];
        for (uint k = 0; k < 8u; k++) {
            yy[k] = yv4[(base + sb * 32u + 4u * k) >> 2u];
        }
        for (uint r = 0u; r < RPF; r++) {
            uint row = row0 + r;
            if (row >= pc.n_out) break;
            uint row_base_words = row * n_sub * 34u / 4u;
            uint wd = WG(row_base_words + byte0 / 4u);
            float d = unpackHalf2x16(wd >> ((byte0 & 3u) * 8u)).x;
            float ysum = 0.0;
            for (uint k = 0; k < 8u; k++) {
                uint wv32 = al ? WG(row_base_words + qw + k)
                               : (WG(row_base_words + qw + k) >> 16) | (WG(row_base_words + qw + k + 1u) << 16);
                vec4 q = vec4(
                    float((int((wv32      ) & 0xFFu) << 24) >> 24),
                    float((int((wv32 >> 8 ) & 0xFFu) << 24) >> 24),
                    float((int((wv32 >> 16) & 0xFFu) << 24) >> 24),
                    float((int((wv32 >> 24) & 0xFFu) << 24) >> 24));
                ysum += dot(q, yy[k]);
            }
            acc[r] += d * ysum;
        }
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
