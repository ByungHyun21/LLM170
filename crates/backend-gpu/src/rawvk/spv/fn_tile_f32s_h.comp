#version 450

// fn_tile_f32s_h (plans/104 결함 수리) — fn_tile_f32s의 f16 packed 입력 변형.
// plans/101 P2가 xn을 f16 쌍팩으로 기록하는데 F32 멤버(hc inject 등)가
// raw f32로 읽어 지수 오염(원장 104 — L1B.inj ±수천 관측). 본 판은 Xbuf를
// uint 워드로 읽어 절반 언팩 — 산술은 언팩 f16값(사전 반올림) × f32 가중
// f32 누산: quant_q8h와 동일 rounding 클래스.
// 나머지 기하·축소 순서는 fn_tile_f32s와 완전 동일.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer W0 { float w0[]; };
layout(binding = 1) readonly buffer W0u { uint w0u[]; };  // 미사용(f32 전용 판)
layout(binding = 8) readonly buffer Xbuf { uint xw[]; };  // packed f16 워드
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint dty; uint words_per_row;
} pc;

shared float shx[16][512];
shared float racc[16 * 16 * 16];

// packed f16 워드에서 hi(0=하위/1=상위) 절반 — f16_exact와 동일 값 클래스.
float unpack16(uint w, uint hi) {
    uint h = hi != 0u ? (w >> 16) : (w & 0xFFFFu);
    float sgn = (h & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (h >> 10) & 0x1Fu;
    uint m = h & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    const uint tx = gl_LocalInvocationID.x & 15u;
    const uint ks = gl_LocalInvocationID.x >> 4;
    const uint o0 = gl_WorkGroupID.x * 16u;
    const uint t0 = gl_WorkGroupID.y * 16u;
    const uint tid = gl_LocalInvocationID.x;

    float acc[16];
    for (uint o = 0u; o < 16u; o++) acc[o] = 0.0;

    for (uint s0 = 0u; s0 < pc.n_in; s0 += 512u) {
        const uint lim = min(512u, pc.n_in - s0);
        // ── x 스테이징: packed 워드 판독 → 원소 언팩. 16토큰 × lim(4원소 단위).
        for (uint e = tid * 4u; e < 16u * lim; e += 1024u) {
            const uint row = e / lim;
            const uint col = e - row * lim;
            const uint r = min(t0 + row, pc.t - 1u);
            const uint xel = r * pc.n_in + s0 + col;   // 절대 원소 인덱스
            shx[row][col]      = unpack16(xw[xel >> 1u], xel & 1u);
            shx[row][col + 1u] = unpack16(xw[(xel + 1u) >> 1u], (xel + 1u) & 1u);
            shx[row][col + 2u] = unpack16(xw[(xel + 2u) >> 1u], (xel + 2u) & 1u);
            shx[row][col + 3u] = unpack16(xw[(xel + 3u) >> 1u], (xel + 3u) & 1u);
        }
        barrier();
        // ── MAC — fn_tile_f32s f32 경로와 동일(가중 f32 연속 판독).
        if (lim == 512u) {
            const uint c0 = ks * 32u;
            for (uint o = 0u; o < 16u; o++) {
                if (o0 + o >= pc.n_out) break;
                const uint wb = (o0 + o) * pc.n_in + s0 + c0;
                float a = acc[o];
                for (uint c = 0u; c < 32u; c++) {
                    a += w0[wb + c] * shx[tx][c0 + c];
                }
                acc[o] = a;
            }
        } else {
            for (uint o = 0u; o < 16u; o++) {
                if (o0 + o >= pc.n_out) break;
                float a = acc[o];
                for (uint c = ks * 32u; c < min((ks + 1u) * 32u, lim); c++) {
                    a += w0[(o0 + o) * pc.n_in + s0 + c] * shx[tx][c];
                }
                acc[o] = a;
            }
        }
        barrier();
    }

    // ── ks 축소: 부분합 LDS 기록 → (o,tx)당 1스레드 직렬 합(고정 순서).
    for (uint o = 0u; o < 16u; o++) {
        racc[(o * 16u + tx) * 16u + ks] = acc[o];
    }
    barrier();
    const uint ro = tid >> 4;
    const uint rt = tid & 15u;
    if (o0 + ro < pc.n_out && t0 + rt < pc.t) {
        float s = 0.0;
        for (uint k = 0u; k < 16u; k++) s += racc[(ro * 16u + rt) * 16u + k];
        outv[(t0 + rt) * pc.n_out + o0 + ro] = s;
    }
}
