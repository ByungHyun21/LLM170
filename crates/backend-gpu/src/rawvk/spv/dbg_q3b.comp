#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
// dbg_q3b — gemv8_q3b 디코드를 행 0 전원소 덤프 (레인 매핑 포함).
// grid (n_in/8/64, 1, 1) — 레인 col0 = 8*(WGID.x*64 + tid).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0u[]; };
layout(binding = 1) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC { uint n_in; } pc;
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint col0 = 8u * (gl_WorkGroupID.x * 64u + tid);
    uint n_in = pc.n_in;
    if (col0 >= n_in) return;
    uint blk = col0 >> 8;
    uint bb = blk * 110u;
    uint e = col0 & 255u;
    uint l0 = e & 15u;
    uint half16 = (e >> 4) & 1u;
    uint n2 = (e >> 7) & 1u;
    uint sh2 = ((e >> 5) & 3u) * 2u;
    uint hbit = 1u << ((e >> 5) & 3u);
    uint qoff = bb + 32u + 32u * n2 + 16u * half16 + l0;
    uint qa = w0u[qoff >> 2];
    uint qb2 = w0u[(qoff >> 2) + 1u];
    uint qc2 = w0u[(qoff >> 2) + 2u];
    uint qsh = (qoff & 3u) * 8u;
    uint qbytes0 = (qa >> qsh) | (qsh != 0u ? (qb2 << (32u - qsh)) : 0u);
    uint qbytes1 = (qb2 >> qsh) | (qsh != 0u ? (qc2 << (32u - qsh)) : 0u);
    uint hoff = bb + 16u * half16 + l0;
    uint ha = w0u[hoff >> 2];
    uint hb2 = w0u[(hoff >> 2) + 1u];
    uint hc2 = w0u[(hoff >> 2) + 2u];
    uint hsh = (hoff & 3u) * 8u;
    uint hbytes0 = (ha >> hsh) | (hsh != 0u ? (hb2 << (32u - hsh)) : 0u);
    uint hbytes1 = (hb2 >> hsh) | (hsh != 0u ? (hc2 << (32u - hsh)) : 0u);
    uint sbase = bb + 96u;
    uint sw0 = w0u[sbase >> 2];
    uint rr = sbase & 3u;
    uint a0 = (sw0 >> (rr * 8u)) | (rr != 0u ? (w0u[(sbase >> 2) + 1u] << ((4u - rr) * 8u)) : 0u);
    uint a1 = (rr == 0u) ? w0u[(sbase >> 2) + 1u]
        : ((w0u[(sbase >> 2) + 1u] >> (rr * 8u)) | (w0u[(sbase >> 2) + 2u] << ((4u - rr) * 8u)));
    uint aux2 = (rr == 0u) ? w0u[(sbase >> 2) + 2u]
        : ((w0u[(sbase >> 2) + 2u] >> (rr * 8u)) | (w0u[(sbase >> 2) + 3u] << ((4u - rr) * 8u)));
    uint km1 = 0x03030303u, km2 = 0x0F0F0F0Fu;
    uint ax2 = ((a0 >> 4) & km2) | (((aux2 >> 4) & km1) << 4);
    uint ax3 = ((a1 >> 4) & km2) | (((aux2 >> 6) & km1) << 4);
    uint aa0 = (a0 & km2) | ((aux2 & km1) << 4);
    uint aa1 = (a1 & km2) | (((aux2 >> 2) & km1) << 4);
    uint is_ = 8u * n2 + 2u * ((e >> 5) & 3u) + half16;
    uint sw = (is_ < 4u) ? aa0 : ((is_ < 8u) ? aa1 : ((is_ < 12u) ? ax2 : ax3));
    int sc8 = int((sw >> ((is_ & 3u) * 8u)) & 0xFFu) << 24 >> 24;
    uint dbb = bb + 108u;
    uint dw = w0u[dbb >> 2];
    uint dsh = (dbb & 3u) * 8u;
    uint db = (dw >> dsh) & 0xFFFFu;
    if (dsh >= 24u) db = ((dw >> dsh) | (w0u[(dbb >> 2) + 1u] << 8u)) & 0xFFFFu;
    float d = unpackHalf2x16(db).x;
    float dl = d * float(sc8 - 32);
    for (uint j = 0u; j < 8u; j++) {
        uint qbts = (j < 4u) ? qbytes0 : qbytes1;
        uint hbts = (j < 4u) ? hbytes0 : hbytes1;
        uint byte_v = (qbts >> ((j & 3u) * 8u)) & 0xFFu;
        uint hm_v = (hbts >> ((j & 3u) * 8u)) & 0xFFu;
        int v = int((byte_v >> sh2) & 3u) - (((hm_v & hbit) != 0u) ? 0 : 4);
        outv[col0 + j] = dl * float(v);
    }
}
