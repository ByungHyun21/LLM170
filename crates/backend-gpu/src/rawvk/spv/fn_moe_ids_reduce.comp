#version 450

// MoE direct-ids K-분할 부분합 환원 (plans/88 P1) — hip q4_gemm_q4k_ids_reduce
// 직역: out[i] = float(Σ_k part[i*ksplit+k], k 오름차순 f64 직렬).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Part { double part[]; };
layout(binding = 1) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC { uint n; uint ksplit; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double s = 0.0;
    for (uint k = 0u; k < pc.ksplit; k++) s += part[i * pc.ksplit + k];
    outv[i] = float(s);
}
