#version 450

// exl3_ffn_ew (plans/120 A1) — FFN 활성화 융합: a = silu(g) ⊙ u (f32 → f16).
// 게이트·업 GEMV 결과(yb1·yb2, f32)를 읽어 down_proj 입력(x2b, f16 쌍팩)을
// 쓴다 — FFN 전체를 단일 배치로 묶기 위한 GPU ew 단.
//
// 산술 계약(10a): CPU 경로 silu(x)=x/(1+exp(-x))의 f32와 동일 클래스.
// GPU exp는 CPU libm exp와 근사 구현이 달라 저비트에서 차이난다 — 환원
// 순서 변경과 같은 취급(동일 정밀도), exl3-vk-check의 ew 미러가 허용치를
// 검증한다. f32→f16은 had_in과 동일 RTNE 수동 미러(이 드라이버의
// packHalf2x16이 RTZ로 관측되어 왔음).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer GB { float g[]; };
layout(binding = 1) readonly buffer UB { float u[]; };
layout(binding = 2) writeonly buffer AB { uint a16[]; }; // f16 쌍팩 [n/2]
layout(push_constant) uniform PC {
    uint n; // 원소 수(짝수 보장 — FFN 폭 16의 배수)
} pc;

// f32 → f16 비트 (RTNE) — Rust half::from_f32 미러. had_in과 동일 구현.
uint f32_to_f16_rtne(float v) {
    uint x = floatBitsToUint(v);
    uint sign = (x >> 16) & 0x8000u;
    uint rest = x & 0x7FFFFFFFu;
    if (rest >= 0x7F800000u) return sign | 0x7C00u | uint((rest & 0x7FFFFFu) != 0u);
    int e = int(rest >> 23) - 127;
    uint man = rest & 0x7FFFFFu;
    uint h;
    if (e >= -14) {
        h = (uint(e + 15) << 10) | (man >> 13);
        uint rem = man & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) h += 1u;
        if (h >= 0x7C00u) h = 0x7C00u;
    } else if (e < -25) {
        return sign;
    } else {
        uint m = 0x800000u | man;
        uint sh = uint(-14 - e) + 13u;
        uint rem = m & ((1u << sh) - 1u);
        h = m >> sh;
        uint halfway = 1u << (sh - 1u);
        if (rem > halfway || (rem == halfway && (h & 1u) != 0u)) h += 1u;
    }
    return sign | h;
}

float silu_f32(float x) {
    return x / (1.0 + exp(-x));
}

void main() {
    // 스레드당 1워드(2원소) — i = 2·gid.
    uint i = gl_GlobalInvocationID.x * 2u;
    if (i >= pc.n) return;
    float v0 = silu_f32(g[i]) * u[i];
    float v1 = (i + 1u < pc.n) ? (silu_f32(g[i + 1u]) * u[i + 1u]) : 0.0;
    a16[gl_GlobalInvocationID.x] = f32_to_f16_rtne(v0) | (f32_to_f16_rtne(v1) << 16u);
}
