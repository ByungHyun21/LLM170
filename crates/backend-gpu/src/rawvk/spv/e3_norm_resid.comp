#version 450

// e3_norm_resid (plans/121 프레임) — 잔차 스트림 GPU 상주화:
// xn = rms_norm(x)·w  (xtb 기록 — 선형 입력)
// x  = x + yb          (xbuf 제자리 갱신 — 잔차)
// 그리드 (T), WG=1024, 행 5120(1024스레드×5). LDS 리듀스 후 2중 기록.
// ffn 변형(norm_f): yb2(xtb 기록 후 ffn이 소비) — 동일 커널, w만 교체.

layout(local_size_x = 1024) in;

layout(binding = 0) readonly buffer XB { float x[]; };    // [T][5120] 잔차
layout(binding = 1) readonly buffer NW { float nw[]; };   // [5120]
layout(binding = 2) readonly buffer AB { float ab[]; };   // [T][5120] attn/ffn 출력
layout(binding = 3) writeonly buffer XN { float xn[]; };  // [T][5120] → xtb
layout(binding = 4) buffer XO { float xo[]; };            // [T][5120] 잔차 갱신(=xbuf)
layout(push_constant) uniform PC {
    uint t_len;
} pc;

shared float red[1024];

void main() {
    uint t = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = t * 5120u;
    // 잔차 먼저: v = x + ab (xn과 xo 모두 이 값에서 나온다)
    float v0 = x[base + tid] + ab[base + tid];
    float v1 = x[base + 1024u + tid] + ab[base + 1024u + tid];
    float v2 = x[base + 2048u + tid] + ab[base + 2048u + tid];
    float v3 = x[base + 3072u + tid] + ab[base + 3072u + tid];
    float v4 = x[base + 4096u + tid] + ab[base + 4096u + tid];
    float ss = v0 * v0 + v1 * v1 + v2 * v2 + v3 * v3 + v4 * v4;
    red[tid] = ss;
    barrier();
    for (uint st = 512u; st > 0u; st >>= 1u) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    float inv = inversesqrt(red[0] / 5120.0 + 1e-6);
    // xn = x·inv·w (xtb — 선형 소비)
    xn[base + tid] = v0 * inv * nw[tid];
    xn[base + 1024u + tid] = v1 * inv * nw[1024u + tid];
    xn[base + 2048u + tid] = v2 * inv * nw[2048u + tid];
    xn[base + 3072u + tid] = v3 * inv * nw[3072u + tid];
    xn[base + 4096u + tid] = v4 * inv * nw[4096u + tid];
    // x += ab (잔차 갱신)
    xo[base + tid] = v0 + ab[base + tid];
    xo[base + 1024u + tid] = v1 + ab[base + 1024u + tid];
    xo[base + 2048u + tid] = v2 + ab[base + 2048u + tid];
    xo[base + 3072u + tid] = v3 + ab[base + 3072u + tid];
    xo[base + 4096u + tid] = v4 + ab[base + 4096u + tid];
}
