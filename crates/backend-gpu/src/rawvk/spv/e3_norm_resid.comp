#version 450

// e3_norm_resid (plans/121 프레임) — 잔차 스트림 GPU 상주화:
// xn = rms_norm(x+ab)·w  (xtb 기록 — 선형 입력)
// x  = x + ab            (xbuf 제자리 — 단일 read-write 바인딩.
//                          동일 버퍼 2슬롯 얼라이어싱은 쓰기 유실 실측 — 금지)
// 그리드 (T), WG=1024, 행 5120(1024스레드×5). LDS 리듀스.

layout(local_size_x = 1024) in;

layout(binding = 0) buffer XB { float x[]; };          // [T][5120] 잔차 r/w
layout(binding = 1) readonly buffer NW { float nw[]; }; // [5120]
layout(binding = 2) readonly buffer AB { float ab[]; }; // [T][5120] 모듈 출력
layout(binding = 3) writeonly buffer XN { float xn[]; }; // [T][5120] → xtb
layout(push_constant) uniform PC {
    uint t_len;
    uint w_off; // nw128 행 오프셋(원소 단위)
} pc;

shared float red[1024];

void main() {
    uint t = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = t * 5120u;
    float v0 = x[base + tid] + ab[base + tid];
    float v1 = x[base + 1024u + tid] + ab[base + 1024u + tid];
    float v2 = x[base + 2048u + tid] + ab[base + 2048u + tid];
    float v3 = x[base + 3072u + tid] + ab[base + 3072u + tid];
    float v4 = x[base + 4096u + tid] + ab[base + 4096u + tid];
    float ss = v0 * v0 + v1 * v1 + v2 * v2 + v3 * v3 + v4 * v4;
    red[tid] = ss;
    barrier();
    for (uint st = 512u; st > 0u; st >>= 1u) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    float inv = inversesqrt(red[0] / 5120.0 + 1e-6);
    xn[base + tid] = v0 * inv * nw[pc.w_off + tid];
    xn[base + 1024u + tid] = v1 * inv * nw[pc.w_off + 1024u + tid];
    xn[base + 2048u + tid] = v2 * inv * nw[pc.w_off + 2048u + tid];
    xn[base + 3072u + tid] = v3 * inv * nw[pc.w_off + 3072u + tid];
    xn[base + 4096u + tid] = v4 * inv * nw[pc.w_off + 4096u + tid];
    x[base + tid] = v0;
    x[base + 1024u + tid] = v1;
    x[base + 2048u + tid] = v2;
    x[base + 3072u + tid] = v3;
    x[base + 4096u + tid] = v4;
}
