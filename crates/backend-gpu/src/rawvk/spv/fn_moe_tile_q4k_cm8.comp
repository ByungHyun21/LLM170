#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require

// fn_moe_tile_q4k_cm8 (plans/99) — q4_K MoE MMQ의 MMA를 INT8 coopmat로 교체.
// v5(fn_moe_tile_q4k_mmq)의 밴드/센티널/드레인 골격 + coopMatMulAdd(u8,i8).
// RADV 26.2.3 i8 coopmat(u8×i8→i32) — 프로브 22 TMAC/s(스칼라 dot ~16배).
//
// 검증된 제약(plans/99 로그#2): WG=32스레드(서브그룹1)에서만 정확 —
// 64스레드 2서브그룹 구성은 결과 오염(RADV). A는 RowMajor, B는
// ColumnMajor(전치 로드), 타일 16×16.
//
// 수치(비트 동일 목표): sb(32원소)당 qsum = Σ q_u8·x_i8 — i32 누산은 정수
// exact(순서 무관) → v5와 동일값. acc += sBd·(ad·qsum − am·sBsum) 동일.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint8_t sAu8a[16][16];  // sb 타일1(k 0..16): q 니블→u8
shared uint8_t sAu8b[16][16];  // sb 타일2(k 16..32)
shared float sAd[16];
shared float sAm[16];
shared int8_t sBi8a[16][16];   // sb 타일1(xq i8)
shared int8_t sBi8b[16][16];   // sb 타일2
shared float sBd[16];
shared float sBsum[16];
shared int sAcc32[16][16];     // qsum 스토어
shared float sAccF[16][16];    // f32 최종 누산

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 16;
    int nrow = int(min(16u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    bool band_live = uint(r0e) < rp;
    uint e = band_live ? rowexp[uint(r0e)] : 0u;
    int nt = int(min(16u, rp - uint(min(uint(r0e), rp))));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int live_cnt = 0;
    if (band_live) {
        for (int q2 = 0; q2 < 16; q2++) {
            if (uint(r0e + q2) < rp && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
        }
    }
    for (int i = int(tid); i < 16 * 16; i += 32) {
        sAccF[i >> 4][i & 15] = 0.0;
    }
    barrier();

    coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma0, ma1;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb0, mb1;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc32;

    float sAdSb0 = 0.0; float sAdSb40 = 0.0;
    for (int sb = 0; sb < n_sub; sb++) {
        if (pc.mode == 1u && tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
            if (sb == 0) sAdSb0 = sAd[0];
            if (sb == 40) sAdSb40 = sAd[0];
        }
        // ── A 스테이징: 니블→u8. 스레드가 (m, 워드) 분담(16×8=128 → 4회).
        for (int i = int(tid); i < 16 * 8; i += 32) {
            int m = i >> 3;
            int p = i & 7;
            int row = row0 + m;
            if (row < row0 + nrow) {
                uint wq4 = ebase + uint(row) * row_words + uint(sb >> 3) * 36u;
                uint qbase = wq4 + 4u + uint(((sb & 7) >> 1) * 8);
                bool hi = (sb & 1) != 0;
                uint w = w0c[qbase + uint(p)];
                w = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                sAu8a[m][p * 4 + 0] = uint8_t(w & 0xFu);
                sAu8a[m][p * 4 + 1] = uint8_t((w >> 4) & 0xFu);
                sAu8a[m][p * 4 + 2] = uint8_t((w >> 8) & 0xFu);
                sAu8a[m][p * 4 + 3] = uint8_t((w >> 12) & 0xFu);
                sAu8b[m][p * 4 + 0] = uint8_t((w >> 16) & 0xFu);
                sAu8b[m][p * 4 + 1] = uint8_t((w >> 20) & 0xFu);
                sAu8b[m][p * 4 + 2] = uint8_t((w >> 24) & 0xFu);
                sAu8b[m][p * 4 + 3] = uint8_t((w >> 28) & 0xFu);
                if (p == 0) {
                    float d = f16_exact(w0c[wq4] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq4] >> 16);
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq4, j) & 63u;
                        m_v = sbyte(wq4, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq4, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq4, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq4, j) >> 6) << 4);
                    }
                    sAd[m] = d * float(s_v);
                    sAm[m] = dmin * float(m_v);
                }
            } else {
                for (int b = 0; b < 4; b++) {
                    sAu8a[m][p * 4 + b] = uint8_t(0);
                    sAu8b[m][p * 4 + b] = uint8_t(0);
                }
                if (p == 0) { sAd[m] = 0.0; sAm[m] = 0.0; }
            }
        }
        // ── B 스테이징: xq 워드 → i8 바이트.
        for (int i = int(tid); i < 16 * 4; i += 32) {
            int rb = i >> 2;
            int p = i & 3;
            if (rb < live_cnt) {
                uint pr_ = perm_pad[uint(r0e + rb)];
                uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                uint w = xq[base + uint(sb * 8 + p)];
                sBi8a[rb][p * 4 + 0] = int8_t(w & 0xFFu);
                sBi8a[rb][p * 4 + 1] = int8_t((w >> 8) & 0xFFu);
                sBi8a[rb][p * 4 + 2] = int8_t((w >> 16) & 0xFFu);
                sBi8a[rb][p * 4 + 3] = int8_t(w >> 24);
                uint w2 = xq[base + uint(sb * 8 + 4u + p)];
                sBi8b[rb][p * 4 + 0] = int8_t(w2 & 0xFFu);
                sBi8b[rb][p * 4 + 1] = int8_t((w2 >> 8) & 0xFFu);
                sBi8b[rb][p * 4 + 2] = int8_t((w2 >> 16) & 0xFFu);
                sBi8b[rb][p * 4 + 3] = int8_t(w2 >> 24);
                if (p == 0) {
                    sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    uint qsb = qw + (uint(n_in) >> 5);
                    sBsum[rb] = float(int(xq[base + qsb + uint(sb * 2)])
                                    + int(xq[base + qsb + uint(sb * 2) + 1u]));
                }
            } else {
                for (int b = 0; b < 4; b++) {
                    sBi8a[rb][p * 4 + b] = int8_t(0);
                    sBi8b[rb][p * 4 + b] = int8_t(0);
                }
                if (p == 0) { sBd[rb] = 0.0; sBsum[rb] = 0.0; }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA(coopmat) — WG=서브그룹1, K32 = 16×2 타일.
        acc32 = coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
        coopMatLoad(ma0, sAu8a[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb0, sBi8a[0], 0, 16, gl_CooperativeMatrixLayoutColumnMajor);
        acc32 = coopMatMulAdd(ma0, mb0, acc32);
        coopMatLoad(ma1, sAu8b[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb1, sBi8b[0], 0, 16, gl_CooperativeMatrixLayoutColumnMajor);
        acc32 = coopMatMulAdd(ma1, mb1, acc32);
        coopMatStore(acc32, sAcc32[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        // ── 스케일: 레인당 8원소.
        for (int i = 0; i < 8; i++) {
            int idx = int(tid) * 8 + i;
            int m = idx >> 4;
            int r = idx & 15;
            sAccF[m][r] += sBd[r] * (sAd[m] * float(sAcc32[m][r]) - sAm[m] * sBsum[r]);
        }
        barrier();
    }

    // plans/99 디버그(mode=1): sb=0의 상태를 outv에 직접 기록.
    if (pc.mode == 1u) {
        if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
            outv[8] = sAdSb0; outv[9] = sAdSb40;
            outv[0] = sAd[0]; outv[1] = sAm[0];
            outv[2] = sBd[0]; outv[3] = sBsum[0];
            outv[4] = float(sAcc32[0][0]);
            outv[5] = sAu8a[0][0] + sAu8a[0][15];  // u8 산출
            outv[6] = sAccF[0][0];
            outv[7] = float(sBi8a[0][0]);
        }
        return;
    }
    // ── 드레인: 직접산란(G2 계약 — 센티널 가드).
    if (int(tid) < nrow) {
        int m = int(tid);
        for (int c = 0; c < nt; c++) {
            uint pr2 = perm_pad[uint(r0e + c)];
            if (pr2 != 0xFFFFFFFFu) {
                outv[pr2 * pc.n_out + uint(row0 + m)] = sAccF[m][c];
            }
        }
    }
}
