#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require

// fn_moe_tile_q4k_cm8 (plans/99) — q4_K MoE MMQ의 MMA를 INT8 coopmat로 교체.
// v5(fn_moe_tile_q4k_mmq)의 밴드/센티널/드레인 골격 + coopMatMulAdd(u8,i8).
// RADV 26.2.3 i8 coopmat(u8×i8→i32) — 프로브 22 TMAC/s(스칼라 dot ~16배).
//
// 검증된 제약(plans/99 로그#2): WG=32스레드(서브그룹1)에서만 정확 —
// 64스레드 2서브그룹 구성은 결과 오염(RADV). A는 RowMajor, B는
// ColumnMajor(전치 로드), 타일 16×16.
//
// 수치(비트 동일 목표): sb(32원소)당 qsum = Σ q_u8·x_i8 — i32 누산은 정수
// exact(순서 무관) → v5와 동일값. acc += sBd·(ad·qsum − am·sBsum) 동일.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(binding = 13) buffer Cm8Scratch { uint8_t sc8[]; };
layout(binding = 14) buffer Cm8ScratchI { int8_t sc8i[]; };
layout(binding = 15) buffer Cm8ScratchW { int scw[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

// plans/99: 타일 원소는 SSBO 스크래치(WG 슬롯) — RADV에서 shared 소스
// coopmat 로드가 다중 WG 동시성下 부정확(비결정적). 스케일류만 shared.
// WG 슬롯 레이아웃: [A타일1 256][A타일2 256][B타일1 256][B타일2 256] = 1KB.
shared float sAd[16];
shared float sAm[16];

shared float sBd[16];
shared float sBsum[16];
// sAcc32 → SSBO 스크래치(WG 슬롯 + 512B, i32 128개×2타일 병렬 불가 — 256개).
#define ACC32(i) scw[wgslot/4u + uint(i)]  // wgslot은 바이트 — /4로 i32 기준
shared float sAccF[16][16];    // f32 최종 누산

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 16;
    int nrow = int(min(16u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    bool band_live = uint(r0e) < rp;
    uint e = band_live ? rowexp[uint(r0e)] : 0u;
    int nt = int(min(16u, rp - uint(min(uint(r0e), rp))));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);
    // plans/99: 타일 SSBO 스크래치 뷰 — shared 소스 coopmat 로드가 다중 WG
    // 동시성에서 부정확(RADV 비결정성)하여 연산 원소만 SSBO 슬롯으로.
    uint wgslot = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 1024u;
#define A0(i) sc8[wgslot + uint(i)]
#define A1(i) sc8[wgslot + ((pc.mode == 13u) ? 1024u : 256u) + uint(i)]
#define B0(i) sc8i[wgslot + uint(i)]
#define B1(i) sc8i[wgslot + ((pc.mode == 13u) ? 1024u : 256u) + uint(i)]

    int live_cnt = 0;
    if (band_live) {
        for (int q2 = 0; q2 < 16; q2++) {
            if (uint(r0e + q2) < rp && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
        }
    }
    for (int i = int(tid); i < 16 * 16; i += 32) {
        sAccF[i >> 4][i & 15] = 0.0;
    }
    if (pc.mode == 8u && tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u)
        outv[99] = -1.0;
    barrier();

    coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma0, ma1;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb0, mb1;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc32;

    float sAdSb0 = 0.0; float sAdSb40 = 0.0;
    int sDumpA0 = -1;
    for (int sb = 0; sb < n_sub; sb++) {
        if (pc.mode == 1u && tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
            if (sb == 0) { sAdSb0 = sAd[0]; sDumpA0 = 1; }
            if (sb == 40) sAdSb40 = sAd[0];
        }
        // ── A 스테이징: 니블→u8. 스레드가 (m, 워드) 분담(16×8=128 → 4회).
        for (int i = int(tid); i < 16 * 8; i += 32) {
            int m = i >> 3;
            int p = i & 7;
            int row = row0 + m;
            if (row < row0 + nrow) {
                uint wq4 = ebase + uint(row) * row_words + uint(sb >> 3) * 36u;
                uint qbase = wq4 + 4u + uint(((sb & 7) >> 1) * 8);
                bool hi = (sb & 1) != 0;
                uint w = w0c[qbase + uint(p)];
                // plans/99 수정: 마스크된 워드의 '바이트'가 곧 니블값(0..15).
                // (w>>4j)&0xF 이중 추출이 was 버그 — 0 교대 패턴의 원인).
                w = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                if (p < 4) {
                    A0(m * 16 + p * 4 + 0) = uint8_t(w & 0xFFu);
                    A0(m * 16 + p * 4 + 1) = uint8_t((w >> 8) & 0xFFu);
                    A0(m * 16 + p * 4 + 2) = uint8_t((w >> 16) & 0xFFu);
                    A0(m * 16 + p * 4 + 3) = uint8_t((w >> 24) & 0xFFu);
                } else {
                    int q4 = p - 4;
                    A1(m * 16 + q4 * 4 + 0) = uint8_t(w & 0xFFu);
                    A1(m * 16 + q4 * 4 + 1) = uint8_t((w >> 8) & 0xFFu);
                    A1(m * 16 + q4 * 4 + 2) = uint8_t((w >> 16) & 0xFFu);
                    A1(m * 16 + q4 * 4 + 3) = uint8_t((w >> 24) & 0xFFu);
                }
                if (p == 0) {
                    float d = f16_exact(w0c[wq4] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq4] >> 16);
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq4, j) & 63u;
                        m_v = sbyte(wq4, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq4, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq4, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq4, j) >> 6) << 4);
                    }
                    sAd[m] = d * float(s_v);
                    sAm[m] = dmin * float(m_v);
                }
            } else {
                for (int b = 0; b < 4; b++) {
                    A0(m * 16 + p * 4 + b) = uint8_t(0);
                    A1(m * 16 + p * 4 + b) = uint8_t(0);
                }
                if (p == 0) { sAd[m] = 0.0; sAm[m] = 0.0; }
            }
        }
        // ── B 스테이징: xq 워드 → i8 바이트.
        for (int i = int(tid); i < 16 * 4; i += 32) {
            int rb = i >> 2;
            int p = i & 3;
            if (rb < live_cnt) {
                uint pr_ = perm_pad[uint(r0e + rb)];
                uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                uint w = xq[base + uint(sb * 8 + p)];
                B0(rb * 16 + p * 4 + 0) = int8_t(w & 0xFFu);
                B0(rb * 16 + p * 4 + 1) = int8_t((w >> 8) & 0xFFu);
                B0(rb * 16 + p * 4 + 2) = int8_t((w >> 16) & 0xFFu);
                B0(rb * 16 + p * 4 + 3) = int8_t(w >> 24);
                uint w2 = xq[base + uint(sb * 8 + 4u + p)];
                B1(rb * 16 + p * 4 + 0) = int8_t(w2 & 0xFFu);
                B1(rb * 16 + p * 4 + 1) = int8_t((w2 >> 8) & 0xFFu);
                B1(rb * 16 + p * 4 + 2) = int8_t((w2 >> 16) & 0xFFu);
                B1(rb * 16 + p * 4 + 3) = int8_t(w2 >> 24);
                if (p == 0) {
                    sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    uint qsb = qw + (uint(n_in) >> 5);
                    sBsum[rb] = float(int(xq[base + qsb + uint(sb * 2)])
                                    + int(xq[base + qsb + uint(sb * 2) + 1u]));
                }
            } else {
                for (int b = 0; b < 4; b++) {
                    B0(rb * 16 + p * 4 + b) = int8_t(0);
                    B1(rb * 16 + p * 4 + b) = int8_t(0);
                }
                if (p == 0) { sBd[rb] = 0.0; sBsum[rb] = 0.0; }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA(coopmat) — WG=서브그룹1, K32 = 16×2 타일.
        acc32 = coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
        if (pc.mode == 7u) {
            // plans/99 격리: coopmat 대신 스칼라 dot(스테이징·스케일 동일).
            // 레인 i가 (m,r)=(i>>4, i&15)+(i+32)... 8셀 — 스케일 루프 배분과 동일.
            for (int i8 = 0; i8 < 8; i8++) {
                int idx = int(tid) * 8 + i8;
                int m = idx >> 4, r = idx & 15;
                int qsum = 0;
                for (int k = 0; k < 16; k++) {
                    qsum += int(A0(m * 16 + k)) * int(B0(r * 16 + k));
                    qsum += int(A1(m * 16 + k)) * int(B1(r * 16 + k));
                }
                scw[wgslot / 4u + uint(m * 16 + r)] = qsum;
            }
        } else if (pc.mode == 14u) {
            // plans/99: ma0 변수에 +256 오프셋 — 변수 vs 오프셋 격리.
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) outv[250] = 780.0;
            if (sb == 0) {
            coopMatLoad(ma0, sc8, wgslot + 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot + 256u, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
                int bad = 0;
                for (int m2 = 0; m2 < 16; m2++)
                    for (int r2 = 0; r2 < 16; r2++) {
                        int qs = 0;
                        for (int k = 0; k < 16; k++)
                            qs += int(A1(m2 * 16 + k)) * int(B1(r2 * 16 + k));
                        if (scw[wgslot / 4u + uint(m2 * 16 + r2)] != qs) bad++;
                    }
                outv[100] = float(bad);
            }
            }
            return;
        } else if (pc.mode == 13u) {
            // plans/99: 오프셋 4배 가설 — 타일1 스테이징/로드 양쪽 1024로.
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) outv[250] = 779.0;
            if (sb == 0) {
            coopMatLoad(ma1, sc8, wgslot + 1024u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb1, sc8i, wgslot + 1024u, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma1, mb1, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
                int bad = 0;
                for (int m2 = 0; m2 < 16; m2++)
                    for (int r2 = 0; r2 < 16; r2++) {
                        int qs = 0;
                        for (int k = 0; k < 16; k++)
                            qs += int(sc8[wgslot + 1024u + uint(m2 * 16 + k)]) * int(sc8i[wgslot + 1024u + uint(r2 * 16 + k)]);
                        if (scw[wgslot / 4u + uint(m2 * 16 + r2)] != qs) bad++;
                    }
                outv[100] = float(bad);
            }
            }
            return;
        } else if (pc.mode == 12u) {
            // plans/99: 타일1 단독(wgslot+256) — 오프셋/체인 격리.
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) outv[250] = 778.0;
            if (sb == 0) {
            coopMatLoad(ma1, sc8, wgslot + 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb1, sc8i, wgslot + 256u, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma1, mb1, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
                int bad = 0;
                for (int m2 = 0; m2 < 16; m2++)
                    for (int r2 = 0; r2 < 16; r2++) {
                        int qs = 0;
                        for (int k = 0; k < 16; k++)
                            qs += int(A1(m2 * 16 + k)) * int(B1(r2 * 16 + k));
                        if (scw[wgslot / 4u + uint(m2 * 16 + r2)] != qs) bad++;
                    }
                outv[100] = float(bad);
            }
            }
            return;
        } else if (pc.mode == 11u) {
            // plans/99: 단일 타일0만 — 체인/단일 격리.
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) outv[250] = 777.0;
            if (sb == 0) {
            coopMatLoad(ma0, sc8, wgslot, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
                int bad = 0;
                for (int m2 = 0; m2 < 16; m2++)
                    for (int r2 = 0; r2 < 16; r2++) {
                        int qs = 0;
                        for (int k = 0; k < 16; k++)
                            qs += int(A0(m2 * 16 + k)) * int(B0(r2 * 16 + k));
                        if (scw[wgslot / 4u + uint(m2 * 16 + r2)] != qs) bad++;
                    }
                outv[100] = float(bad);
                for (int q = 0; q < 16; q++) outv[168 + q] = float(scw[wgslot / 4u + uint(q)]);
            }
            }
            return;
        } else if (pc.mode == 10u) {
            // plans/99: A를 항등으로 → C[0][r] = B_tile(0,r) = B(r,0) 판독.
            if (gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u && tid == 0u) {
                for (int m = 0; m < 16; m++)
                    for (int k = 0; k < 16; k++) {
                        A0(m * 16 + k) = uint8_t(m == k ? 1 : 0);
                        A1(m * 16 + k) = uint8_t(0);
                    }
            }
            memoryBarrierBuffer();
            barrier();
            if (sb == 0) {
            coopMatLoad(ma0, sc8, wgslot, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u)
                for (int q = 0; q < 16; q++) outv[200 + q] = float(scw[wgslot / 4u + uint(q)]);
            }
            return;
        } else if (pc.mode == 9u) {
            // plans/99: B를 항등으로 → C = coopmat이 읽은 A 오퍼런드 판독.
            if (gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u && tid == 0u) {
                for (int r = 0; r < 16; r++)
                    for (int k = 0; k < 16; k++)
                        B0(r * 16 + k) = int8_t(r == k ? 1 : 0);
            }
            memoryBarrierBuffer();
            barrier();
            if (sb == 0) {
            coopMatLoad(ma0, sc8, wgslot, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u)
                for (int q = 0; q < 16; q++) outv[200 + q] = float(scw[wgslot / 4u + uint(q)]);
            }
            return;
        } else if (pc.mode == 8u) {
            // plans/99 in-situ 자기검증: coopmat 결과를 즉석 스칼라와 비교.
            coopMatLoad(ma0, sc8, wgslot, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatLoad(ma1, sc8, wgslot + 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb1, sc8i, wgslot + 256u, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma1, mb1, acc32);
            coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
            memoryBarrierBuffer();
            barrier();
            // 스칼라 재계산·불일치 카운트 → outv[100](WG0만).
            if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
                if (sb > 0 && outv[99] < 0.0 && true) { } // 자리표시
                int bad = 0;
                for (int m2 = 0; m2 < 16; m2++)
                    for (int r2 = 0; r2 < 16; r2++) {
                        int qs = 0;
                        for (int k = 0; k < 16; k++) {
                            qs += int(A0(m2 * 16 + k)) * int(B0(r2 * 16 + k));
                            qs += int(A1(m2 * 16 + k)) * int(B1(r2 * 16 + k));
                        }
                        if (scw[wgslot / 4u + uint(m2 * 16 + r2)] != qs) bad++;
                    }
                outv[100] = float(bad);
                if (sb == 0) outv[98] = float(bad);
                if (bad > 0 && outv[99] < 0.0) outv[99] = float(sb);
                outv[101] = float(gl_SubgroupSize);
                outv[102] = float(gl_NumSubgroups);
                outv[103] = float(gl_SubgroupInvocationID);
                // outv[104..]: 전체 16바이트×4 + scw 행0.
                for (int q = 0; q < 16; q++) {
                    outv[104 + q] = float(A0(q));
                    outv[120 + q] = float(A1(q));
                    outv[136 + q] = float(B0(q));
                    outv[152 + q] = float(B1(q));
                    outv[168 + q] = float(scw[wgslot / 4u + uint(q)]);
                    outv[184 + q] = float(B0(q * 16));  // B(r,0) 열
                }
            }
            return;
        } else {
        // plans/99 병발 수정: 이 RADV에서 두 번째 coopmat<UseA/UseB> 객체
        // (ma1/mb1)의 로드가 오염됨 — 오프셋 무관, 변수 자체. ma0/mb0 재사용.
        coopMatLoad(ma0, sc8, wgslot, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
        acc32 = coopMatMulAdd(ma0, mb0, acc32);
        coopMatLoad(ma0, sc8, wgslot + 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb0, sc8i, wgslot + 256u, 16, gl_CooperativeMatrixLayoutColumnMajor);
        acc32 = coopMatMulAdd(ma0, mb0, acc32);
        coopMatStore(acc32, scw, wgslot / 4u, 16, gl_CooperativeMatrixLayoutRowMajor);
        }
        // plans/99: scw는 SSBO — 읽어들이려면 Buffer 배리어 필수(Shared만으론
        // 비결정론 레이스: got가 실행마다 변동했음).
        memoryBarrierShared();
        memoryBarrierBuffer();
        barrier();
        // ── 스케일: 레인당 8원소.
        for (int i = 0; i < 8; i++) {
            int idx = int(tid) * 8 + i;
            int m = idx >> 4;
            int r = idx & 15;
            sAccF[m][r] += sBd[r] * (sAd[m] * float(scw[wgslot / 4u + uint(m * 16 + r)]) - sAm[m] * sBsum[r]);
        }
        memoryBarrierShared();
        memoryBarrierBuffer();
        barrier();
    }

    // plans/99 디버그(mode=1): sb=0의 상태를 outv에 직접 기록.
    if (pc.mode == 1u) {
        if (tid == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) {
            outv[8] = sAdSb0; outv[9] = sAdSb40;
            // sb=0 덤프: A 니블 32 + B 바이트 32 (outv[10..74]).
            if (sDumpA0 >= 0) {
                for (int i = 0; i < 16; i++) {
                    outv[10 + i] = float(A0(i));
                    outv[26 + i] = float(A1(i));
                    outv[42 + i] = float(B0(i));
                    outv[58 + i] = float(B1(i));
                }
            }
            outv[0] = sAd[0]; outv[1] = sAm[0];
            outv[2] = sBd[0]; outv[3] = sBsum[0];
            outv[4] = float(scw[wgslot / 4u]);
            outv[5] = float(A0(0)) + float(A0(15));  // u8 산출
            outv[6] = sAccF[0][0];
            outv[7] = float(B0(0));
        }
        return;
    }
    // ── 드레인: 직접산란(G2 계약 — 센티널 가드).
    if (int(tid) < nrow) {
        int m = int(tid);
        for (int c = 0; c < nt; c++) {
            uint pr2 = perm_pad[uint(r0e + c)];
            if (pr2 != 0xFFFFFFFFu) {
                outv[pr2 * pc.n_out + uint(row0 + m)] = sAccF[m][c];
            }
        }
    }
}
