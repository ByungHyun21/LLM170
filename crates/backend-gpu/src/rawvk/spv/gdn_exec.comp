#version 450

// fn_gdn_exec (plans/100 v2-B) — 청크 실행: L/W 글로벌 판독(A 커널 산출),
// c/전방대입/출력/상태 갱신. grid (청크, pair, d_v/64). WG 64 = u행 1:1.
// 셔플 0회 — 전방대입은 d-와이드 SAXPY. v1 대비: L/W 계산 제거(u무관
// 사전계산으로 이동) — 실행은 판독+대입+조립만.
layout(local_size_x = 64) in;
layout(binding = 0) buffer S { float s[]; };
layout(binding = 1) readonly buffer Q { float q[]; };
layout(binding = 2) readonly buffer K { float k[]; };
layout(binding = 3) readonly buffer V { float v[]; };
layout(binding = 4) readonly buffer Lbuf { float lin[]; };   // [chunk][C*C]
layout(binding = 5) readonly buffer Wbuf { float win[]; };
layout(binding = 6) readonly buffer Gbuf { float gin[]; };   // [chunk][C]
layout(binding = 7) buffer O { float o[]; };
layout(push_constant) uniform PC {
    int ks; int vs; int hv; int hk; int t; int chunk0; int csize; float scale;
} pc;

const int C = 32;  // LDS 한계 — 64→32(gdn_lw 64.5KB 초과 수정)
const int BV = 64;
shared float sZ[C * BV];
shared float sG[C];
shared float sK[C * 128];
shared float sL[C * C];

void main() {
    int chunk = int(gl_WorkGroupID.x);
    int pair = int(gl_WorkGroupID.y);
    int ublk = int(gl_WorkGroupID.z);
    int u0 = ublk * BV;
    int tid = int(gl_LocalInvocationID.x);
    int u = tid;
    int h = pair % pc.hv;
    int kh = h % pc.hk;
    int t0 = pc.chunk0 + chunk * pc.csize;
    int cs = min(pc.csize, pc.t - t0);
    int d = 128;
    if (cs <= 0) return;
    int base_s = pair * d * d;

    for (int i = tid; i < cs; i += BV) sG[i] = gin[chunk * 2 * C + i];
    for (int i2 = tid; i2 < cs * d; i2 += BV) {
        sK[(i2 / d) * 128 + (i2 % d)] = k[pc.ks * (t0 + i2 / d) + kh * d + (i2 % d)];
    }
    for (int i3 = tid; i3 < cs * cs; i3 += BV) {
        sL[i3] = lin[chunk * C * C + i3];
    }
    barrier();
    barrier();

    // ── c_τ[u] = Be_τ·(V_τ[u] − G_τ·⟨K_τ, S⁰_u⟩) — 스레드=u(스캔과 동일 산술).
    for (int tau = 0; tau < cs; tau++) {
        int ti = t0 + tau;
        float be = gin[chunk * 2 * C + C + tau];  // A가 Be도 확장 기록
        float sk0 = 0.0;
        for (int j = 0; j < d; j++) {
            sk0 += sK[tau * 128 + j] * s[base_s + (u0 + u) * d + j];
        }
        sZ[tau * BV + u] = be * (v[pc.vs * ti + d * pair + (u0 + u)] - sG[tau] * sk0);
    }
    barrier();

    // ── 전방대입 z_τ = c_τ − Σ_{σ<τ} L[τ,σ]·z_σ — C단계, u-와이드.
    for (int tau = 1; tau < cs; tau++) {
        float acc = 0.0;
        for (int sig = 0; sig < tau; sig++) {
            acc += sL[tau * C + sig] * sZ[sig * BV + u];
        }
        sZ[tau * BV + u] -= acc;
        memoryBarrierShared();
        barrier();
    }

    // ── 출력 o_t[u] = G_t·⟨Q_t,S⁰_u⟩ + Σ_{σ≤t} w·z_σ[u].
    for (int tt = 0; tt < cs; tt++) {
        int ti = t0 + tt;
        float q0 = 0.0;
        for (int j = 0; j < d; j++) {
            q0 += q[pc.ks * ti + kh * d + j] * s[base_s + (u0 + u) * d + j];
        }
        float acc = sG[tt] * q0;
        for (int sig = 0; sig <= tt; sig++) {
            acc += win[chunk * C * C + tt * C + sig] * sZ[sig * BV + u];
        }
        o[pc.vs * ti + d * pair + (u0 + u)] = acc * pc.scale;
    }

    // ── 상태 갱신 S^C = G_{cs-1}·S⁰ + Σ_σ (G_{cs-1}/G_σ)·K_σ·z_σ[u].
    {
        float glast = sG[cs - 1];
        for (int j = 0; j < d; j += 4) {
            float n0 = glast * s[base_s + (u0 + u) * d + j];
            float n1 = glast * s[base_s + (u0 + u) * d + j + 1];
            float n2 = glast * s[base_s + (u0 + u) * d + j + 2];
            float n3 = glast * s[base_s + (u0 + u) * d + j + 3];
            for (int sig = 0; sig < cs; sig++) {
                float cf = (glast / sG[sig]) * sZ[sig * BV + u];
                int ti = t0 + sig;
                n0 += sK[sig * 128 + j] * cf;
                n1 += sK[sig * 128 + j + 1] * cf;
                n2 += sK[sig * 128 + j + 2] * cf;
                n3 += sK[sig * 128 + j + 3] * cf;
            }
            s[base_s + (u0 + u) * d + j] = n0;
            s[base_s + (u0 + u) * d + j + 1] = n1;
            s[base_s + (u0 + u) * d + j + 2] = n2;
            s[base_s + (u0 + u) * d + j + 3] = n3;
        }
    }
}
