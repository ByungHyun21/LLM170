#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// tile_q8128ks (plans/105 P1) — 스키니 q8_0 밀집 타일의 coopmat K-분할판.
// 원판(BM64·BN128)은 10240→320에서 그리드 5×4=20WG(점유 4%). 본 판은
// 원판 타일 형상을 그대로 유지(스테이징 상쇄 보존 — 소형 타일 부정, 원장 66)하고
// z=K슬라이스로만 병렬성 공급: 그리드 (t/128)×(n_out/64)×ks.
// 부분합은 f32 스크래치(원판의 f16 Ctmp 드레인 우회 — f32s 전례 클래스,
// f64 참조에 더 근사). 축소는 FnKsred(결정론 z 승순).
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xbuf { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };   // 미사용(바인딩 호환)
layout(binding = 10) buffer Scr { float sc[]; };     // [z][t][n_out] 부분합
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint xq_w; uint t; uint row_off; uint ks;
} pc;

#define BK 32
#define BM 64
#define BN 128
#define SHMEM_STRIDE (BK / 2 + 2)

#define WG(idx) w0c[idx]

shared f16vec2 buf_a[BM * SHMEM_STRIDE];
shared f16vec2 buf_b[BN * SHMEM_STRIDE];
shared float Ctmpf[64][17];

void load_a(uint k0, int row0, int nrow, int blocks, uint tid) {
    int r = int(tid >> 1);
    int kc = int(tid & 1u) * 16;
    int row = row0 + r;
    if (row >= nrow + row0) {
        for (int v = 0; v < 8; v++) buf_a[r * SHMEM_STRIDE + (kc >> 1) + v] = f16vec2(float16_t(0.0));
        return;
    }
    int rowb = row * blocks * 34 + int(k0 >> 5) * 34;
    uint wd = WG(uint(rowb >> 2));
    float d = unpackHalf2x16(wd >> uint((rowb & 3) * 8)).x;
    uint qb = uint(rowb + 2) + uint(kc);
    uint w[4];
    for (int i = 0; i < 4; i++) {
        uint wva = WG((qb + uint(i * 4)) >> 2);
        uint rem = (qb + uint(i * 4)) & 3u;
        if (rem != 0u) {
            uint w2 = WG(((qb + uint(i * 4)) >> 2) + 1u);
            wva = (wva >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
        }
        w[i] = wva;
    }
    for (int e = 0; e < 16; e += 2) {
        float vals[2];
        for (int h = 0; h < 2; h++) {
            uint wsel = w[(e + h) >> 2];
            uint b8 = (wsel >> uint(((e + h) & 3) * 8)) & 0xFFu;
            vals[h] = float((int(b8) << 24) >> 24) * d;
        }
        buf_a[r * SHMEM_STRIDE + (kc >> 1) + (e >> 1)] = f16vec2(float16_t(vals[0]), float16_t(vals[1]));
    }
}

void load_b(uint k0, int nt, uint tid, int n_in, uint tb) {
    int e0 = int(tid) * 32;
    int ti2 = e0 >> 5;
    int k2 = 0;
    if (ti2 >= nt) {
        for (int v = 0; v < 16; v++) buf_b[ti2 * SHMEM_STRIDE + v] = f16vec2(float16_t(0.0));
        return;
    }
    uint base = uint(tb + uint(ti2)) * pc.xq_w;
    int xw = int(k0) >> 2;
    float yd = uintBitsToFloat(xq[base + uint((n_in >> 2) + (k0 >> 5))]);
    for (int e = 0; e < 32; e += 2) {
        float vals[2];
        for (int h = 0; h < 2; h++) {
            uint wv = xq[base + uint(xw + ((k2 + e + h) >> 2))];
            int b = int((wv >> uint(((k2 + e + h) & 3) * 8)) & 0xFFu) << 24 >> 24;
            vals[h] = float(b) * yd;
        }
        buf_b[ti2 * SHMEM_STRIDE + (k2 >> 1) + (e >> 1)] = f16vec2(float16_t(vals[0]), float16_t(vals[1]));
    }
}

void main() {
    uint slab = gl_WorkGroupID.x;
    uint bid = gl_WorkGroupID.y;
    uint z = gl_WorkGroupID.z;
    uint tid = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    int n_in = int(pc.n_in);
    int blocks = n_in >> 5;
    // z별 K범위 — 32원소 블록 정렬(상향). 꼬리 슬라이스가 짧아도 무결.
    int kb_all = n_in >> 5;
    int per = (kb_all + int(pc.ks) - 1) / int(pc.ks);
    int kb0 = min(int(z) * per, kb_all);
    int kb1 = min(kb0 + per, kb_all);
    int row0 = int(pc.row_off) + int(bid) * BM;
    int tok_base = int(slab) * BN;
    int nt = int(min(uint(BN), pc.t - uint(tok_base)));
    int nrow = int(min(BM, pc.n_out - uint(row0)));
    uint plane = z * pc.t * pc.n_out;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][4];
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (int kb = kb0; kb < kb1; kb++) {
        load_a(uint(kb) * 32u, row0, nrow, blocks, tid);
        load_b(uint(kb) * 32u, nt, tid, n_in, uint(tok_base));
        barrier();
        int tbase = int(sg) * 64;
        for (uint ks = 0; ks < BK / 16; ks++) {
            for (uint wm = 0; wm < 4; wm++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
                coopMatLoad(fa, buf_a, (wm * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                for (uint wn = 0; wn < 4; wn++) {
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fbb;
                    coopMatLoad(fbb, buf_b, (tbase + wn * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                    acc[wm][wn] = coopMatMulAdd(fa, fbb, acc[wm][wn]);
                }
            }
        }
        barrier();
    }

    // 드레인: f32 부분합 — 소유 워프만 Ctmpf 저장 후 스칼라 산란.
    for (int q = 0; q < 8; q++) {
        if (nt <= q * 16) break;
        int wn = q - int(sg) * 4;
        if (wn >= 0 && wn < 4) {
            for (int wm = 0; wm < 4; wm++) {
                coopMatStore(acc[wm][wn], Ctmpf[wm * 16], 0, 17, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();
        int ncols = min(nt - q * 16, 16);
        for (int i = int(tid); i < nrow * ncols; i += 128) {
            int r = i / ncols;
            int ti = i % ncols;
            sc[plane + uint(tok_base + q * 16 + ti) * pc.n_out + uint(row0 + r)] = Ctmpf[r][ti];
        }
        barrier();
    }
}
