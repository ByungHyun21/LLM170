#version 450
#extension GL_KHR_shader_subgroup_basic : require

// addrms (plans/36 G2) — 잔차 덧셈 + rms_norm 융합 (llama multi_add_rms 대응).
// y[i] += x[i]·1.0 과 rms(y)를 한 패스: axpy가 쓰던 값과 동일 비트를 계산해
// 세그먼트 축소하므로 수치는 axpy+rms 2커널 경로와 완전히 동일.
// 축소 구조: 256세그먼트 f32 연속 누산 + f64 순차 결합 (plans/40 256스레드 —
// CPU ops::sq_sum 미러). 런치 절반이 목적 (GPU 시간 아님).
layout(local_size_x = 256) in;
layout(binding = 0) buffer Ybuf { float y[]; };   // 잔류 스트림 (갱신)
layout(binding = 1) readonly buffer Xbuf { float x[]; }; // 증분 (gout/fdown)
layout(binding = 2) readonly buffer Wbuf { float wv[]; };
layout(binding = 3) buffer Obuf { float outv[]; }; // 정규화 출력
layout(push_constant) uniform PC {
    uint n; uint t; float eps;
} pc;

shared double seg[256];
shared float invs;

void main() {
    uint row = gl_WorkGroupID.x;
    uint u = gl_LocalInvocationID.x;
    uint n = pc.n;
    if (row >= pc.t) return;
    int chunk = int((n + 255u) >> 8u);   // plans/40: 256스레드 (구 32 — t WGs뿐이라 과소병렬)
    int lo = int(u) * chunk;
    int xb = int(row * n);
    float acc = 0.0;
    if (uint(lo) < n) {
        int hi = min(lo + chunk, int(n));
        for (int i = lo; i < hi; i++) {
            // axpy_scaled와 동일 연산 순서: y + x·1.0
            float v = y[xb + i] + x[xb + i] * 1.0;
            y[xb + i] = v;
            acc += v * v;
        }
    }
    seg[u] = double(acc);
    barrier();
    if (u == 0u) {
        double sum = 0.0lf;
        for (int u2 = 0; u2 < 256; u2++) {
            if (uint(u2 * chunk) < n) sum += seg[u2];
        }
        float scale32 = float(sqrt(sum / double(n) + double(pc.eps)));
        invs = 1.0 / scale32;
    }
    barrier();
    if (uint(lo) < n) {
        int hi = min(lo + chunk, int(n));
        for (int i = lo; i < hi; i++) outv[xb + i] = y[xb + i] * invs * wv[i];
    }
}
