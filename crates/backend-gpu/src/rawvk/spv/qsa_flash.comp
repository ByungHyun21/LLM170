#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
// qsa_flash (plans/19) — rawhip qsa_flash t=1 미러. 게이티드 (q+gate 인터리브 2hd).
// grid (1, n_head), 256스레드 (act = tid < hd). 온라인 softmax f32.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Q { float q[]; };     // [n_head*2hd]
layout(binding = 1) readonly buffer Ck { float ck[]; };   // [ctx][n_kv*hd]
layout(binding = 2) readonly buffer Cv { float cv[]; };   // [ctx][n_kv*hd]
layout(binding = 3) readonly buffer Mask { uint mask[]; };// [ctx][ctx]
layout(binding = 4) buffer O { float o[]; };              // [n_head*hd]
layout(push_constant) uniform PC {
    int np; int nh; int nk; int hd; int ss; int pos;
} pc;
shared float qf[256];
shared float rs[8];
void main() {
    int h = int(gl_WorkGroupID.y);
    int tid = int(gl_LocalInvocationIndex);
    int lane = tid & 31;
    int wid = tid >> 5;
    bool act = tid < pc.hd;
    int kvh = h / (pc.nh / pc.nk);
    int qb = h * 2 * pc.hd;
    if (act) qf[tid] = q[qb + tid];
    barrier();
    float m = -3.4028235e38;
    float sm = 0.0;
    float acc = 0.0;
    for (int p = 0; p < pc.np; p++) {
        if (mask[pc.pos * pc.ss + p] == 0u) continue;
        int kb = p * pc.nk * pc.hd + kvh * pc.hd;
        float x = act ? qf[tid] * ck[kb + tid] : 0.0;
        for (int off = 16; off > 0; off >>= 1)
            x += subgroupShuffleDown(x, off);
        if (lane == 0) rs[wid & 7] = x;
        barrier();
        float d;
        if (tid == 0) {
            float y2 = 0.0;
            for (int j = 0; j < 8; j++) y2 += rs[j];
            rs[0] = y2;
        }
        barrier();
        d = rs[0];
        float m_new = max(m, d);
        float e_m = exp(m - m_new);
        float e_d = exp(d - m_new);
        sm = sm * e_m + e_d;
        float vv = act ? cv[kb + tid] : 0.0;
        acc = acc * e_m + e_d * vv;
        m = m_new;
    }
    if (!act) return;
    float g = 1.0 / (1.0 + exp(-q[qb + pc.hd + tid]));
    o[h * pc.hd + tid] = acc * (1.0 / sm) * g;
}
