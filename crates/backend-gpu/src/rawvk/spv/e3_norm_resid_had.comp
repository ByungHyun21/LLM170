#version 450

// e3_norm_resid_had (plans/121 메가융합 1호) — norm_resid + had_in 2종 융합:
// xn = rms_norm(x+ab)·w (xtb) + x = x+ab (xbuf) 에 더해
// ah1 = WHT128(f16(xn⊙suh1))/√128, ah2 = WHT128(f16(xn⊙suh2))/√128.
// 소비 선형 2종(qkv+z, gate+up)의 had_in 디스패치를 흡수(-2/층, 배리어
// 드레인 0.9ms×48층 ≈ 86ms/verify). 산술은 e3_norm_resid + exl3_had_in_tf32
// 의 정확 미러 — f16 pre-scale RTNE → f32 버터플라이 → f16 팩.
// 그리드 (T), WG=1024. 40 WHT 청크 = 5슬롯×8청크 병렬(red[1024]를 8×128로).
layout(local_size_x = 1024) in;

layout(binding = 0) buffer XB { float x[]; };           // [T][5120] r/w
layout(binding = 1) readonly buffer NW { float nw[]; };  // [5120]
layout(binding = 2) readonly buffer AB { float ab[]; };  // [T][5120]
layout(binding = 3) writeonly buffer XN { float xn[]; }; // [T][5120] → xtb
layout(binding = 4) readonly buffer S1 { uint s1[]; };   // f16쌍팩 [2560]
layout(binding = 5) readonly buffer S2 { uint s2[]; };   // f16쌍팩 [2560]
layout(binding = 6) writeonly buffer A1 { uint a1[]; };  // f16쌍팩 [T][2560]
layout(binding = 7) writeonly buffer A2 { uint a2[]; };  // f16쌍팩 [T][2560]
layout(push_constant) uniform PC {
    uint t_len;
    uint w_off;
} pc;

const float R_SCALE = 0.08838834764831845; // 1/sqrt(128)

uint f32_to_f16_rtne(float v) {
    uint xx = floatBitsToUint(v);
    uint sign = (xx >> 16) & 0x8000u;
    uint rest = xx & 0x7FFFFFFFu;
    if (rest >= 0x7F800000u) return sign | 0x7C00u | uint((rest & 0x7FFFFFu) != 0u);
    int e = int(rest >> 23) - 127;
    uint man = rest & 0x7FFFFFu;
    uint h;
    if (e >= -14) {
        h = (uint(e + 15) << 10) | (man >> 13);
        uint rem = man & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) h += 1u;
        if (h >= 0x7C00u) h = 0x7C00u;
    } else if (e < -25) {
        return sign;
    } else {
        uint m = 0x800000u | man;
        uint sh = uint(-14 - e) + 13u;
        uint rem = m & ((1u << sh) - 1u);
        h = m >> sh;
        uint halfway = 1u << (sh - 1);
        if (rem > halfway || (rem == halfway && (h & 1u) != 0u)) h += 1u;
    }
    return sign | h;
}

shared float red[1024];

void wht8(uint tid, uint base_col, float val, uint sb, uint wb) {
    // 8청크 병렬 128폭 버터플라이 — val은 이 스레드의 열(base_col+tid%128... 실제
    // 매핑: col = base_col + tid, 청크 = tid>>7, ctid = tid&127).
    uint ctid = tid & 127u;
    red[tid] = val;
    barrier();
    for (uint w = 1u; w < 128u; w <<= 1u) {
        uint grp = ctid / w;
        uint blk = (grp >> 1u) * 2u * w;
        uint i = blk + (ctid % w);
        uint dst = (tid - ctid) + i;
        uint dsw = dst + w;
        float a = red[dst];
        float b = red[dsw];
        barrier();
        red[dst] = a + b;
        red[dsw] = a - b;
        barrier();
    }
    float o = red[tid] * R_SCALE;
    barrier();
    if ((ctid & 1u) == 0u) {
        uint col = base_col + tid;
        uint ei = (gl_WorkGroupID.x * 5120u + col) >> 1u;
        uint w16 = f32_to_f16_rtne(o) | (f32_to_f16_rtne(red[tid + 1u] * R_SCALE) << 16u);
        if (sb != 0u) a1[ei] = w16;
        if (wb != 0u) a2[ei] = w16;
    }
    barrier();
}

void main() {
    uint t = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = t * 5120u;
    float v0 = x[base + tid] + ab[base + tid];
    float v1 = x[base + 1024u + tid] + ab[base + 1024u + tid];
    float v2 = x[base + 2048u + tid] + ab[base + 2048u + tid];
    float v3 = x[base + 3072u + tid] + ab[base + 3072u + tid];
    float v4 = x[base + 4096u + tid] + ab[base + 4096u + tid];
    float ss = v0 * v0 + v1 * v1 + v2 * v2 + v3 * v3 + v4 * v4;
    red[tid] = ss;
    barrier();
    for (uint st = 512u; st > 0u; st >>= 1u) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    float inv = 1.0 / sqrt(red[0] / 5120.0 + 1e-6);
    float n0 = v0 * inv * nw[pc.w_off + tid];
    float n1 = v1 * inv * nw[pc.w_off + 1024u + tid];
    float n2 = v2 * inv * nw[pc.w_off + 2048u + tid];
    float n3 = v3 * inv * nw[pc.w_off + 3072u + tid];
    float n4 = v4 * inv * nw[pc.w_off + 4096u + tid];
    xn[base + tid] = n0;
    xn[base + 1024u + tid] = n1;
    xn[base + 2048u + tid] = n2;
    xn[base + 3072u + tid] = n3;
    xn[base + 4096u + tid] = n4;
    x[base + tid] = v0;
    x[base + 1024u + tid] = v1;
    x[base + 2048u + tid] = v2;
    x[base + 3072u + tid] = v3;
    x[base + 4096u + tid] = v4;
    barrier();

    // 5슬롯 × 2변형 WHT — 각 슬롯은 열 [s*1024, s*1024+1024) = 8청크 연속.
    uint c1 = s1[(tid) >> 1u];
    uint c2 = s2[(tid) >> 1u];
    vec2 sv1 = unpackHalf2x16(c1);
    vec2 sv2 = unpackHalf2x16(c2);
    float pre1_0 = unpackHalf2x16(f32_to_f16_rtne(n0 * sv1[tid & 1u]))[0];
    float pre2_0 = unpackHalf2x16(f32_to_f16_rtne(n0 * sv2[tid & 1u]))[0];
    wht8(tid, 0u, pre1_0, 1u, 0u);
    wht8(tid, 0u, pre2_0, 0u, 1u);

    c1 = s1[(1024u + tid) >> 1u];
    c2 = s2[(1024u + tid) >> 1u];
    sv1 = unpackHalf2x16(c1);
    sv2 = unpackHalf2x16(c2);
    float pre1_1 = unpackHalf2x16(f32_to_f16_rtne(n1 * sv1[(1024u + tid) & 1u]))[0];
    float pre2_1 = unpackHalf2x16(f32_to_f16_rtne(n1 * sv2[(1024u + tid) & 1u]))[0];
    wht8(tid, 1024u, pre1_1, 1u, 0u);
    wht8(tid, 1024u, pre2_1, 0u, 1u);

    c1 = s1[(2048u + tid) >> 1u];
    c2 = s2[(2048u + tid) >> 1u];
    sv1 = unpackHalf2x16(c1);
    sv2 = unpackHalf2x16(c2);
    float pre1_2 = unpackHalf2x16(f32_to_f16_rtne(n2 * sv1[(2048u + tid) & 1u]))[0];
    float pre2_2 = unpackHalf2x16(f32_to_f16_rtne(n2 * sv2[(2048u + tid) & 1u]))[0];
    wht8(tid, 2048u, pre1_2, 1u, 0u);
    wht8(tid, 2048u, pre2_2, 0u, 1u);

    c1 = s1[(3072u + tid) >> 1u];
    c2 = s2[(3072u + tid) >> 1u];
    sv1 = unpackHalf2x16(c1);
    sv2 = unpackHalf2x16(c2);
    float pre1_3 = unpackHalf2x16(f32_to_f16_rtne(n3 * sv1[(3072u + tid) & 1u]))[0];
    float pre2_3 = unpackHalf2x16(f32_to_f16_rtne(n3 * sv2[(3072u + tid) & 1u]))[0];
    wht8(tid, 3072u, pre1_3, 1u, 0u);
    wht8(tid, 3072u, pre2_3, 0u, 1u);

    c1 = s1[(4096u + tid) >> 1u];
    c2 = s2[(4096u + tid) >> 1u];
    sv1 = unpackHalf2x16(c1);
    sv2 = unpackHalf2x16(c2);
    float pre1_4 = unpackHalf2x16(f32_to_f16_rtne(n4 * sv1[(4096u + tid) & 1u]))[0];
    float pre2_4 = unpackHalf2x16(f32_to_f16_rtne(n4 * sv2[(4096u + tid) & 1u]))[0];
    wht8(tid, 4096u, pre1_4, 1u, 0u);
    wht8(tid, 4096u, pre2_4, 0u, 1u);
}
