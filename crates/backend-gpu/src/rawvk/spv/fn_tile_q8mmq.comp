#version 450

// fn_tile_q8mmq (plans/95 P3a) — q8_0 밀집 GEMM의 int8 MMQ 판.
// tile_q8128(coopmat f16, [ts] 204ms/496회 ≈ 25GB/s) 대비 q8_0은 이미 int8 —
// A·B 모두 xq 동일 레이아웃([n_in/4 워드 i8][n_in/32 f32 스케일])이면
// 니블 전개 없이 OpSDot 직행. A측 레이아웃은 업로드 시 무손실 릴레이아웃
// (34B블록 → 워드정렬, Rust q8_0_relayout)로 맞춘다 — 값·스케일 불변.
// 산술 계약 — 스칼라 fn_tile_q8/gemv3와 동일식: acc += d_a·d_b·Σ(q·b),
// sb 승순 f32 누산, 정수부 i32 exact.
// plans/95 후속: 4 서브블록 배칭 스테이징 — 배리어 8배 감소. MMA는 항상
// 서브블록 승순 누산이므로 v1(게이트 PASS)과 비트 동일.
// 타일 = 64(n_out) × 64(t), 256스레드: 스테이징 (행=tid>>2, 레인=tid&3가
// 4sb×8워드 중 8워드 담당), MMA (thread_r=tid>>4, thread_c=tid&15) TM=4×TN=4.
// int8 내적은 sdot4p 센티널 → patch_sdot.py가 OpSDot로 이진 치환.
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };   // q8r 릴레이아웃
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint xq_w;
} pc;

shared uint sA[64][32];       // 4sb × 8워드 배칭
shared float sAd4[64][4];
shared uint sB[64][32];
shared float sBd4[64][4];

// sdot4p 센티널 — OpSDot 치환 대상(미치환 시 무부호 오차 — 패처 실패 종료).
int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int t0 = int(tidy) * 64;
    int nt = int(min(64u, pc.t - uint(t0)));
    uint qw = uint(n_in >> 2);          // 행당 i8 워드수

    int sr = int(tid >> 2);             // 스테이징 행 (0..63)
    int lane = int(tid & 3u);           // 스테이징 레인 — 32워드 중 8워드 담당
    uint thread_r = tid >> 4;           // MMA 행 그룹
    uint thread_c = tid & 15u;          // MMA 열 그룹

    float sums[16];
    for (int i = 0; i < 16; i++) sums[i] = 0.0;

    for (int sb0 = 0; sb0 < n_sub; sb0 += 4) {
        int lim = min(4, n_sub - sb0);
        // ── A 스테이징(가중, q8r): 행 row0+sr.
        {
            int row = row0 + sr;
            if (row < row0 + nrow) {
                uint base = uint(row) * (qw + uint(n_sub));
                for (int j = 0; j < 8; j++) {
                    int w = lane * 8 + j;
                    sA[sr][w] = w < lim * 8
                        ? w0c[base + uint((sb0 + (w >> 3)) * 8 + (w & 7))]
                        : 0u;
                }
                if (lane == 0) {
                    for (int q = 0; q < 4; q++) {
                        sAd4[sr][q] = (sb0 + q) < n_sub
                            ? uintBitsToFloat(w0c[base + qw + uint(sb0 + q)])
                            : 0.0;
                    }
                }
            } else {
                for (int j = 0; j < 8; j++) sA[sr][lane * 8 + j] = 0u;
                if (lane == 0) {
                    for (int q = 0; q < 4; q++) sAd4[sr][q] = 0.0;
                }
            }
        }
        // ── B 스테이징(활성, xq): 토큰 t0+sr.
        {
            int rb = t0 + sr;
            if (rb < t0 + nt) {
                uint base = uint(rb) * pc.xq_w;
                for (int j = 0; j < 8; j++) {
                    int w = lane * 8 + j;
                    sB[sr][w] = w < lim * 8
                        ? xq[base + uint((sb0 + (w >> 3)) * 8 + (w & 7))]
                        : 0u;
                }
                if (lane == 0) {
                    for (int q = 0; q < 4; q++) {
                        sBd4[sr][q] = (sb0 + q) < n_sub
                            ? uintBitsToFloat(xq[base + qw + uint(sb0 + q)])
                            : 0.0;
                    }
                }
            } else {
                for (int j = 0; j < 8; j++) sB[sr][lane * 8 + j] = 0u;
                if (lane == 0) {
                    for (int q = 0; q < 4; q++) sBd4[sr][q] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: TM=4행 × TN=4열, 서브블록 승순(배칭과 무관 — 비트 동일).
        for (int q = 0; q < lim; q++) {
            float regAd[4], regBd[4];
            int regA[4][8], regB[4][8];
            for (int cr = 0; cr < 4; cr++) {
                int ar = int(thread_r * 4u + uint(cr));
                regAd[cr] = sAd4[ar][q];
                for (int p = 0; p < 8; p++) regA[cr][p] = int(sA[ar][q * 8 + p]);
            }
            for (int cc = 0; cc < 4; cc++) {
                int bc = int(thread_c * 4u + uint(cc));
                regBd[cc] = sBd4[bc][q];
                for (int p = 0; p < 8; p++) regB[cc][p] = int(sB[bc][q * 8 + p]);
            }
            for (int cr = 0; cr < 4; cr++) {
                for (int cc = 0; cc < 4; cc++) {
                    int qsum = 0;
                    for (int p = 0; p < 8; p++) {
                        qsum += sdot4p(uint(regA[cr][p]), uint(regB[cc][p]));
                    }
                    sums[cr * 4 + cc] += regAd[cr] * regBd[cc] * float(qsum);
                }
            }
        }
        barrier();
    }

    // ── 드레인: out[(t0+tc*4+c) * n_out + row0+tr*4+r].
    for (int cr = 0; cr < 4; cr++) {
        int ar = int(thread_r * 4u + uint(cr));
        if (ar >= nrow) break;
        for (int cc = 0; cc < 4; cc++) {
            int bc = int(thread_c * 4u + uint(cc));
            if (bc >= nt) break;
            outv[uint(t0 + bc) * pc.n_out + uint(row0 + ar)] = sums[cr * 4 + cc];
        }
    }
}
