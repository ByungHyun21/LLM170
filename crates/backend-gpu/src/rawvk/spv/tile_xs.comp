#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// tile_xs (plans/32) — iq4_xs 128행 타일. tile128_q5k 구조(512스레드=8sg×16행,
// coopmat f16, 토큰≤64)에 gemv4_xs의 iq4_xs 기하 적용. 프리필 전용(t≥16).
layout(local_size_x = 512) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xbuf { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Kbuf { uint ktab[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint xq_w; uint t; uint cw_log2; uint cw_mask;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0c[o];
    if (c == 1u) return w1c[o];
    if (c == 2u) return w2c[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4c[o];
    if (c == 5u) return w5c[o];
    if (c == 6u) return w6c[o];
    return w7c[o];
}

shared float16_t A16[128][36];  // 행 × 32k(+pad)
shared float16_t B16[64][36];   // 토큰 × 32k(+pad)
shared float Ctmp[128][65];     // 드레인
shared uint skt[256];           // iq4nl LUT

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;   // 0..511
    uint sg = gl_SubgroupID;            // 0..7
    for (uint i = tid; i < 256u; i += 512u) skt[i] = ktab[i];

    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int blocks = n_in >> 8;
    int row0 = int(bid) * 128;
    int nt = int(min(pc.t, 64u));
    int nrow = int(min(128u, pc.n_out - uint(row0)));

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc1 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc2 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc3 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (int sb = 0; sb < n_sub; sb++) {
        // A 스테이징(iq4_xs): 512스레드 → 128행 × 32k, 스레드당 8원소(4바이트 lo/hi 쌍)
        {
            int r = int(tid >> 2);              // 행 0..127
            int kc = int(tid & 3) * 8;          // k 오프셋 0/8/16/24
            int row = row0 + r;
            if (row < nrow + row0) {
                int ib = sb & 7;
                int rowb = row * blocks * 136 + (sb >> 3) * 136;
                uint wd = WG(uint(rowb >> 2));
                float d = unpackHalf2x16(wd >> uint((rowb & 3) * 8)).x;
                uint sh = (WG(uint((rowb + 2) >> 2)) >> uint(((rowb + 2) & 3) * 8)) & 0xFFFFu;
                if (((rowb + 2) & 3) == 3) {
                    uint w2 = WG(uint(((rowb + 2) >> 2) + 1));
                    sh = (sh & 0xFFu) | ((w2 & 0xFFu) << 8);
                }
                uint slw = WG(uint((rowb + 4 + (ib >> 1)) >> 2));
                uint slb = (slw >> uint(((rowb + 4 + (ib >> 1)) & 3) * 8)) & 0xFFu;
                int ls = int((slb >> uint(4 * (ib & 1))) & 0xFu) | (int((sh >> uint(2 * ib)) & 3u) << 4);
                float dl = d * float(ls - 32);
                // qs 16B @8+ib*16 — kc/8 = 워드 인덱스(0..3), 스레드당 2워드
                uint qb = uint(rowb + 8 + ib * 16) + uint(kc >> 2) * 4u;
                uint wva = WG(qb >> 2);
                uint rem = qb & 3u;
                if (rem != 0u) {
                    uint w2 = WG((qb >> 2) + 1u);
                    wva = (wva >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
                }
                uint qb2 = qb + 4u;
                uint wvb = WG(qb2 >> 2);
                rem = qb2 & 3u;
                if (rem != 0u) {
                    uint w2 = WG((qb2 >> 2) + 1u);
                    wvb = (wvb >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
                }
                for (int e = 0; e < 8; e++) {
                    int j = kc + e;               // qs 바이트 0..15 (lo열 원소 j, hi열 16+j)
                    uint wsel = ((j & 4) == 0) ? wva : wvb;
                    uint byte_v = (wsel >> uint((j & 3) * 8)) & 0xFFu;
                    uint t2 = skt[byte_v];
                    A16[r][j] = float16_t(float((int(t2 & 0xFFu) << 24) >> 24) * dl);
                    A16[r][16 + j] = float16_t(float((int(t2 >> 8u) << 24) >> 24) * dl);
                }
            } else {
                for (int e = 0; e < 8; e++) { A16[r][kc + e] = float16_t(0.0); A16[r][16 + kc + e] = float16_t(0.0); }
            }
        }
        // B 스테이징: tile128과 동일 (xq q8 → f16)
        {
            int fl = int(tid) * 4;
            int ti2 = fl >> 5;
            int k2 = fl & 31;
            if (ti2 < nt) {
                uint base = uint(ti2) * pc.xq_w;
                int xw = (sb << 5) >> 2;
                float yd = uintBitsToFloat(xq[base + uint((n_in >> 2) + sb)]);
                for (int e = 0; e < 4; e++) {
                    uint wv = xq[base + uint(xw + ((k2 + e) >> 2))];
                    int b = int((wv >> uint(((k2 + e) & 3) * 8)) & 0xFFu) << 24 >> 24;
                    B16[ti2][k2 + e] = float16_t(float(b) * yd);
                }
            } else if (ti2 < 64) {
                for (int e = 0; e < 4; e++) B16[ti2][k2 + e] = float16_t(0.0);
            }
        }
        barrier();
        for (int ks = 0; ks < 2; ks++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
            coopMatLoad(fa, A16[sg << 4], ks * 16, 36, gl_CooperativeMatrixLayoutRowMajor);
            if (nt > 0) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb0;
                coopMatLoad(fb0, B16[0], ks * 16, 36, gl_CooperativeMatrixLayoutColumnMajor);
                acc0 = coopMatMulAdd(fa, fb0, acc0);
            }
            if (nt > 16) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb1;
                coopMatLoad(fb1, B16[16], ks * 16, 36, gl_CooperativeMatrixLayoutColumnMajor);
                acc1 = coopMatMulAdd(fa, fb1, acc1);
            }
            if (nt > 32) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb2;
                coopMatLoad(fb2, B16[32], ks * 16, 36, gl_CooperativeMatrixLayoutColumnMajor);
                acc2 = coopMatMulAdd(fa, fb2, acc2);
            }
            if (nt > 48) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb3;
                coopMatLoad(fb3, B16[48], ks * 16, 36, gl_CooperativeMatrixLayoutColumnMajor);
                acc3 = coopMatMulAdd(fa, fb3, acc3);
            }
        }
        barrier();
    }
    // 드레인: 행(128) × 토큰(64) — tile128과 동일
    if (nt > 0) coopMatStore(acc0, Ctmp[sg << 4], 0, 65, gl_CooperativeMatrixLayoutRowMajor);
    if (nt > 16) coopMatStore(acc1, Ctmp[sg << 4], 16, 65, gl_CooperativeMatrixLayoutRowMajor);
    if (nt > 32) coopMatStore(acc2, Ctmp[sg << 4], 32, 65, gl_CooperativeMatrixLayoutRowMajor);
    if (nt > 48) coopMatStore(acc3, Ctmp[sg << 4], 48, 65, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (int i = int(tid); i < nrow * nt; i += 512) {
        int r = i / nt, c = i % nt;
        int row = row0 + r;
        if (row < nrow + row0) {
            outv[uint(c) * pc.n_out + uint(row)] = Ctmp[r][c];
        }
    }
}
