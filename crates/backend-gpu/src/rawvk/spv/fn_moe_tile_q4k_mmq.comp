#version 450

// fn_moe_tile_q4k_mmq v4 (plans/96 G3) — q4_K MoE MMQ, 블록 단위 스케일 캐싱.
// v3(614ms vs sg1 543)의 개선: 외부 루프를 256-블록으로 — 8 sb의
// (d·sc, dmin·m) 스케일과 qs 워드 64개를 블록당 1회 스테이징, 내부 8 MMA
// 라운드는 A 재스테이징 없이 진행(스케일 추출 ALU 1/8, A LDS 왕복 동일).
// 산술은 v3과 동일(dot_q4k_q8 구조, sb 승순). q51mmq 승리 기하(1-wave
// 64스레드 × 64가중행 × 16할당행) 유지. sdot4p→OpSDot. 직접산란 드레인.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][64];       // 블록 전체 8sb × 8워드
shared float sAd[64][8];
shared float sAm[64][8];
shared uint sB[16][8];
shared float sBd[16];
shared int sBw[16][8];

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_blk = n_in >> 8;
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];
    int nt = int(min(16u, rp - uint(r0e)));
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int tr = int(tid);
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    for (int blk = 0; blk < n_blk; blk++) {
        // ── A: 블록 전체(8sb) 1회 스테이징 — 스케일 추출 포함.
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint wq = ebase + uint(row) * row_words + uint(blk) * 36u;
                float d = f16_exact(w0c[wq] & 0xFFFFu);
                float dmin = f16_exact(w0c[wq] >> 16);
                for (int j = 0; j < 8; j++) {
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq, j) & 63u;
                        m_v = sbyte(wq, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq, j) >> 6) << 4);
                    }
                    sAd[tr][j] = d * float(s_v);
                    sAm[tr][j] = dmin * float(m_v);
                    uint qbase = wq + 4u + uint((j >> 1) * 8);
                    bool hi = (j & 1) != 0;
                    for (int p = 0; p < 8; p++) {
                        uint w = w0c[qbase + uint(p)];
                        sA[tr][j * 8 + p] = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                    }
                }
            } else {
                for (int j = 0; j < 8; j++) {
                    sAd[tr][j] = 0.0; sAm[tr][j] = 0.0;
                    for (int p = 0; p < 8; p++) sA[tr][j * 8 + p] = 0u;
                }
            }
        }
        // ── 내부 8 sb 라운드: B만 재스테이징.
        for (int j = 0; j < 8; j++) {
            int sb = blk * 8 + j;
            {
                for (int i = int(tid); i < 16 * 8; i += 64) {
                    int rb = i >> 3;
                    int p = i & 7;
                    if (rb < nt) {
                        uint pr_ = perm_pad[uint(r0e + rb)];
                        uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                        uint wv = xq[base + uint(sb * 8 + p)];
                        sB[rb][p] = wv;
                        int ws = int(wv);
                        sBw[rb][p] = ((ws << 24) >> 24) + ((ws << 16) >> 24)
                                   + ((ws << 8) >> 24) + (ws >> 24);
                        if (p == 0) {
                            sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                        }
                    } else {
                        sB[rb][p] = 0u;
                        sBw[rb][p] = 0;
                        if (p == 0) sBd[rb] = 0.0;
                    }
                }
            }
            memoryBarrierShared();
            barrier();
            {
                int ra0 = j * 8;
                float ad = sAd[tr][j], am = sAm[tr][j];
                for (int c = 0; c < 16; c++) {
                    int qsum = 0;
                    for (int p = 0; p < 8; p++) {
                        qsum += sdot4p(sA[tr][ra0 + p], sB[c][p]);
                    }
                    int bs = sBw[c][0] + sBw[c][1] + sBw[c][2] + sBw[c][3]
                           + sBw[c][4] + sBw[c][5] + sBw[c][6] + sBw[c][7];
                    acc[c] += sBd[c] * (ad * float(qsum) - am * float(bs));
                }
            }
            barrier();
        }
    }

    // ── 드레인: 직접산란.
    if (tr < nrow) {
        for (int c = 0; c < 16; c++) {
            if (c < nt) {
                uint pr2 = perm_pad[uint(r0e + c)];
                if (pr2 != 0xFFFFFFFFu) {
                    outv[pr2 * pc.n_out + uint(row0 + tr)] = acc[c];
                }
            }
        }
    }
}
