#version 450

// fn_moe_tile_q4k_mmq v5 (plans/96) — v3 기하 + 라이브-행 MMA 스킵 — 1-wave 기하 실험.
// v2(256스레드·2배리어/sb)의 4경로 부정 후 마지막 미시험 축: **64스레드
// = wave64 1개** — 웨이브 간 배리어 소거, BK_STEP=4(배리어 1회/4sb).
// 타일 64가중행 × 16할당행(16행 밴드 = moe_group 균일-전문가 단위 유지).
// 스레드 = 가중행 1개 × 16열. 산술 계약은 v2와 동일(dot_q4k_q8 구조,
// sb 승순·정수 exact) — 게이트/체커 판정은 v2 전례와 동일 기대.
// A는 LDS 협동 스테이징(코얼레스), B는 LDS + Σb 바이트합.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][36];        // 4sb×8워드 + 상위 4칸은 스케일 팩 공간 재사용
shared float sAd[64][4];
shared float sAm[64][4];
shared uint sB[16][32];
shared float sBd[16][4];
shared float sBsum[16][4]; // plans/96: quant 사전계산합 판독 — sBw 폐지
shared int sLive;         // plans/96 v5: 밴드 실제 행 수

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

// sdot4p 센티널 — OpSDot 치환(패처 실패 시 종료).
int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

// 블록 워드 wq의 scales 12B에서 i번째 바이트.
uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;   // 16행 밴드
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];
    int nt = int(min(16u, rp - uint(r0e)));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int tr = int(tid);             // 가중행 = 스레드
    float acc[16];
    for (int c = 0; c < 16; c++) acc[c] = 0.0;

    // plans/96: 밴드 실제 행 수(루프 불변) — 1회 계산.
    int live_cnt = 0;
    for (int q2 = 0; q2 < 16; q2++) {
        if (r0e + q2 < int(rp) && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
    }
    sLive = live_cnt;
    barrier();

    for (int sb0 = 0; sb0 < n_sub; sb0 += 4) {
        int lim = min(4, n_sub - sb0);
        // ── A 스테이징: 64행 × 4sb — 스레드 tr이 자기 행 4블록 분량 담당.
        {
            int row = row0 + tr;
            if (row < row0 + nrow) {
                uint wq4 = ebase + uint(row) * row_words + uint(sb0 >> 3) * 36u;
                for (int q = 0; q < lim; q++) {
                    int sb = sb0 + q;
                    uint wq = wq4; // (sb>>3)==(sb0>>3) 성립: 4|블록경계(8)
                    float d = f16_exact(w0c[wq] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq] >> 16);
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq, j) & 63u;
                        m_v = sbyte(wq, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq, j) >> 6) << 4);
                    }
                    sAd[tr][q] = d * float(s_v);
                    sAm[tr][q] = dmin * float(m_v);
                    uint qbase = wq + 4u + uint(((sb & 7) >> 1) * 8);
                    bool hi = (sb & 1) != 0;
                    for (int p = 0; p < 8; p++) {
                        uint w = w0c[qbase + uint(p)];
                        sA[tr][q * 8 + p] = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                    }
                }
            } else {
                for (int q = 0; q < 4; q++) {
                    sAd[tr][q] = 0.0; sAm[tr][q] = 0.0;
                    for (int p = 0; p < 8; p++) sA[tr][q * 8 + p] = 0u;
                }
            }
        }
        // ── B 스테이징: 16행 × 4sb — 스레드 0..63이 워드 분담(16×32=512).
        {
            for (int i = int(tid); i < live_cnt * 32; i += 64) {  // plans/96: 실제 행만 스테이징
                int rb = i >> 5;
                int w = i & 31;
                int q = w >> 3;
                int p = w & 7;
                int sb = sb0 + q;
                if (rb < nt && q < lim) {
                    uint pr_ = perm_pad[uint(r0e + rb)];
                    uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                    sB[rb][w] = xq[base + uint(sb * 8 + p)];
                    if (p == 0) {
                        sBd[rb][q] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                        uint qsb = qw + (uint(n_in) >> 5);
                        sBsum[rb][q] = float(int(xq[base + qsb + uint(sb * 2)])
                                          + int(xq[base + qsb + uint(sb * 2) + 1u]));
                    }
                } else {
                    sB[rb][w] = 0u;
                    if (p == 0) { sBd[rb][q] = 0.0; sBsum[rb][q] = 0.0; }
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 스레드 tr — 자기 가중행 × 16열, sb 승순.
        for (int q = 0; q < lim; q++) {
            int ra[8];
            for (int p = 0; p < 8; p++) ra[p] = int(sA[tr][q * 8 + p]);
            float ad = sAd[tr][q], am = sAm[tr][q];
            for (int c = 0; c < live_cnt; c++) {  // plans/96 v5: 실제 행만 MMA
                // plans/96: B 워드 레지스터 선적재(8 로드 병렬 발사) 후 트리.
                uint bw0 = sB[c][q * 8], bw1 = sB[c][q * 8 + 1];
                uint bw2 = sB[c][q * 8 + 2], bw3 = sB[c][q * 8 + 3];
                uint bw4 = sB[c][q * 8 + 4], bw5 = sB[c][q * 8 + 5];
                uint bw6 = sB[c][q * 8 + 6], bw7 = sB[c][q * 8 + 7];
                int t0 = sdot4p(uint(ra[0]), bw0) + sdot4p(uint(ra[4]), bw4);
                int t1 = sdot4p(uint(ra[1]), bw1) + sdot4p(uint(ra[5]), bw5);
                int t2 = sdot4p(uint(ra[2]), bw2) + sdot4p(uint(ra[6]), bw6);
                int t3 = sdot4p(uint(ra[3]), bw3) + sdot4p(uint(ra[7]), bw7);
                int qsum = (t0 + t1) + (t2 + t3);
                acc[c] += sBd[c][q] * (ad * float(qsum) - am * sBsum[c][q]);
            }
        }
        barrier();
    }

    // ── 드레인: 직접산란(G2 계약 — 원본 행 위치, 센티널 가드).
    if (tr < nrow) {
        for (int c = 0; c < nt; c++) {
            uint pr2 = perm_pad[uint(r0e + c)];
            if (pr2 != 0xFFFFFFFFu) {
                outv[pr2 * pc.n_out + uint(row0 + tr)] = acc[c];
            }
        }
    }
}
