#version 450
#extension GL_ARB_gpu_shader_int64 : enable

// fn_moe_tile_q4k_mmq v2 (plans/95 P2) — llama mul_mmq식 q4_K MoE 타일.
// 타일 = 64 가중행(BM) × 16 할당행(BN). BN=16은 moe_group의 균일-전문가
// 패딩 단위(sg1 계열과 동일) — 밴드 내 전문가 혼합이 없다.
//
// 산술 계약 — core quant.rs dot_q4k_q8 과 동일 구조(정수부 exact):
//   w = d·sc·nib − dmin·m (nib 무부호 원시 0..15)
//   out = Σ_sb yd·( (d·sc)·Σ(nib·b) − (dmin·m)·Σb ), sb 승순 f32 누산.
// 스테이징: 서브블록(32원소)의 패킹워드 p(니블 4개)는 qs 워드 1개와 정확히
// 대응 — A는 워드당 로드 1회 + 마스크(lo: W&0x0F0F0F0F, hi: (W>>4)&0x0F…),
// B(q8)은 워드 직접 팩(재패킹 0). 스케일 인덱스·qs 오프셋은 블록 로컬.
// int8 내적은 sdot4p 센티널 → patch_sdot.py가 OpSDot로 이진 치환
// (시스템 glslc 미지원, 원장 plans/33).
// 스레드 256: 스테이징 A(64행×4레인) / B(16행×8레인), MMA tr=tid>>2·tc=tid&3
// (각 1가중행 × 4할당열).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared uint sA[64][8];        // 패킹 니블 워드 (바이트=0..15)
shared float sAd[64];         // d·sc
shared float sAm[64];         // dmin·m
shared uint sB[16][8];        // q8 패킹 워드 (그대로)
shared float sBd[16];         // 활성 q8 스케일 yd
shared int sBw[16][8];        // 워드별 바이트합 (Σb 분해)

float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

// sdot4p 센티널 — spirv-dis 텍스트에서 OpSDot(packed i8x4)로 치환된다.
// 미치환 시 상위바이트 무부호 오차(패처가 치환수 0이면 실패 종료).
int sdot4p(uint a, uint b) {
    int p0 = int(a & 0xFFu) * int(b & 0xFFu);
    int p1 = int((a >> 8) & 0xFFu) * int((b >> 8) & 0xFFu);
    int p2 = int((a >> 16) & 0xFFu) * int((b >> 16) & 0xFFu);
    int p3 = int(a >> 24) * int(b >> 24);
    return (p0 + p1) + (p2 + p3);
}

// 블록 워드 wq의 scales 12B(워드 wq+1..3)에서 i번째 바이트.
uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;   // 16행 밴드
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 64;
    int nrow = int(min(64u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;
    uint e = rowexp[uint(r0e)];     // 밴드 균일 전문가(16행 패딩 보증)
    int nt = int(min(16u, rp - uint(r0e)));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);

    int sr = int(tid >> 2);         // A: 64 가중행
    int lane = int(tid & 3u);       // A: 워드 레인(2개씩)
    int tr = int(tid >> 2);         // MMA: 가중행
    int tc = int(tid & 3u);         // MMA: 할당열 그룹(4열씩)

    float sums[4];
    for (int i = 0; i < 4; i++) sums[i] = 0.0;

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A: q4_K → 패킹 니블 + 스케일.
        {
            int row = row0 + sr;
            if (row < row0 + nrow) {
                uint wq = ebase + uint(row) * row_words + uint(sb >> 3) * 36u;
                if (lane == 0) {
                    float d = f16_exact(w0c[wq] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq] >> 16);
                    // 스케일 인덱스·조합은 블록 로컬 j = sb&7.
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq, j) & 63u;
                        m_v = sbyte(wq, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq, j) >> 6) << 4);
                    }
                    sAd[sr] = d * float(s_v);
                    sAm[sr] = dmin * float(m_v);
                }
                uint qbase = wq + 4u + uint(((sb & 7) >> 1) * 8);
                bool hi = (sb & 1) != 0;
                for (int k = 0; k < 2; k++) {
                    uint p = uint(lane * 2 + k);
                    uint w = w0c[qbase + p];
                    sA[sr][lane * 2 + k] = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                }
            } else {
                if (lane == 0) { sAd[sr] = 0.0; sAm[sr] = 0.0; }
                for (int k = 0; k < 2; k++) sA[sr][lane * 2 + k] = 0u;
            }
        }
        // ── B: q8 활성 16행 — tid<128이 워드 1개씩(16행×8워드).
        {
            if (tid < 128u) {
                int rb = int(tid >> 3);
                int wl = int(tid & 7u);
                if (rb < nt) {
                    uint base = perm_pad[uint(r0e + rb)] * pc.xq_w;
                    uint w = xq[base + uint(sb * 8 + wl)];
                    sB[rb][wl] = w;
                    int ws = int(w);
                    sBw[rb][wl] = ((ws << 24) >> 24) + ((ws << 16) >> 24)
                                + ((ws << 8) >> 24) + (ws >> 24);
                    if (wl == 0) {
                        sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    }
                } else {
                    sB[rb][wl] = 0u;
                    sBw[rb][wl] = 0;
                    if (wl == 0) sBd[rb] = 0.0;
                }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 각 스레드 1가중행 × 4할당열(tr, tc*4+c).
        {
            float ad = sAd[tr], am = sAm[tr];
            int ra[8];
            for (int p = 0; p < 8; p++) ra[p] = int(sA[tr][p]);
            for (int c = 0; c < 4; c++) {
                int bc = tc * 4 + c;
                float bd = sBd[bc], bs = 0.0;
                int rb8[8];
                for (int p = 0; p < 8; p++) {
                    rb8[p] = int(sB[bc][p]);
                    bs += float(sBw[bc][p]);
                }
                int qsum = 0;
                for (int p = 0; p < 8; p++) {
                    qsum += sdot4p(uint(ra[p]), uint(rb8[p]));
                }
                sums[c] += bd * (ad * float(qsum) - am * bs);
            }
        }
        barrier();
    }

    // ── 드레인: (row0+tr, r0e+tc*4+c).
    if (tr < nrow) {
        for (int c = 0; c < 4; c++) {
            int bc = tc * 4 + c;
            if (bc < nt) {
                outv[uint(r0e + bc) * pc.n_out + uint(row0 + tr)] = sums[c];
            }
        }
    }
}
