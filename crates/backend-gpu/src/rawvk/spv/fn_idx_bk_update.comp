#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
// plans/84 B — FN QSA 인덱서 블록키 갱신(hip q4_idx_bk_update 동일열,
// idx_dim=128). 32스레드 = 블록 1개: r행 평균 → rms(f64 합) → 가중 →
// 로프(cs 표). 짝 교환은 shared 메모리(hip shfl_xor(16) 상동).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer Ik { float idxk[]; };
layout(binding = 1) buffer Bk { float bk[]; };
layout(binding = 2) readonly buffer Iw { float ikw[]; };
layout(binding = 3) readonly buffer Cs { float cs[]; };
layout(push_constant) uniform PC {
    float eps; uint b0; uint r; uint idx_dim;
} pc;
shared float sh_nm[32][4];
shared float sh_part[32];
void main() {
    uint b = pc.b0 + gl_WorkGroupID.x;
    uint u = gl_LocalInvocationID.x;
    if (u >= 32u || pc.idx_dim != 128u) return;
    float pv0 = 0.0, pv1 = 0.0, pv2 = 0.0, pv3 = 0.0;
    for (uint j = 0u; j < pc.r; j++) {
        uint row = (b * pc.r + j) * pc.idx_dim;
        pv0 += idxk[row + u * 4u + 0u];
        pv1 += idxk[row + u * 4u + 1u];
        pv2 += idxk[row + u * 4u + 2u];
        pv3 += idxk[row + u * 4u + 3u];
    }
    pv0 /= float(pc.r); pv1 /= float(pc.r); pv2 /= float(pc.r); pv3 /= float(pc.r);
    float mypart = pv0 * pv0 + pv1 * pv1 + pv2 * pv2 + pv3 * pv3;
    sh_part[u] = mypart;
    barrier();
    double sum = 0.0lf;
    for (int uu = 0; uu < 32; uu++) sum += double(sh_part[uu]);   // hip f64 순차합 동일열
    float scale = 1.0 / float(sqrt(sum / double(pc.idx_dim) + double(pc.eps)));
    sh_nm[u][0] = pv0 * scale * ikw[u * 4u + 0u];
    sh_nm[u][1] = pv1 * scale * ikw[u * 4u + 1u];
    sh_nm[u][2] = pv2 * scale * ikw[u * 4u + 2u];
    sh_nm[u][3] = pv3 * scale * ikw[u * 4u + 3u];
    barrier();
    uint half_ = pc.idx_dim >> 1u;
    uint pos = b * pc.r;
    uint csbase = pos * half_ * 2u;
    uint o0 = b * pc.idx_dim;
    for (uint k = 0u; k < 4u; k++) {
        uint i = u * 4u + k;
        float other = sh_nm[(u + 16u) % 32u][k];   // hip shfl_xor(16) 짝
        uint p = (i < half_) ? i : (i - half_);
        float c = cs[csbase + p * 2u];
        float sf = cs[csbase + p * 2u + 1u];
        if (i < half_) {
            bk[o0 + i] = sh_nm[u][k] * c - other * sf;
        } else {
            bk[o0 + i] = other * sf + sh_nm[u][k] * c;
        }
    }
}
