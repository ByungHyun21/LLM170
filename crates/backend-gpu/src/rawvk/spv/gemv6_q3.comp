#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// gemv6_q3 (plans/33) — llama iqs lane 리맵 q3_K. 블록 110B:
// hm 32B@0, q 64B@32(2비트×4), scales 12B@96(aux전개), d f16@108.
// q 바이트 qb: n=qb>>5, r=qb&31, half=r&16, l=r&15 — j(0..3)마다 원소
// e = 128n+32j+half+l, qv=(qb>>2j)&3, sub=(hm[r]>>j)&1?0:4, sc=8n+2j+(half?1:0).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3c[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

const uint BLK_B = 110u;
shared float sh_dl[96][16];
shared uint sh_hm[96][8];   // hm 32B = 8워드 (워드 어셈블)

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_blk = n_in >> 8;
    uint base = tok * n_in;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;

    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        uint rowb = row * n_blk * BLK_B;
        // 패스1: d/scales → LDS, hm 8워드 → LDS
        for (uint b = tid; b < n_blk; b += 32u) {
            uint bw = rowb + b * BLK_B;
            // d @108 — (bw+108)%4 = (rowb%4 + 0)%4 (108%4=0)
            uint dwi = (bw + 108u) >> 2;
            uint drem = (bw + 108u) & 3u;
            uint dw = WG(dwi);
            uint db = (dw >> (drem * 8u)) & 0xFFFFu;
            if (drem >= 2u) {
                uint w2 = WG(dwi + 1u);
                db = ((dw >> (drem * 8u)) | (w2 << ((4u - drem) * 8u))) & 0xFFFFu;
            }
            float d = unpackHalf2x16(db).x;
            // scales 12B @96 → aux 3워드 (리틀엔디 96비트)
            uint aux0, aux1, aux2;
            {
                uint sbase = bw + 96u;
                uint wq = sbase >> 2;
                uint rr = sbase & 3u;
                uint wa = WG(wq), wb2 = WG(wq + 1u), wc2 = WG(wq + 2u);
                aux0 = (wa >> (rr * 8u)) | (rr != 0u ? (wb2 << ((4u - rr) * 8u)) : 0u);
                aux1 = (rr == 0u) ? wb2 : ((wb2 >> (rr * 8u)) | (wc2 << ((4u - rr) * 8u)));
                uint aux2t = (rr == 0u) ? wc2 : ((wc2 >> (rr * 8u)) | (WG(wq + 3u) << ((4u - rr) * 8u)));
                aux2 = aux2t & 0xFFFu;   // 하위 12비트 (총 96비트)
            }
            uint kmask1 = 0x03030303u, kmask2 = 0x0f0f0f0fu;
            uint ax2 = ((aux0 >> 4) & kmask2) | (((aux2 >> 4) & kmask1) << 4);
            uint ax3 = ((aux1 >> 4) & kmask2) | (((aux2 >> 6) & kmask1) << 4);
            uint aa0 = (aux0 & kmask2) | ((aux2 & kmask1) << 4);
            uint aa1 = (aux1 & kmask2) | (((aux2 >> 2) & kmask1) << 4);
            // 스케일 16개 → LDS (d·(sc-32))
            for (uint j = 0u; j < 16u; j++) {
                uint sw = j < 4u ? aa0 : (j < 8u ? aa1 : (j < 12u ? ax2 : ax3));
                uint sc8 = (sw >> (8u * (j & 3u))) & 0xFFu;
                int sci = int(sc8) << 24 >> 24;   // 산술 시프트 (gemv6_q6 교훈)
                sh_dl[b][j] = d * float(sci - 32);
            }
            // hm 8워드 (32B @0 — 블록 시작, rem=rowb&3)
            uint hq = bw >> 2;
            uint hr = bw & 3u;
            if (hr == 0u) {
                for (uint i = 0u; i < 8u; i++) sh_hm[b][i] = WG(hq + i);
            } else {
                uint prev = WG(hq);
                for (uint i = 0u; i < 8u; i++) {
                    uint nx = WG(hq + 1u + i);
                    sh_hm[b][i] = (prev >> (hr * 8u)) | (nx << ((4u - hr) * 8u));
                    prev = nx;
                }
            }
        }
        barrier();
        // 패스2: q 64B 선형 스윕 — 레인 L<16이 워드 (rowb>>2)+8+L (q@32)
        float pacc = 0.0;
        for (uint b = 0u; b < n_blk; b++) {
            uint bw = rowb + b * BLK_B;
            if (tid < 16u) {
                uint lw = (bw >> 2) + 8u + tid;   // q 워드 (rem 보정은 아래)
                uint lrem = (bw + 32u) & 3u;
                uint wv = WG(lw);
                if (lrem != 0u) {
                    uint nx = WG(lw + 1u);
                    wv = (wv >> (lrem * 8u)) | (nx << ((4u - lrem) * 8u));
                }
                for (uint k = 0u; k < 4u; k++) {
                    uint qb = tid * 4u + k;       // q 바이트 0..63
                    uint n = qb >> 5;
                    uint rr = qb & 31u;
                    uint hf = (rr & 16u);
                    uint l = rr & 15u;
                    uint byte_v = (wv >> (8u * k)) & 0xFFu;
                    uint hmb = (sh_hm[b][rr >> 2] >> (8u * (rr & 3u))) & 0xFFu;
                    for (uint j = 0u; j < 4u; j++) {
                        uint e = b * 256u + n * 128u + j * 32u + hf + l;
                        int qv = int((byte_v >> (2u * j)) & 3u);
                        int sub = ((hmb >> j) & 1u) != 0u ? 0 : 4;
                        pacc += sh_dl[b][n * 8u + j * 2u + (hf != 0u ? 1u : 0u)]
                              * float(qv - sub) * xa[base + e];
                    }
                }
            }
        }
        acc[r] = pacc;
        barrier();
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
