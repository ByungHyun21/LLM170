#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
// plans/84 B — FN GDN AR (hip gdn_ar_w_swap 동일열): 전치 상태
// s[pair·d·d + u·d + lane·4+j], grid (d, h_v), 32레인 = kdim 4개/레인,
// 토큰 순차 재귀(상태 레지스터 유지 → 청크 경계에서 이어짐).
// q는 1/√d 스케일 완료 가정(scale=1.0).
// plans/96: 다음 토큰 k/q/v/βg 프리페치 — 리덕션 셔플이 로드 레이턴시
// 를 덮는 회전 파이프라인(실측 3.5µs/tok = 로드 레이턴시 바운드).
layout(local_size_x = 32) in;
layout(binding = 0) buffer S { float s[]; };
layout(binding = 1) readonly buffer Q { float q[]; };
layout(binding = 2) readonly buffer K { float k[]; };
layout(binding = 3) readonly buffer V { float v[]; };
layout(binding = 4) readonly buffer Bg { float bg[]; };   // [t][hv*2] (β,e^g)
layout(binding = 5) buffer O { float o[]; };
layout(push_constant) uniform PC {
    int d; int ks; int vs; int hv; int hk; float scale; int t;
} pc;
void main() {
    int ub = int(gl_WorkGroupID.x) * 2;      // plans/99 u폴딩×2: 로드 절반·ILP 2배
    int u = ub;
    int pair = int(gl_WorkGroupID.y);
    int lane = int(gl_SubgroupInvocationID) & 31;   // 서브그룹 하위 32레인 사용
    int base_s = pair * pc.d * pc.d;
    float ssr0 = s[base_s + pc.d * ub + ((lane << 2) + 0)];
    float ssr1 = s[base_s + pc.d * ub + ((lane << 2) + 1)];
    float ssr2 = s[base_s + pc.d * ub + ((lane << 2) + 2)];
    float ssr3 = s[base_s + pc.d * ub + ((lane << 2) + 3)];
    float tssr0 = s[base_s + pc.d * (ub + 1) + ((lane << 2) + 0)];
    float tssr1 = s[base_s + pc.d * (ub + 1) + ((lane << 2) + 1)];
    float tssr2 = s[base_s + pc.d * (ub + 1) + ((lane << 2) + 2)];
    float tssr3 = s[base_s + pc.d * (ub + 1) + ((lane << 2) + 3)];
    int h = pair % pc.hv;
    int kh = h % pc.hk;
    // 토큰 0·1 선로드(2심층 회전) — vec4 팩킹(로드 11→5, plans/99).
    int ad = (lane << 2);
    vec4 Kv = vec4(k[pc.ks * 0 + kh * pc.d + ad], k[pc.ks * 0 + kh * pc.d + ad + 1],
                   k[pc.ks * 0 + kh * pc.d + ad + 2], k[pc.ks * 0 + kh * pc.d + ad + 3]);
    vec4 Qv = vec4(q[pc.ks * 0 + kh * pc.d + ad], q[pc.ks * 0 + kh * pc.d + ad + 1],
                   q[pc.ks * 0 + kh * pc.d + ad + 2], q[pc.ks * 0 + kh * pc.d + ad + 3]);
    float Vv = v[pc.vs * 0 + pc.d * pair + ub];
    float Vv2 = v[pc.vs * 0 + pc.d * pair + ub + 1];
    float Be = bg[pc.hv * 2 * 0 + pair * 2];
    float Ge = bg[pc.hv * 2 * 0 + pair * 2 + 1];
    vec4 nKv = vec4(0.0); vec4 nQv = vec4(0.0);
    float nV = 0.0, nV2 = 0.0, nB = 0.0, nG = 0.0;
    if (1 < pc.t) {
        int qk1 = pc.ks * 1 + kh * pc.d + ad;
        nKv = vec4(k[qk1], k[qk1 + 1], k[qk1 + 2], k[qk1 + 3]);
        nQv = vec4(q[qk1], q[qk1 + 1], q[qk1 + 2], q[qk1 + 3]);
        nV = v[pc.vs * 1 + pc.d * pair + ub];
        nV2 = v[pc.vs * 1 + pc.d * pair + ub + 1];
        nB = bg[pc.hv * 2 * 1 + pair * 2];
        nG = bg[pc.hv * 2 * 1 + pair * 2 + 1];
    }
    for (int ti = 0; ti < pc.t; ti++) {
        // 토큰 ti+2 조기 프리페치(vec4) — 계산 2토큰분의 레이턴시 폭.
        int tn = ti + 2;
        bool more = tn < pc.t;
        int qk2 = pc.ks * tn + kh * pc.d + ad;
        vec4 pKv = more ? vec4(k[qk2], k[qk2 + 1], k[qk2 + 2], k[qk2 + 3]) : vec4(0.0);
        vec4 pQv = more ? vec4(q[qk2], q[qk2 + 1], q[qk2 + 2], q[qk2 + 3]) : vec4(0.0);
        float pV = more ? v[pc.vs * tn + pc.d * pair + ub] : 0.0;
        float pV2 = more ? v[pc.vs * tn + pc.d * pair + ub + 1] : 0.0;
        float pB = more ? bg[pc.hv * 2 * tn + pair * 2] : 0.0;
        float pG = more ? bg[pc.hv * 2 * tn + pair * 2 + 1] : 0.0;
        // u-체인(산술 원본 동일).
        ssr0 *= Ge; ssr1 *= Ge; ssr2 *= Ge; ssr3 *= Ge;
        float part = ssr0 * Kv.x + ssr1 * Kv.y + ssr2 * Kv.z + ssr3 * Kv.w;
        float sk = part;
        for (int off = 1; off < 32; off <<= 1) {
            float pj = subgroupShuffleXor(sk, off);
            sk += pj;
        }
        float delta = (Vv - sk) * Be;
        ssr0 += Kv.x * delta; ssr1 += Kv.y * delta; ssr2 += Kv.z * delta; ssr3 += Kv.w * delta;
        float op = ssr0 * Qv.x + ssr1 * Qv.y + ssr2 * Qv.z + ssr3 * Qv.w;
        float otot = op;
        for (int off = 1; off < 32; off <<= 1) {
            float pj = subgroupShuffleXor(otot, off);
            otot += pj;
        }
        if (lane == 0) o[pc.vs * ti + pc.d * pair + ub] = otot * pc.scale;
        // u+1-체인(로드 재사용 — ILP).
        tssr0 *= Ge; tssr1 *= Ge; tssr2 *= Ge; tssr3 *= Ge;
        float part2 = tssr0 * Kv.x + tssr1 * Kv.y + tssr2 * Kv.z + tssr3 * Kv.w;
        float sk2 = part2;
        for (int off = 1; off < 32; off <<= 1) {
            float pj = subgroupShuffleXor(sk2, off);
            sk2 += pj;
        }
        float delta2 = (Vv2 - sk2) * Be;
        tssr0 += Kv.x * delta2; tssr1 += Kv.y * delta2; tssr2 += Kv.z * delta2; tssr3 += Kv.w * delta2;
        float op2 = tssr0 * Qv.x + tssr1 * Qv.y + tssr2 * Qv.z + tssr3 * Qv.w;
        float otot2 = op2;
        for (int off = 1; off < 32; off <<= 1) {
            float pj = subgroupShuffleXor(otot2, off);
            otot2 += pj;
        }
        if (lane == 0) o[pc.vs * ti + pc.d * pair + ub + 1] = otot2 * pc.scale;
        // 이중 회전: cur ← depth1, depth1 ← depth2(신규).
        Kv = nKv; Qv = nQv;
        Vv = nV; Vv2 = nV2; Be = nB; Ge = nG;
        nKv = pKv; nQv = pQv;
        nV = pV; nV2 = pV2; nB = pB; nG = pG;
    }
    s[base_s + pc.d * ub + ((lane << 2) + 0)] = ssr0;
    s[base_s + pc.d * ub + ((lane << 2) + 1)] = ssr1;
    s[base_s + pc.d * ub + ((lane << 2) + 2)] = ssr2;
    s[base_s + pc.d * ub + ((lane << 2) + 3)] = ssr3;
    s[base_s + pc.d * (ub + 1) + ((lane << 2) + 0)] = tssr0;
    s[base_s + pc.d * (ub + 1) + ((lane << 2) + 1)] = tssr1;
    s[base_s + pc.d * (ub + 1) + ((lane << 2) + 2)] = tssr2;
    s[base_s + pc.d * (ub + 1) + ((lane << 2) + 3)] = tssr3;
}
