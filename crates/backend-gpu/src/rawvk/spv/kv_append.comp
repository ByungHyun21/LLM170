#version 450
// kv_append (plans/19 + plans/20 t행 확장) — rawhip kv_append_t 미러.
// grid (n/64, t): y=행 — dst[(pos0+y)*n + j] = src[y*n + j].
// t=1 (gy=1): 기존 산술과 동일.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Src { float src[]; };
layout(binding = 1) buffer Dst { float dst[]; };
layout(push_constant) uniform PC { int n; int pos0; } pc;
void main() {
    int j = int(gl_GlobalInvocationID.x);
    if (j >= pc.n) return;
    int row = int(gl_WorkGroupID.y);
    dst[(pc.pos0 + row) * pc.n + j] = src[row * pc.n + j];
}
