#version 450
#extension GL_ARB_gpu_shader_int64 : enable

// MoE 그룹 타일 GEMM — q5_1 (plans/88 P2). 패딩 도메인(rowexp) 16×16타일 +
// 공유 스테이징(16행 × n_sub×6워드). 행별 산술은 hip q4_gemm_q5_1_w_ids와
// 동일 표현식(dot4 정수, 서브블록 f32 직렬, 합은 스레드 내 sIdx 오름차순).
// 게이트: n_in ≤ 2048 (shared 16×384워드 = 24KB).
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };    // 원본 행 도메인(간접)
layout(binding = 9) buffer Yg { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; }; // 패딩→원본 행
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;
// mode=0: MoE 패딩 도메인(rowexp 전문가·perm_pad 간접 x). mode=1: 밀집 직접
// (전문가 0, x행 = r 그대로) — 프리필 밀집 GEMV(gemv3 t-루프, 실측 ~5GB/s)의
// 타일 대체. rows 상한은 mode1에서 n_out 타일 y그리드가 t/16.

uint Wsel(uint c, uint o) {
    if (c == 0u) return w0c[o];
    if (c == 1u) return w1c[o];
    if (c == 2u) return w2c[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4c[o];
    if (c == 5u) return w5c[o];
    if (c == 6u) return w6c[o];
    return w7c[o];
}

int dot4(uint a, uint b, int c) {
    int r = c;
    for (int i = 0; i < 4; i++) {
        int av = (int((a >> (8u * uint(i))) & 0xFFu) << 24) >> 24;
        int bv = (int((b >> (8u * uint(i))) & 0xFFu) << 24) >> 24;
        r += av * bv;
    }
    return r;
}

// 타일 16출력행 분량 — n_in ≤ 2048 기준 16×384워드 = 24KB.
shared uint sh[16 * 384];

void main() {
    int ox = int(gl_LocalInvocationID.x);
    int rx = int(gl_LocalInvocationID.y);
    int o = int(gl_WorkGroupID.x) * 16 + ox;
    uint r0 = gl_WorkGroupID.y * 16u;
    uint rp = pc.mode == 1u ? pc.rows : rows_pad[0];
    uint n_in = pc.n_in;
    uint n_sub = n_in >> 5;
    uint row_words = n_sub * 6u;
    int tid = int(gl_LocalInvocationID.y * 16u + gl_LocalInvocationID.x);
    if (r0 >= rp) return;   // 블록 균일 조기탈출
    uint e = rowexp[r0];
    for (uint row = 0u; row < 16u; row++) {
        uint orow = gl_WorkGroupID.x * 16u + row;
        if (orow >= pc.n_out) break;
        uint64_t wbase = uint64_t(e) * uint64_t(pc.per_expert_bytes)
                       + uint64_t(orow) * uint64_t(row_words) * 4u;
        uint w0 = uint(wbase >> 2);
        uint c0 = w0 / pc.chunk_words;
        uint lim = (c0 + 1u) * pc.chunk_words;
        uint srow = row * row_words;
        for (uint col = uint(tid); col < row_words; col += 256u) {
            uint wi = w0 + col;
            sh[srow + col] = wi < lim
                ? Wsel(c0, wi - c0 * pc.chunk_words)
                : Wsel(c0 + 1u, wi - (c0 + 1u) * pc.chunk_words);
        }
    }
    barrier();
    int r = int(r0) + rx;
    if (o < int(pc.n_out) && uint(r) < rp) {
        uint xr0 = (pc.mode == 1u ? uint(r) : perm_pad[uint(r)]) * pc.xq_w;
        const uint ones = 0x01010101u;
        uint srow = uint(ox) * row_words;   // 가중 행은 출력열(ox)
        float acc = 0.0;
        for (uint sb = 0u; sb < n_sub; sb++) {
            uint wb = srow + sb * 6u;
            vec2 dm2 = unpackHalf2x16(sh[wb]);
            float d = dm2.x, mn = dm2.y;
            uint qh = sh[wb + 1u];
            uint qsw0 = sh[wb + 2u], qsw1 = sh[wb + 3u];
            uint qsw2 = sh[wb + 4u], qsw3 = sh[wb + 5u];
            uint xw = xr0 + ((sb << 5) >> 2);
            int s_lo = 0, s_hi = 0, s1 = 0;
            for (int k = 0; k < 8; k++) {
                uint qs4 = (k & 3) == 0 ? qsw0 : (k & 3) == 1 ? qsw1 : (k & 3) == 2 ? qsw2 : qsw3;
                uint nib = (k < 4) ? (qs4 & 0x0F0F0F0Fu) : ((qs4 >> 4) & 0x0F0F0F0Fu);
                uint hb = (qh >> (4 * k)) & 0xFu;
                uint hb_p = (hb & 1u) << 4 | (hb & 2u) << 11 | (hb & 4u) << 18 | (hb & 8u) << 25;
                uint y = xq[xw + uint(k)];
                s_lo += dot4(nib, y, 0);
                s_hi += dot4(hb_p, y, 0);
                s1 += dot4(ones, y, 0);
            }
            float yd = uintBitsToFloat(xq[xr0 + (n_in >> 2) + sb]);
            acc += yd * (d * float(s_lo + s_hi) + mn * float(s1));
        }
        outv[uint(r) * pc.n_out + uint(o)] = acc;
    }
}
