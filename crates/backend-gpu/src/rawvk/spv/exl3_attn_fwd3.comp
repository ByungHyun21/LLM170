#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_vote : require

// exl3_attn_fwd3 (plans/121 F2b) — warp-행 스코어 + t-블록 공유 인과 어텐션.
// 그리드 (ceil(T/4), 24 q헤드). WG=256(서브그룹 4×64). kv행 4서브그룹 라운드로빈:
// 레인 si가 k[row]의 dim si*4..+4를 결합 판독, q는 LDS, shuffle-down 리듀스.
// t-블록 4행이 k/v 판독 공유 — kv 트래픽 ÷4(fwd2 대비). 소프트맥스는 LDS
// 트리 리듀스(배리어 ~10회 — fwd2의 64회 대비). 산술: CPU 미러와 동일 수학
// (exp(s−max)·v 누적 후 1회 정규화 — 10a). fwd/fwd2는 폐기 경로.

layout(local_size_x = 256) in;

layout(binding = 0) readonly buffer QHB { float qh[]; };   // [T][6144]
layout(binding = 1) readonly buffer KKC { float kc[]; };   // [cap][1024]
layout(binding = 2) readonly buffer VKC { float vc[]; };   // [cap][1024]
layout(binding = 3) readonly buffer QGB { float qg[]; };   // [T][12288] gate
layout(binding = 4) writeonly buffer OB { float outv[]; }; // [T][6144]
layout(binding = 5) readonly buffer PB { uint pp[]; }; // [1] = pos0(재생용)
layout(push_constant) uniform PC {
    uint t_len;
    uint pos0;
    uint layer; // kvc 오프셋
} pc;

#define TB 4
#define SCAP 1024

shared float qs4[TB * 256];
shared float sarr[TB * SCAP];
shared float reds[256];
shared float gw[TB][2]; // [t] = (gmax, wsum)

void main() {
    uint tb = gl_WorkGroupID.x * TB;
    uint h = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;        // 0..3
    uint si = gl_SubgroupInvocationID; // 0..63
    uint kh = h / 6u;
    float scale = 0.0625;

    uint lim[TB];
    for (uint tl = 0u; tl < TB; tl++) {
        uint t = tb + tl;
        lim[tl] = (t < pc.t_len) ? (pp[0] + t + 1u) : 0u;
    }
    uint lmax = 0u;
    for (uint tl = 0u; tl < TB; tl++) {
        lmax = max(lmax, lim[tl]);
    }

    // q 블록 적재(coalesced) — tl행 t=tb+tl
    for (uint tl = 0u; tl < TB; tl++) {
        uint t = tb + tl;
        if (t < pc.t_len) {
            qs4[tl * 256u + tid] = qh[t * 6144u + h * 256u + tid];
        }
    }
    barrier();

    // ── 스코어: 서브그룹당 kv행 라운드로빈, 레인 si는 dim si*4..+4 ──
    for (uint row = sg; row < lmax; row += 4u) {
        float kr0 = kc[(pc.layer * 1024u + row) * 1024u + kh * 256u + si * 4u + 0u];
        float kr1 = kc[(pc.layer * 1024u + row) * 1024u + kh * 256u + si * 4u + 1u];
        float kr2 = kc[(pc.layer * 1024u + row) * 1024u + kh * 256u + si * 4u + 2u];
        float kr3 = kc[(pc.layer * 1024u + row) * 1024u + kh * 256u + si * 4u + 3u];
        for (uint tl = 0u; tl < TB; tl++) {
            if (lim[tl] == 0u) {
                sarr[tl * SCAP + row] = -1e30;
                continue;
            }
            float p = qs4[tl * 256u + si * 4u + 0u] * kr0
                    + qs4[tl * 256u + si * 4u + 1u] * kr1
                    + qs4[tl * 256u + si * 4u + 2u] * kr2
                    + qs4[tl * 256u + si * 4u + 3u] * kr3;
            for (uint off = 32u; off > 0u; off >>= 1u) {
                p += subgroupShuffleDown(p, off);
            }
            if (si == 0u) {
                bool valid = row < lim[tl];
                sarr[tl * SCAP + row] = valid ? (p * scale) : -1e30;
            }
        }
    }
    barrier();

    // ── max/sumexp + exp 저장(제자리) — tl 순차, 256스레드 트리 리듀스 ──
    for (uint tl = 0u; tl < TB; tl++) {
        if (lim[tl] == 0u) {
            continue;
        }
        float lm = -1e30;
        for (uint i = tid; i < lim[tl]; i += 256u) {
            lm = max(lm, sarr[tl * SCAP + i]);
        }
        reds[tid] = lm;
        barrier();
        for (uint st = 128u; st > 0u; st >>= 1u) {
            if (tid < st) reds[tid] = max(reds[tid], reds[tid + st]);
            barrier();
        }
        float gmax = reds[0];
        if (tid == 0u) gw[tl][0] = gmax;
        barrier();
        float ls = 0.0;
        for (uint i = tid; i < lim[tl]; i += 256u) {
            float e = exp(sarr[tl * SCAP + i] - gmax);
            sarr[tl * SCAP + i] = e;
            ls += e;
        }
        reds[tid] = ls;
        barrier();
        for (uint st = 128u; st > 0u; st >>= 1u) {
            if (tid < st) reds[tid] += reds[tid + st];
            barrier();
        }
        if (tid == 0u) gw[tl][1] = reds[0];
        barrier();
    }

    // ── AV: 스레드 d가 자기 dim 열 결합 판독(행당 1KB 1트랜잭션) ──
    for (uint tl = 0u; tl < TB; tl++) {
        uint t = tb + tl;
        if (t >= pc.t_len) {
            continue;
        }
        float acc = 0.0;
        for (uint row = 0u; row < lim[tl]; row++) {
            acc += sarr[tl * SCAP + row] * vc[(pc.layer * 1024u + row) * 1024u + kh * 256u + tid];
        }
        float g = qg[t * 12288u + h * 512u + 256u + tid];
        float sg2 = 1.0 / (1.0 + exp(-g));
        outv[t * 6144u + h * 256u + tid] = (acc / gw[tl][1]) * sg2;
    }
}
