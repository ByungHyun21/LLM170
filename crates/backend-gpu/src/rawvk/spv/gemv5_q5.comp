#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require
// gemv5_q5 (plans/33) — q5_K 정수 dot 경로. LUT 불필요(니블+qh비트 산술 언팩).
// 구조는 gemv5_xs와 동일하나 ktab 대신: qv = 니블 + 16·qh비트 ∈ [0,31] (i8 팩),
// dot = d·sc·Σ(qv·y) − dm·mn·Σy — Σy는 서브당 1회(OpSDot(y, 0x01010101)).
// SDOT 블록 2개/k-반복: ql워드(원소 4k+b)와 ql워드+32(원소 16+4k+b... q5는 연속 l).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0c { uint w0[]; };
layout(binding = 1) readonly buffer W1c { uint w1[]; };
layout(binding = 2) readonly buffer W2c { uint w2[]; };
layout(binding = 3) readonly buffer W3c { uint w3[]; };
layout(binding = 4) readonly buffer W4c { uint w4[]; };
layout(binding = 5) readonly buffer W5c { uint w5[]; };
layout(binding = 6) readonly buffer W6c { uint w6[]; };
layout(binding = 7) readonly buffer W7c { uint w7[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint xq_w; uint cw_log2; uint cw_mask; uint rpf;
} pc;

uint WG(uint idx) {
    uint c = idx >> pc.cw_log2;
    uint o = idx & pc.cw_mask;
    if (c == 0u) return w0[o];
    if (c == 1u) return w1[o];
    if (c == 2u) return w2[o];
    if (c == 3u) return w3[o];
    if (c == 4u) return w4[o];
    if (c == 5u) return w5[o];
    if (c == 6u) return w6[o];
    return w7[o];
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint n_sub = n_in >> 5;
    uint blocks = n_in >> 8;
    uint xbase = tok * pc.xq_w;
    float acc[8];
    for (uint r = 0u; r < RPF; r++) acc[r] = 0.0;
    for (uint sb = tid; sb < n_sub; sb += 32u) {
        // B: q8 워드 8개 + yd — Σy는 int로 별산 (min 항)
        uint xw = (sb << 3);
        float yd = uintBitsToFloat(xq[xbase + (n_in >> 2) + sb]);
        int ysum = 0;
        for (uint k = 0u; k < 8u; k++) {
            uint yw = xq[xbase + xw + k];
            // Σy = SDot(y, 1) — 정준 패턴으로 기술 (패치 대상 아님: 값 유지)
            int s0 = int((yw       ) & 0xFFu) - ((yw & 0x00000080u) != 0u ? 256 : 0);
            int s1 = int((yw >> 8u ) & 0xFFu) - ((yw & 0x00008000u) != 0u ? 256 : 0);
            int s2 = int((yw >> 16u) & 0xFFu) - (((yw & 0x00800000u) != 0u) ? 256 : 0);
            int s3 = int((yw >> 24u) & 0xFFu) - (((yw & 0x80000000u) != 0u) ? 256 : 0);
            ysum += s0; ysum += s1; ysum += s2; ysum += s3;
        }
        // 이 서브의 ql/qh 워드 페어는 모든 행이 동일 어드레스 구조
        uint P = (sb & 7u) >> 1;
        uint lohi = sb & 1u;
        for (uint r = 0u; r < RPF; r++) {
            uint row = row0 + r;
            if (row >= pc.n_out) break;
            uint wb = row * blocks * 176u + (sb >> 3) * 176u;
            uint w0v = WG(wb >> 2);
            vec2 dm = unpackHalf2x16(w0v);
            // 스케일 (워드 직접 로드 — gemv4_q5 검증 로직)
            uint w1v = WG((wb >> 2) + 1u);
            uint w2v = WG((wb >> 2) + 2u);
            uint w3v = WG((wb >> 2) + 3u);
            uint j = 2u * P + lohi;
            uint sc, mn;
            if (j < 4u) {
                sc = (w1v >> (8u * j)) & 63u;
                mn = (w2v >> (8u * j)) & 63u;
            } else {
                uint b84 = (w3v >> (8u * (j - 4u))) & 0xFFu;
                uint bj  = (w2v >> (8u * (j - 4u))) & 0xFFu;
                uint qm4 = (w1v >> (8u * (j - 4u))) & 0xFFu;
                sc = (b84 & 0xFu) | ((qm4 >> 6u) << 4);
                mn = (b84 >> 4u) | ((bj >> 6u) << 4);
            }
            float dl = dm.x * float(sc);
            float dml = dm.y * float(mn);
            uint qh_bit = (lohi == 0u ? 1u : 2u) << (2u * P);
            int qsum = 0;
            [[unroll]] for (uint k = 0u; k < 8u; k++) {
                // ql 워드(원소 l=4k+b, 16B @48+32P) — ql[l]의 니블(lo/hi by lohi)
                uint bytei = wb + 48u + 32u * P + 4u * k;
                uint qv = WG(bytei >> 2);
                uint rem = bytei & 3u;
                if (rem != 0u) {
                    uint w2 = WG((bytei >> 2) + 1u);
                    qv = (qv >> (rem * 8u)) | (w2 << ((4u - rem) * 8u));
                }
                uint qhw = (wb + 16u + 4u * k) >> 2;
                uint hv = WG(qhw);
                uint hrem = (wb + 16u + 4u * k) & 3u;
                if (hrem != 0u) {
                    uint w2 = WG(qhw + 1u);
                    hv = (hv >> (hrem * 8u)) | (w2 << ((4u - hrem) * 8u));
                }
                uint nsh = lohi << 2u;
                uint yw = xq[xbase + xw + k];
                // q: 니블 + qh비트(×16) — i8x4 팩 워드 (값 0..31, SDot 부호 해석 안전)
                uint qpack_a = (((qv         >> nsh) & 0xFu) + ((hv         & qh_bit) != 0u ? 16u : 0u))
                             | (((((qv >> 8u ) >> nsh) & 0xFu) + (((hv >> 8u ) & qh_bit) != 0u ? 16u : 0u)) << 8u)
                             | (((((qv >> 16u) >> nsh) & 0xFu) + (((hv >> 16u) & qh_bit) != 0u ? 16u : 0u)) << 16u)
                             | (((((qv >> 24u) >> nsh) & 0xFu) + (((hv >> 24u) & qh_bit) != 0u ? 16u : 0u)) << 24u);
                // 정준 dot 패턴 (패치 대상) — qpack_a/yw 바이트별 부호 언팩×적산
                int sa0 = int((qpack_a       ) & 0xFFu);
                int sa1 = int((qpack_a >> 8u ) & 0xFFu);
                int sa2 = int((qpack_a >> 16u) & 0xFFu);
                int sa3 = int((qpack_a >> 24u) & 0xFFu);
                int sb0 = int((yw        ) & 0xFFu) - (((yw & 0x00000080u) != 0u) ? 256 : 0);
                int sb1 = int((yw >> 8u  ) & 0xFFu) - (((yw & 0x00008000u) != 0u) ? 256 : 0);
                int sb2 = int((yw >> 16u) & 0xFFu) - (((yw & 0x00800000u) != 0u) ? 256 : 0);
                int sb3 = int((yw >> 24u) & 0xFFu) - (((yw & 0x80000000u) != 0u) ? 256 : 0);
                int p0 = sa0 * sb0; int p1 = sa1 * sb1; int p2 = sa2 * sb2; int p3 = sa3 * sb3;
                qsum += p0; qsum += p1; qsum += p2; qsum += p3;
                // SDOT: sa0 qpack_a yw
            }
            acc[r] += dl * float(qsum) * yd - dml * float(ysum) * yd;
        }
    }
    for (uint r = 0u; r < RPF; r++) {
        uint row = row0 + r;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(acc[r]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
