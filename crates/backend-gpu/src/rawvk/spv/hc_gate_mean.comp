#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// plans/84 B — HcGateMean: out[ti·n+i] = Σ_s xn[..]·σ(-gate[..]) / hc.
// plans/101 P1: h16=1 → gate는 packed f16(워드 k>>1 하프 k&1).
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer Xn { uint xnu[]; };
layout(binding = 1) readonly buffer Gt { uint gate[]; };
layout(binding = 2) buffer Ob { float outv[]; };
layout(push_constant) uniform PC { uint hc; uint n; uint total; uint h16; } pc;
float gat(uint k) {
    if ((pc.h16 & 1u) == 0u) return uintBitsToFloat(gate[k]);
    vec2 h = unpackHalf2x16(gate[k >> 1]);
    return (k & 1u) == 0u ? h.x : h.y;
}
float xnv(uint k) {
    if ((pc.h16 & 2u) == 0u) return uintBitsToFloat(xnu[k]);
    vec2 h = unpackHalf2x16(xnu[k >> 1]);
    return (k & 1u) == 0u ? h.x : h.y;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    uint ti = i / pc.n;
    uint ii = i % pc.n;
    float acc = 0.0;
    for (uint s = 0u; s < pc.hc; s++) {
        uint k = ti * pc.hc * pc.n + s * pc.n + ii;
        acc += xnv(k) * (1.0 / (1.0 + exp(-gat(k))));
    }
    outv[i] = acc / float(pc.hc);
}
