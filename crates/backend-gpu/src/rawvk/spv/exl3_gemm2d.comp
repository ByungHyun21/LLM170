#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// exl3_gemm2d (plans/121 메가융합 3호) — 듀얼입력 트렐리스 GEMM:
// 쌍 (li1: n1열, li2: n2열)을 단일 디스패치로 — WG-균일 분기 sel로
// ah/tre 소스만 전환, coopmat/드레인은 exl3_gemm2와 동일 산술(비트 동일 목표).
// sb는 단일 슬래브 [T][n1+n2](had_out_td가 n_off로 분리 환원).
// 전제: 두 선형 k·K(bpw) 동일, n 모두 64배수(쌍 내 서로 다름 가능).
// 그리드 x=(n1+n2)/64, y=ceil(T/64).
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer Ah1 { uint ah16a[]; }; // f16 쌍팩 [T][k/2]
layout(binding = 1) readonly buffer Tre1 { uint tre_a[]; };
layout(binding = 2) readonly buffer Ah2 { uint ah16b[]; };
layout(binding = 3) readonly buffer Tre2 { uint tre_b[]; };
layout(binding = 4) writeonly buffer SB { float s[]; };    // f32 [T][n_total]
layout(push_constant) uniform PC {
    uint ktiles;   // k/16 (쌍 공통)
    uint ntiles1;  // n1/16
    uint ntiles2;  // n2/16
    uint K;        // bpw 정수부
    uint T;
} pc;

#define BM 64
#define BN 128
#define BK 32
#define SHMEM_STRIDE (BK / 2 + 2)

shared f16vec2 buf_a[BM * SHMEM_STRIDE];
shared f16vec2 buf_b[BN * SHMEM_STRIDE];
shared uint tre_s[8u * 48u];
shared float16_t Ctmp[64][17];

float mul1_decode(uint w) {
    uint x = w * 0x83DCD12Du;
    uint p = (x & 0x00FF00FFu) + ((x >> 8u) & 0x00FF00FFu);
    uint sum = (p & 0xFFFFu) + (p >> 16u);
    return (1024.0 + float(sum)) * 0.00676727294921875 - 10.3828125;
}

uint tile_word(uint tidx, uint r, uint c) {
    uint words32 = 8u * pc.K;
    uint t_ = (4u * (c & 7u) + ((r & 7u) >> 1u)) * 8u
            + ((r >> 3u) * 2u + (r & 1u) + ((c >> 3u) * 4u));
    uint b0 = t_ * pc.K + (pc.K + 256u * pc.K - 16u);
    uint b1 = b0 + 16u;
    uint i0 = (b0 >> 5u) % words32;
    uint i1 = ((b1 - 1u) >> 5u) % words32;
    uint sh = (((b1 - 1u) >> 5u) + 1u) * 32u - b1;
    uint w0 = tre_s[tidx * words32 + i0];
    uint w1 = tre_s[tidx * words32 + i1];
    if (sh == 0u) return w1 & 0xFFFFu;
    return ((w0 << (32u - sh)) | (w1 >> sh)) & 0xFFFFu;
}

void main() {
    uint wg_n = gl_WorkGroupID.x;
    uint wg_t = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    uint nt1wgs = pc.ntiles1 / 4u;
    bool sel1 = wg_n < nt1wgs;            // WG-균일
    uint wg_loc = sel1 ? wg_n : (wg_n - nt1wgs);
    uint my_ntiles = sel1 ? pc.ntiles1 : pc.ntiles2;
    uint n_off = sel1 ? 0u : pc.ntiles1 * 16u;
    uint n_total = (pc.ntiles1 + pc.ntiles2) * 16u;
    uint row0 = wg_loc * BM;
    uint t0 = wg_t * BN;
    uint nrow = min(BM, my_ntiles * 16u - row0);
    uint nt = min(BN, pc.T - t0);
    uint words32 = 8u * pc.K;
    uint nkb = pc.ktiles >> 1u;
    uint arow_words = pc.ktiles * 8u;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][4];
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint kb = 0; kb < nkb; kb++) {
        {
            uint stg_words = 8u * words32;
            for (uint w = tid; w < stg_words; w += 128u) {
                uint tidx = w / words32;
                uint wq = w % words32;
                uint ktl = tidx >> 2u;
                uint ntl = tidx & 3u;
                uint gidx = ((kb * 2u + ktl) * my_ntiles + (wg_loc * 4u + ntl)) * words32 + wq;
                tre_s[w] = sel1 ? tre_a[gidx] : tre_b[gidx];
            }
            barrier();
        }
        {
            uint e0 = tid * 16u;
            uint n_loc = e0 / BK;
            uint k0 = e0 % BK;
            uint c = n_loc & 15u;
            uint nt_hi = n_loc >> 4u;
            for (uint q = 0; q < 8u; q++) {
                uint kA = k0 + 2u * q;
                uint kB = k0 + 2u * q + 1u;
                float16_t va = float16_t(0.0);
                float16_t vb = float16_t(0.0);
                if (n_loc < nrow) {
                    va = float16_t(mul1_decode(tile_word((kA >> 4u) * 4u + nt_hi, kA & 15u, c)));
                    vb = float16_t(mul1_decode(tile_word((kB >> 4u) * 4u + nt_hi, kB & 15u, c)));
                }
                buf_a[n_loc * SHMEM_STRIDE + (k0 >> 1u) + q] = f16vec2(va, vb);
            }
        }
        {
            for (uint p = 0; p < 2u; p++) {
                uint e0 = (tid + p * 128u) * 16u;
                uint t_loc = e0 / BK;
                uint k0 = e0 % BK;
                for (uint q = 0; q < 8u; q++) {
                    f16vec2 v = f16vec2(float16_t(0.0));
                    if (t_loc < nt) {
                        uint aidx = (t0 + t_loc) * arow_words + (kb * BK + k0) / 2u + q;
                        vec2 uv = unpackHalf2x16(sel1 ? ah16a[aidx] : ah16b[aidx]);
                        v = f16vec2(float16_t(uv.x), float16_t(uv.y));
                    }
                    buf_b[t_loc * SHMEM_STRIDE + (k0 >> 1u) + q] = v;
                }
            }
        }
        barrier();
        int tbase = int(sg) * 64;
        for (uint ks = 0; ks < BK / 16; ks++) {
            for (uint wm = 0; wm < 4; wm++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
                coopMatLoad(fa, buf_a, (wm * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                for (uint wn = 0; wn < 4; wn++) {
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fbb;
                    coopMatLoad(fbb, buf_b, (tbase + wn * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                    acc[wm][wn] = coopMatMulAdd(fa, fbb, acc[wm][wn]);
                }
            }
        }
        barrier();
    }

    for (int q = 0; q < 8; q++) {
        if (nt <= uint(q * 16)) break;
        int wn = q - int(sg) * 4;
        if (wn >= 0 && wn < 4) {
            for (int wm = 0; wm < 4; wm++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> hf16 =
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[wm][wn]);
                coopMatStore(hf16, Ctmp[wm * 16], 0, 17, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();
        int ncols = int(min(nt - uint(q * 16), 16u));
        for (int i = int(tid); i < int(nrow) * ncols; i += 128) {
            int r = i / ncols;
            int ti = i % ncols;
            s[(t0 + uint(q * 16 + ti)) * n_total + (n_off + row0 + uint(r))] = float(Ctmp[r][ti]);
        }
        barrier();
    }
}
