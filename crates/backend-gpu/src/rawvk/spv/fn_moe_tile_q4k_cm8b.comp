#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
// plans/99 cm8b: coopmat M64 변형 — WG당 가중행 64(v5 기하) × 할당행 16.
// 단일 coopmat 객체 재사용(원장 47: 두번째 객체 오염 회피).
// 기하 자동유도: gx = ⌈n_out/64⌉(정상) — row0 = bid·(n_out/gx).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 8) readonly buffer Xq { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(binding = 13) buffer Cm8Scratch { uint8_t sc8[]; };   // A 타일 8개(2KB/WG)
layout(binding = 14) buffer Cm8ScratchI { int8_t sc8i[]; };  // B 타일 2개(512B/WG)
layout(binding = 15) buffer Cm8ScratchW { int scw[]; };      // acc 스토어 4그룹(4KB/WG)
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;
shared float sAd[64];
shared float sAm[64];
shared float sBd[16];
shared float sBsum[16];
shared float sAccF[64][16];

uint sbyte(uint wq, int i) {
    return (w0c[wq + 1u + uint(i >> 2)] >> uint((i & 3) * 8)) & 0xFFu;
}
float f16_exact(uint bits) {
    float sgn = (bits & 0x8000u) != 0u ? -1.0 : 1.0;   // 부호 필수(cm8 정합)
    uint e = (bits >> 10) & 0x1Fu;
    uint m = bits & 0x3FFu;
    if (e == 0u) return sgn * float(m) * 5.960464477539063e-8;
    return sgn * float(1024u + m) * exp2(float(int(e)) - 25.0);
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    uint rows_per_wg = pc.n_out / gl_NumWorkGroups.x;   // 64(정상)
    int row0 = int(bid) * int(rows_per_wg);
    int nrow = int(min(rows_per_wg, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;
    uint rp = rows_pad[0];
    bool band_live = uint(r0e) < rp;
    uint e = band_live ? rowexp[uint(r0e)] : 0u;
    int nt = int(min(16u, rp - uint(min(uint(r0e), rp))));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);
    uint qw = uint(n_in >> 2);
    // wgslot은 바이트(u8/i8)·/4는 i32 기준. A 2KB + B 512B + acc 4KB.
    uint wgslot = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 2048u;
#define AT(g, i) sc8[wgslot + uint(g) * 512u + uint(i)]
#define B0(i) sc8i[wgslot + uint(i)]
#define B1(i) sc8i[wgslot + 256u + uint(i)]

    int live_cnt = 0;
    if (band_live) {
        for (int q2 = 0; q2 < 16; q2++) {
            if (uint(r0e + q2) < rp && perm_pad[uint(r0e + q2)] != 0xFFFFFFFFu) live_cnt = q2 + 1;
        }
    }
    for (int i = int(tid); i < 64 * 16; i += 32) {
        sAccF[i >> 4][i & 15] = 0.0;
    }
    barrier();

    coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma0;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb0;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc32;

    for (int sb = 0; sb < n_sub; sb++) {
        // ── A 스테이징: 64행 × 8워드 → 레인당 16회.
        for (int i = int(tid); i < 64 * 8; i += 32) {
            int m = i >> 3;
            int p = i & 7;
            int g = m >> 4;
            int mr = m & 15;
            int row = row0 + m;
            if (m < nrow) {
                uint wq4 = ebase + uint(row) * row_words + uint(sb >> 3) * 36u;
                uint qbase = wq4 + 4u + uint(((sb & 7) >> 1) * 8);
                bool hi = (sb & 1) != 0;
                uint w = w0c[qbase + uint(p)];
                w = hi ? ((w >> 4) & 0x0F0F0F0Fu) : (w & 0x0F0F0F0Fu);
                if (p < 4) {
                    AT(g, mr * 16 + p * 4 + 0) = uint8_t(w & 0xFFu);
                    AT(g, mr * 16 + p * 4 + 1) = uint8_t((w >> 8) & 0xFFu);
                    AT(g, mr * 16 + p * 4 + 2) = uint8_t((w >> 16) & 0xFFu);
                    AT(g, mr * 16 + p * 4 + 3) = uint8_t(w >> 24);
                } else {
                    int q4 = p - 4;
                    AT(g, 256 + mr * 16 + q4 * 4 + 0) = uint8_t(w & 0xFFu);
                    AT(g, 256 + mr * 16 + q4 * 4 + 1) = uint8_t((w >> 8) & 0xFFu);
                    AT(g, 256 + mr * 16 + q4 * 4 + 2) = uint8_t((w >> 16) & 0xFFu);
                    AT(g, 256 + mr * 16 + q4 * 4 + 3) = uint8_t(w >> 24);
                }
                if (p == 0) {
                    float d = f16_exact(w0c[wq4] & 0xFFFFu);
                    float dmin = f16_exact(w0c[wq4] >> 16);
                    int j = sb & 7;
                    uint s_v, m_v;
                    if (j < 4) {
                        s_v = sbyte(wq4, j) & 63u;
                        m_v = sbyte(wq4, j + 4) & 63u;
                    } else {
                        uint b_p4 = sbyte(wq4, j + 4);
                        s_v = (b_p4 & 0xFu) | ((sbyte(wq4, j - 4) >> 6) << 4);
                        m_v = (b_p4 >> 4) | ((sbyte(wq4, j) >> 6) << 4);
                    }
                    sAd[m] = d * float(s_v);
                    sAm[m] = dmin * float(m_v);
                }
            } else {
                int off = (p < 4) ? 0 : 256;
                int q4 = (p < 4) ? p : (p - 4);
                for (int b = 0; b < 4; b++) {
                    AT(g, off + mr * 16 + q4 * 4 + b) = uint8_t(0);
                }
                if (p == 0) { sAd[m] = 0.0; sAm[m] = 0.0; }
            }
        }
        // ── B 스테이징: xq 워드 → i8 바이트.
        for (int i = int(tid); i < 16 * 4; i += 32) {
            int rb = i >> 2;
            int p = i & 3;
            if (rb < live_cnt) {
                uint pr_ = perm_pad[uint(r0e + rb)];
                uint base = (pr_ == 0xFFFFFFFFu ? 0u : pr_) * pc.xq_w;
                uint w = xq[base + uint(sb * 8 + p)];
                B0(rb * 16 + p * 4 + 0) = int8_t(w & 0xFFu);
                B0(rb * 16 + p * 4 + 1) = int8_t((w >> 8) & 0xFFu);
                B0(rb * 16 + p * 4 + 2) = int8_t((w >> 16) & 0xFFu);
                B0(rb * 16 + p * 4 + 3) = int8_t(w >> 24);
                uint w2 = xq[base + uint(sb * 8 + 4u + p)];
                B1(rb * 16 + p * 4 + 0) = int8_t(w2 & 0xFFu);
                B1(rb * 16 + p * 4 + 1) = int8_t((w2 >> 8) & 0xFFu);
                B1(rb * 16 + p * 4 + 2) = int8_t((w2 >> 16) & 0xFFu);
                B1(rb * 16 + p * 4 + 3) = int8_t(w2 >> 24);
                if (p == 0) {
                    sBd[rb] = uintBitsToFloat(xq[base + qw + uint(sb)]);
                    uint qsb = qw + (uint(n_in) >> 5);
                    sBsum[rb] = float(int(xq[base + qsb + uint(sb * 2)])
                                    + int(xq[base + qsb + uint(sb * 2) + 1u]));
                }
            } else {
                for (int b = 0; b < 4; b++) {
                    B0(rb * 16 + p * 4 + b) = int8_t(0);
                    B1(rb * 16 + p * 4 + b) = int8_t(0);
                }
                if (p == 0) { sBd[rb] = 0.0; sBsum[rb] = 0.0; }
            }
        }
        memoryBarrierShared();
        barrier();

        // ── MMA: 타일그룹 4개 × K32 — 단일 객체 재사용(원장 47).
        for (int g = 0; g < 4; g++) {
            acc32 = coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
            coopMatLoad(ma0, sc8, wgslot + uint(g) * 512u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            coopMatLoad(ma0, sc8, wgslot + uint(g) * 512u + 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb0, sc8i, wgslot + 256u, 16, gl_CooperativeMatrixLayoutColumnMajor);
            acc32 = coopMatMulAdd(ma0, mb0, acc32);
            // acc 기준: 4그룹×256i32=1024i32/WG — wgslot/2(=wg·1024)필수.
            coopMatStore(acc32, scw, wgslot / 2u + uint(g) * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
        }
        memoryBarrierShared();
        memoryBarrierBuffer();
        barrier();
        // ── 스케일: 1024셀 / 32레인 = 32회.
        for (int i = 0; i < 32; i++) {
            int idx = int(tid) * 32 + i;
            int m = idx >> 4;
            int r = idx & 15;
            sAccF[m][r] += sBd[r] * (sAd[m] * float(scw[wgslot / 2u + uint(m * 16 + r)]) - sAm[m] * sBsum[r]);
        }
        memoryBarrierShared();
        memoryBarrierBuffer();
        barrier();
    }

    // ── 드레인: 레인당 2행.
    for (int m2 = 0; m2 < 2; m2++) {
        int m = int(tid) + m2 * 32;
        if (m < nrow) {
            for (int c = 0; c < nt; c++) {
                uint pr2 = perm_pad[uint(r0e + c)];
                if (pr2 != 0xFFFFFFFFu) {
                    outv[pr2 * pc.n_out + uint(row0 + m)] = sAccF[m][c];
                }
            }
        }
    }
}
