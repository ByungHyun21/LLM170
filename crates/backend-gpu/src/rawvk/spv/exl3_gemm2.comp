#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// exl3_gemm2 (plans/121 A1-pp2) — coopmat 트렐리스 GEMM(프리필):
// S[t][n] = Σ_k A_had[t][k] · Wq[k,n].
//
// tile_q8ms(Q4 프리필 패밀리)의 골격을 트렐리스로 이식: 가중치 타일
// (BM×BK)을 스레드 협력 트렐리스 디코드로 smem f16에 적재하고(coopmat
// A), 활성화 ah16은 이미 f16 쌍팩이라 통째로 smem에 복사(coopmat B),
// coopMatMulAdd 16×16×16로 누산한다. 스칼라 f16x2 FMA(믹스 ~48%) 대비
// coopmat는 서브그룹 풀레이트 MAC — 병목 원장 #2(gemm 30%)의 본 대응.
//
// 누산: coopmat float(f32) — Q4 프리필 패밀리(tile_q8ms 등)와 동일
// 관행. 참조(GEMV f16 누산+FOLD4)보다 정밀도가 높은 방향이며 exl3-pp
// corr·greedy 토큰 검증이 근거를 제공한다(커밋 메시지에 명시).
//
// 그리드: x = n/64(BM=64 — 본 모델 전 선형 n이 64배수), y = ceil(T/64).
// sb는 [T][n] f32(nseg=1 — had_out_t가 nseg=1로 환원). k-분할 없음:
// WG 수 = (n/64)×(T/64)면 충분하다.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer AhB { uint ah16[]; };  // f16 쌍팩 [T][k/2]
layout(binding = 1) readonly buffer TreB { uint tre[]; };  // trellis u32 뷰
layout(binding = 2) writeonly buffer SB { float s[]; };    // f32 [T][n]
layout(push_constant) uniform PC {
    uint ktiles;
    uint ntiles;
    uint K;        // bpw(정수부) — u16 폭 16K
    uint T;        // 활성화 행 수
} pc;

#define BM 64
#define BN 128
#define BK 32
#define SHMEM_STRIDE (BK / 2 + 2)   // 18 vec2 (tile_q8ms 관례 패딩)

shared f16vec2 buf_a[BM * SHMEM_STRIDE];
shared f16vec2 buf_b[BN * SHMEM_STRIDE];
// 트렐리스 스테이징: k-블록당 4 kt × 4 nt 타일 × words32(K≤6 → 48).
shared uint tre_s[8u * 48u];
shared float16_t Ctmp[64][17];

float mul1_decode(uint w) {
    uint x = w * 0x83DCD12Du;
    uint p = (x & 0x00FF00FFu) + ((x >> 8u) & 0x00FF00FFu);
    uint sum = (p & 0xFFFFu) + (p >> 16u);
    return (1024.0 + float(sum)) * 0.00676727294921875 - 10.3828125;
}

// 트렐리스 링에서 타일 내 (r,c) 워드 u16 추출 — gemv addr16식(i0/i1/sh).
// tidx는 tre_s 지역(0..7 = kt*4 + nt), r=k%16, c=n%16.
uint tile_word(uint tidx, uint r, uint c) {
    uint words32 = 8u * pc.K;
    uint t_ = (4u * (c & 7u) + ((r & 7u) >> 1u)) * 8u
            + ((r >> 3u) * 2u + (r & 1u) + ((c >> 3u) * 4u));
    uint b0 = t_ * pc.K + (pc.K + 256u * pc.K - 16u);
    uint b1 = b0 + 16u;
    uint i0 = (b0 >> 5u) % words32;
    uint i1 = ((b1 - 1u) >> 5u) % words32;
    uint sh = (((b1 - 1u) >> 5u) + 1u) * 32u - b1;
    uint w0 = tre_s[tidx * words32 + i0];
    uint w1 = tre_s[tidx * words32 + i1];
    if (sh == 0u) return w1 & 0xFFFFu;   // 단어 전체가 i1 하위 16비트
    return ((w0 << (32u - sh)) | (w1 >> sh)) & 0xFFFFu;   // gemv 동식: (i0<<(32−sh))|(i1>>sh)
}

void main() {
    uint wg_n = gl_WorkGroupID.x;      // n 타일 그룹(64행)
    uint wg_t = gl_WorkGroupID.y;      // 토큰 슬래브(64행)
    uint tid = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;           // 0..1 (wave64)
    uint n = pc.ntiles * 16u;
    uint row0 = wg_n * BM;             // n 기준 행 기점
    uint t0 = wg_t * BN;
    uint nrow = min(BM, n - row0);
    uint nt = min(BN, pc.T - t0);      // 실토큰 수(초과분 0패딩)
    uint words32 = 8u * pc.K;
    uint nkb = pc.ktiles >> 1u;        // 32k 블록 수
    uint arow_words = pc.ktiles * 8u;  // ah 행당 u32 (k/2)

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][4];
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 4; j++)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint kb = 0; kb < nkb; kb++) {
        // ── 트렐리스 타일 8개 협력 스테이징(연속 u32 코얼레스드) ──
        {
            uint stg_words = 8u * words32;
            for (uint w = tid; w < stg_words; w += 128u) {
                uint tidx = w / words32;             // 0..7 (kt*4 + nt)
                uint wq = w % words32;
                uint ktl = tidx >> 2u;               // 0..1
                uint ntl = tidx & 3u;                // 0..3
                tre_s[w] = tre[((kb * 2u + ktl) * pc.ntiles + (wg_n * 4u + ntl)) * words32 + wq];
            }
            barrier();
        }
        // ── A 적재: BM(n)×BK(k) 트렐리스 디코드 — 스레드당 한 행의 k 16연속
        //    (e = tid*16, BM*BK = 4096/128 = 32… 2048원소 → 16원소×128스레드.
        //     실제 원소수는 BM*BK=2048: e0 = tid*16 < 2048 ✓ 1패스 완전 커버) ──
        {
            uint e0 = tid * 16u;
            uint n_loc = e0 / BK;                    // 행(0..63)
            uint k0 = e0 % BK;                       // 0 또는 16
            uint c = n_loc & 15u;
            uint nt_hi = n_loc >> 4u;                // 지역 nt 0..3
            for (uint q = 0; q < 8u; q++) {
                uint kA = k0 + 2u * q;
                uint kB = k0 + 2u * q + 1u;
                float16_t va = float16_t(0.0);
                float16_t vb = float16_t(0.0);
                if (n_loc < nrow) {
                    va = float16_t(mul1_decode(tile_word((kA >> 4u) * 4u + nt_hi, kA & 15u, c)));
                    vb = float16_t(mul1_decode(tile_word((kB >> 4u) * 4u + nt_hi, kB & 15u, c)));
                }
                buf_a[n_loc * SHMEM_STRIDE + (k0 >> 1u) + q] = f16vec2(va, vb);
            }
        }
        // ── B 적재: BN(토큰)×BK(k) — ah16 f16 쌍팩 그대로(스레드당 2패스×8 vec2) ──
        {
            for (uint p = 0; p < 2u; p++) {
                uint e0 = (tid + p * 128u) * 16u;
                uint t_loc = e0 / BK;            // 토큰(0..127)
                uint k0 = e0 % BK;
                for (uint q = 0; q < 8u; q++) {
                    f16vec2 v = f16vec2(float16_t(0.0));
                    if (t_loc < nt) {
                        vec2 uv = unpackHalf2x16(ah16[(t0 + t_loc) * arow_words + (kb * BK + k0) / 2u + q]);
                        v = f16vec2(float16_t(uv.x), float16_t(uv.y));
                    }
                    buf_b[t_loc * SHMEM_STRIDE + (k0 >> 1u) + q] = v;
                }
            }
        }
        barrier();
        // ── coopmat: BK/TK = 2 k-스텝. sg: 토큰 반(sg*32). tile_q8ms 동식. ──
        int tbase = int(sg) * 64;
        for (uint ks = 0; ks < BK / 16; ks++) {
            for (uint wm = 0; wm < 4; wm++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
                coopMatLoad(fa, buf_a, (wm * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                for (uint wn = 0; wn < 4; wn++) {
                    // 가드 없음: B 적재가 nt 초과 토큰을 0으로 패딩, 드레인이 클립.
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fbb;
                    coopMatLoad(fbb, buf_b, (tbase + wn * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                    acc[wm][wn] = coopMatMulAdd(fa, fbb, acc[wm][wn]);
                }
            }
        }
        barrier();
    }

    // ── 드레인: 16토큰 슬래브(tile_q8ms 동식, 출력 sb [T][n]) ──
    for (int q = 0; q < 8; q++) {
        if (nt <= uint(q * 16)) break;
        int wn = q - int(sg) * 4;
        if (wn >= 0 && wn < 4) {
            for (int wm = 0; wm < 4; wm++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> hf16 =
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[wm][wn]);
                coopMatStore(hf16, Ctmp[wm * 16], 0, 17, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        barrier();
        int ncols = int(min(nt - uint(q * 16), 16u));
        for (int i = int(tid); i < int(nrow) * ncols; i += 128) {
            int r = i / ncols;
            int ti = i % ncols;
            s[(t0 + uint(q * 16 + ti)) * n + (row0 + uint(r))] = float(Ctmp[r][ti]);
        }
        barrier();
    }
}
