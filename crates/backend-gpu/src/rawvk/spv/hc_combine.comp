#version 450
// plans/84 B — HcCombine: res[ti·hc·n + s·n + i] += out[ti·n+i]·2σ(inj[ti·hc+s]/hc).
layout(local_size_x = 128) in;
layout(binding = 0) buffer Res { float res[]; };
layout(binding = 1) readonly buffer Ou { float outv[]; };
layout(binding = 2) readonly buffer Ij { float inj[]; };
layout(push_constant) uniform PC { uint hc; uint n; uint total; } pc;  // total = n·t
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    uint ti = i / pc.n;
    uint ii = i % pc.n;
    for (uint s = 0u; s < pc.hc; s++) {
        float g = 2.0 / (1.0 + exp(-inj[ti * pc.hc + s] / float(pc.hc)));
        res[ti * pc.hc * pc.n + s * pc.n + ii] += outv[i] * g;
    }
}
