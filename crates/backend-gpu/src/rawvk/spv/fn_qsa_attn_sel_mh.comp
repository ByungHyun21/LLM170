#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// fn_qsa_attn_sel_mh (plans/89 P0.4) — QSA 선택 어텐션 멀티헤드 판.
// 판(fn_qsa_attn_sel)은 WG=(tok,헤드)라 12개 Q헤드가 같은 kv행을 재판독
// ([ts] 7.7ms/step@8k). 이 판: WG=(tok, kv헤드), 256스레드=4sg×(heads/4)개
// 헤드 — K/V 스트리밍 12× 절감. 헤드별 산술(j 순회·subgroupAdd·온라인
// softmax)은 판과 완전 동일 → 헤드별 출력 비트 동일 기대.
// 조건: hd==256, (n_head/n_kv) % 4 == 0 (FN: 24/2=12 → sg당 3헤드).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Qb { float q[]; };
layout(binding = 1) readonly buffer Ck { float ck[]; };
layout(binding = 2) readonly buffer Cv { float cv[]; };
layout(binding = 3) readonly buffer Si { uint sel_idx[]; };
layout(binding = 4) readonly buffer So { uint sel_off[]; };
layout(binding = 5) buffer Ob { float o[]; };
layout(push_constant) uniform PC {
    float kq_scale; uint n_head; uint n_kv; uint hd; uint t;
} pc;

void main() {
    uint tok = gl_WorkGroupID.x;
    uint kvh = gl_WorkGroupID.y;
    uint lane = gl_SubgroupInvocationID;
    uint sg = gl_SubgroupID;
    uint hpk = pc.n_head / max(pc.n_kv, 1u);   // kv헤드당 Q헤드 (12)
    uint hps = hpk / 4u;                        // sg당 헤드 (3)
    if (tok >= pc.t || kvh >= pc.n_kv || pc.hd != 256u || hps == 0u) return;
    uint h0 = kvh * hpk + sg * hps;
    // q/g 레지스더 적재: 헤드당 4+4.
    float qr[3][4];
    float g4[3][4];
    for (uint hh = 0u; hh < hps; hh++) {
        uint q0 = (tok * pc.n_head + h0 + hh) * 2u * pc.hd;
        for (uint e = 0u; e < 4u; e++) {
            qr[hh][e] = q[q0 + lane * 4u + e];
            g4[hh][e] = q[q0 + pc.hd + lane * 4u + e];
        }
    }
    float a0[3]; float a1[3]; float a2[3]; float a3[3];
    float mrun[3]; float lrun[3];
    const float NEG = -3.4028235e38;
    for (uint hh = 0u; hh < hps; hh++) {
        a0[hh] = 0.0; a1[hh] = 0.0; a2[hh] = 0.0; a3[hh] = 0.0;
        mrun[hh] = NEG; lrun[hh] = 0.0;
    }
    uint j0 = sel_off[tok];
    uint j1 = sel_off[tok + 1u];
    for (uint j = j0; j < j1; j++) {
        uint p = sel_idx[j];
        uint k0 = p * pc.n_kv * pc.hd + kvh * pc.hd;
        // K/V 행 — sg 전체가 1회 판독(4원소×64레인).
        float kr0 = ck[k0 + lane * 4u + 0u];
        float kr1 = ck[k0 + lane * 4u + 1u];
        float kr2 = ck[k0 + lane * 4u + 2u];
        float kr3 = ck[k0 + lane * 4u + 3u];
        float vr0 = cv[k0 + lane * 4u + 0u];
        float vr1 = cv[k0 + lane * 4u + 1u];
        float vr2 = cv[k0 + lane * 4u + 2u];
        float vr3 = cv[k0 + lane * 4u + 3u];
        for (uint hh = 0u; hh < hps; hh++) {
            float d = qr[hh][0] * kr0 + qr[hh][1] * kr1 + qr[hh][2] * kr2 + qr[hh][3] * kr3;
            float s = subgroupAdd(d) * pc.kq_scale;
            if (s > mrun[hh]) {
                float corr = (mrun[hh] <= NEG) ? 0.0 : exp(mrun[hh] - s);
                a0[hh] *= corr; a1[hh] *= corr; a2[hh] *= corr; a3[hh] *= corr;
                lrun[hh] *= corr;
                mrun[hh] = s;
            }
            float e = exp(s - mrun[hh]);
            lrun[hh] += e;
            a0[hh] += e * vr0;
            a1[hh] += e * vr1;
            a2[hh] += e * vr2;
            a3[hh] += e * vr3;
        }
    }
    for (uint hh = 0u; hh < hps; hh++) {
        float inv_l = (lrun[hh] > 0.0) ? 1.0 / lrun[hh] : 0.0;
        uint o0 = (tok * pc.n_head + h0 + hh) * pc.hd;
        o[o0 + lane * 4u + 0u] = a0[hh] * inv_l * (1.0 / (1.0 + exp(-g4[hh][0])));
        o[o0 + lane * 4u + 1u] = a1[hh] * inv_l * (1.0 / (1.0 + exp(-g4[hh][1])));
        o[o0 + lane * 4u + 2u] = a2[hh] * inv_l * (1.0 / (1.0 + exp(-g4[hh][2])));
        o[o0 + lane * 4u + 3u] = a3[hh] * inv_l * (1.0 / (1.0 + exp(-g4[hh][3])));
    }
}
