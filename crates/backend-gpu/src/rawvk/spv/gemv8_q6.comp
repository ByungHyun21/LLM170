#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
// gemv8_q6 (plans/36 G1 재도전) — llama mul_mat_vec_q6_k 직역 + u16 뷰.
// 핵심: 210B 블록을 u16[105]로 직접 판독 (q5 성공 패턴 — 워드 조립/210B 비정렬
// 완전 제거). 스레드 기하는 llama 그대로: itid=tid%16, v_im=itid/8, v_in=itid%8,
// l0=4*v_in, is=v_in/4 — 4쿼터(원소 +0/+32/+64/+96)를 ql lo/hi 니블 + qh 2비트로
// 조립, 스케일 16 int8(@192) 직독, d f16(@208). fma 체인은 llama :74 순서.
// 32스레드 = 2블록 병렐(jj = ix; jj += 2), subgroupAdd 종결.
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer W0 { uint16_t w0h[]; };
layout(binding = 1) readonly buffer W1 { uint16_t w1h[]; };
layout(binding = 2) readonly buffer W2 { uint16_t w2h[]; };
layout(binding = 3) readonly buffer W3 { uint16_t w3h[]; };
layout(binding = 4) readonly buffer W4 { uint16_t w4h[]; };
layout(binding = 5) readonly buffer W5 { uint16_t w5h[]; };
layout(binding = 6) readonly buffer W6 { uint16_t w6h[]; };
layout(binding = 7) readonly buffer W7 { uint16_t w7h[]; };
layout(binding = 8) readonly buffer Xbuf { float xa[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint t; uint cw2_log2; uint cw2_mask; uint rpf;
} pc;

uint16_t WG16(uint idx) {
    uint c = idx >> pc.cw2_log2;
    uint o = idx & pc.cw2_mask;
    if (c == 0u) return w0h[o];
    if (c == 1u) return w1h[o];
    if (c == 2u) return w2h[o];
    if (c == 3u) return w3h[o];
    if (c == 4u) return w4h[o];
    if (c == 5u) return w5h[o];
    if (c == 6u) return w6h[o];
    return w7h[o];
}

vec4 myunpack8(uint x) {
    return vec4(
        float((x        ) & 0xFFu),
        float((x >> 8u  ) & 0xFFu),
        float((x >> 16u ) & 0xFFu),
        float((x >> 24u ) & 0xFFu));
}

// 스케일 int8 추출 — 바이트 192+s (u16 96+s/2, 홀짝)
int sc8(uint b16, uint s) {
    uint w = uint(WG16(b16 + 96u + (s >> 1u)));
    int v = int((s & 1u) != 0u ? (w >> 8u) : (w & 0xFFu)) & 0xFF;
    return (v << 24) >> 24;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = gl_WorkGroupID.z;
    uint RPF = pc.rpf;
    uint row0 = gl_WorkGroupID.y * RPF;
    uint n_in = pc.n_in;
    uint nbpc = n_in >> 8;           // 행당 256원소 블록 수
    uint base = tok * n_in;

    // llama 스레드 기하 (q6_K)
    const uint itid = tid % 16u;
    const uint ix = tid / 16u;
    const uint v_im = itid / 8u;
    const uint v_in = itid - 8u * v_im;
    const uint l0 = 4u * v_in;
    const uint is = v_in / 4u;
    const uint ql_off = 64u * v_im + l0;    // ql 바이트 (짝수)
    const uint qh_off = 32u * v_im + l0;    // qh 바이트 (짝수)
    const uint s_off = 8u * v_im + is;
    const uint y_off = 128u * v_im + l0;

    float temp[8];
    for (uint i = 0u; i < RPF; i++) temp[i] = 0.0;

    const uint it_size = 2u;            // 32/16
    for (uint i = 0u; i < RPF; i++) {
        uint row = row0 + i;
        if (row >= pc.n_out) break;
        uint rowbase16 = row * nbpc * 105u;  // 블록 = 105 u16
        float acct = 0.0;
        [[unroll]] for (uint jj = ix; jj < nbpc; jj += it_size) {
            uint b16 = rowbase16 + jj * 105u;
            // ql: 바이트 [ql_off, +3]·[ql_off+32, +35] — u16 2쌍
            uint ql0 = uint(WG16(b16 + (ql_off >> 1u))) | (uint(WG16(b16 + (ql_off >> 1u) + 1u)) << 16);
            uint ql32 = uint(WG16(b16 + (ql_off >> 1u) + 16u)) | (uint(WG16(b16 + (ql_off >> 1u) + 17u)) << 16);
            uint qhw = uint(WG16(b16 + 64u + (qh_off >> 1u))) | (uint(WG16(b16 + 64u + (qh_off >> 1u) + 1u)) << 16);
            // 4쿼터 니블+2비트 조립 (llama :33-47)
            uint q0 = (ql0 & 0x0F0F0F0Fu) | ((qhw & 0x03030303u) << 4);
            uint q1 = (ql32 & 0x0F0F0F0Fu) | ((qhw & 0x0C0C0C0Cu) << 2);
            uint q2 = ((ql0 >> 4) & 0x0F0F0F0Fu) | (qhw & 0x30303030u);
            uint q3 = ((ql32 >> 4) & 0x0F0F0F0Fu) | ((qhw & 0xC0C0C0C0u) >> 2);
            vec4 v0 = myunpack8(q0) - 32.0;
            vec4 v1 = myunpack8(q1) - 32.0;
            vec4 v2 = myunpack8(q2) - 32.0;
            vec4 v3 = myunpack8(q3) - 32.0;
            // 스케일 4 (s_off + 0/2/4/6)
            float sc0 = float(sc8(b16, s_off));
            float sc1 = float(sc8(b16, s_off + 2u));
            float sc2 = float(sc8(b16, s_off + 4u));
            float sc3 = float(sc8(b16, s_off + 6u));
            float d = unpackHalf2x16(uint(WG16(b16 + 104u))).x;
            // y 4쿼터 × vec4
            uint yb = base + jj * 256u + y_off;
            vec4 by0 = vec4(xa[yb], xa[yb + 1u], xa[yb + 2u], xa[yb + 3u]);
            vec4 by32 = vec4(xa[yb + 32u], xa[yb + 33u], xa[yb + 34u], xa[yb + 35u]);
            vec4 by64 = vec4(xa[yb + 64u], xa[yb + 65u], xa[yb + 66u], xa[yb + 67u]);
            vec4 by96 = vec4(xa[yb + 96u], xa[yb + 97u], xa[yb + 98u], xa[yb + 99u]);
            float s0 = fma(by0.x, v0.x, fma(by0.y, v0.y, fma(by0.z, v0.z, by0.w * v0.w)));
            float s1 = fma(by32.x, v1.x, fma(by32.y, v1.y, fma(by32.z, v1.z, by32.w * v1.w)));
            float s2 = fma(by64.x, v2.x, fma(by64.y, v2.y, fma(by64.z, v2.z, by64.w * v2.w)));
            float s3 = fma(by96.x, v3.x, fma(by96.y, v3.y, fma(by96.z, v3.z, by96.w * v3.w)));
            // llama :74 fma 순서
            acct = fma(fma(s0, sc0, fma(s1, sc1, fma(s2, sc2, s3 * sc3))), d, acct);
        }
        temp[i] = acct;
    }
    for (uint i = 0u; i < RPF; i++) {
        uint row = row0 + i;
        if (row >= pc.n_out) break;
        float tot = subgroupAdd(temp[i]);
        if (tid == 0u) outv[tok * pc.n_out + row] = tot;
    }
}
