#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// qk_rope2_np (plans/91 P0) — qk_rope2의 np 판: 행별 pos를 테이블에서
// (프리필은 pos0+행 연속, np는 슬롯별 임의 pos). 행별 산술은 qk_rope2와
// 완전 동일. grid (n_head+n_kv, t).
layout(local_size_x = 64) in;
layout(binding = 0) buffer Xq { float xq[]; };
layout(binding = 1) buffer Xk { float xk[]; };
layout(binding = 2) readonly buffer Qw { float qw[]; };  // [n_head*hd]
layout(binding = 3) readonly buffer Kw { float kw[]; };  // [n_kv*hd]
layout(binding = 4) readonly buffer Cs { float cs[]; };  // [pos][half_n*2]
layout(binding = 5) readonly buffer Pos { uint pos[]; }; // [t] 행별 pos
layout(push_constant) uniform PC {
    float eps; float kqs;
    int nh; int nk; int hd; int nr;
} pc;

shared double sh_sum[64];

void main() {
    int r0 = int(gl_WorkGroupID.x);
    if (r0 >= pc.nh + pc.nk) return;
    int row = int(gl_WorkGroupID.y);
    int tid = int(gl_LocalInvocationID.x);
    bool is_q = r0 < pc.nh;
    int half_n = pc.nr >> 1;
    int csbase = int(pos[uint(row)]) * half_n * 2;
    int row_base = is_q ? row * pc.nh * 2 * pc.hd + r0 * 2 * pc.hd
                        : row * pc.nk * pc.hd + (r0 - pc.nh) * pc.hd;
    // RMS 부분합: 스레드별 f64, shmem 선형 결합 (64-way)
    double psum = 0.0;
    for (int i = tid; i < pc.hd; i += 64) {
        float dv = is_q ? xq[row_base + i] : xk[row_base + i];
        psum += double(dv * dv);
    }
    sh_sum[tid] = psum;
    barrier();
    double sum = 0.0;
    if (tid == 0) {
        for (int i = 0; i < 64; i++) sum += sh_sum[i];
        sh_sum[0] = sum;
    }
    barrier();
    sum = sh_sum[0];
    float scale = 1.0 / float(sqrt(sum / double(pc.hd) + double(pc.eps)));
    for (int i = tid; i < pc.hd; i += 64) {
        float w = is_q ? qw[r0 * pc.hd + i] : kw[(r0 - pc.nh) * pc.hd + i];
        float v = (is_q ? xq[row_base + i] : xk[row_base + i]) * scale * w;
        if (!is_q) v *= pc.kqs;
        if (is_q) xq[row_base + i] = v; else xk[row_base + i] = v;
    }
    // rope 쌍 p = tid (+64 반복)
    for (int p = tid; p < half_n; p += 64) {
        double c = double(cs[csbase + p * 2]);
        double sf = double(cs[csbase + p * 2 + 1]);
        int a = row_base + p, b = a + half_n;
        double x0, x1;
        if (is_q) { x0 = xq[a]; x1 = xq[b]; } else { x0 = xk[a]; x1 = xk[b]; }
        float ra = float(x0 * c - x1 * sf);
        float rb = float(x0 * sf + x1 * c);
        if (is_q) { xq[a] = ra; xq[b] = rb; } else { xk[a] = ra; xk[b] = rb; }
    }
}
