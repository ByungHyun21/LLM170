#version 450

// exl3_had_in_t (plans/121 A1-pp) — T-배치 입력 스테이지:
// A_had[t] = H128(x[t] ⊙ suh) / √128 — exl3_had_in의 행(T) 확장.
// 산술(스케일·RTNE·버터플라이)은 exl3_had_in과 동일 — grid.y = 행.
// x16/ah16은 [T][k] 행 우선(행 스트라이드 = kstride 원소), suh는 행 공유.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer XB { uint x16[]; };    // f16 쌍팩 [T][k/2]
layout(binding = 1) readonly buffer SuhB { uint suh16[]; }; // f16 쌍팩 [k/2]
layout(binding = 2) writeonly buffer AhB { uint ah16[]; };  // f16 쌍팩 [T][k/2]
layout(push_constant) uniform PC { uint kchunks; uint kstride; } pc;

const float R_SCALE = 0.08838834764831845; // 1/sqrt(128)

// f32 → f16 비트 (RTNE) — exl3_had_in 미러(이 드라이버 packHalf2x16 RTZ 회피).
uint f32_to_f16_rtne(float v) {
    uint x = floatBitsToUint(v);
    uint sign = (x >> 16) & 0x8000u;
    uint rest = x & 0x7FFFFFFFu;
    if (rest >= 0x7F800000u) return sign | 0x7C00u | uint((rest & 0x7FFFFFu) != 0u);
    int e = int(rest >> 23) - 127;
    uint man = rest & 0x7FFFFFu;
    uint h;
    if (e >= -14) {
        h = (uint(e + 15) << 10) | (man >> 13);
        uint rem = man & 0x1FFFu;
        if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) h += 1u;
        if (h >= 0x7C00u) h = 0x7C00u;
    } else if (e < -25) {
        return sign;
    } else {
        uint m = 0x800000u | man;
        uint sh = uint(-14 - e) + 13u;
        uint rem = m & ((1u << sh) - 1u);
        h = m >> sh;
        uint halfway = 1u << (sh - 1u);
        if (rem > halfway || (rem == halfway && (h & 1u) != 0u)) h += 1u;
    }
    return sign | h;
}

shared float smem[128];

void main() {
    uint chunk = gl_WorkGroupID.x;
    if (chunk >= pc.kchunks) return;
    uint row = gl_WorkGroupID.y;
    uint base = chunk * 128u;
    uint th = gl_LocalInvocationID.x;

    uint ki = base + th;                  // k 인덱스(suh 공유)
    uint ei = row * pc.kstride + ki;      // 행 우선 원소 인덱스

    // f16 pre-scale — 참조 __hmul2 미러(f32 곱 후 f16 RTNE).
    uint xw = x16[ei >> 1u];
    uint sw = suh16[ki >> 1u];
    vec2 xv = unpackHalf2x16(xw);
    vec2 sv = unpackHalf2x16(sw);
    uint pre = f32_to_f16_rtne(xv[ei & 1u] * sv[ki & 1u]);
    smem[th] = unpackHalf2x16(pre)[0];

    // 자연 순서 WHT — 폭 배증 버터플라이 7단계.
    for (uint w = 1u; w < 128u; w <<= 1u) {
        uint grp = th / w;
        uint blk = (grp >> 1u) * 2u * w;
        uint i = blk + (th % w);
        float a = smem[i];
        float b = smem[i + w];
        barrier();
        smem[i] = a + b;
        smem[i + w] = a - b;
        barrier();
    }

    float o = smem[th] * R_SCALE;
    smem[th] = o;
    barrier();
    if ((th & 1u) == 0u) {
        ah16[ei >> 1u] = f32_to_f16_rtne(smem[th])
                       | (f32_to_f16_rtne(smem[th + 1u]) << 16u);
    }
}
