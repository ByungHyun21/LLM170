#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// exl3_had_out_td (plans/121 메가융합 3호) — 듀얼 gemm2의 단일 sb 슬래브에서
// n_off 열 구간을 환원: 기존 had_out_t 산술 그대로 + 열 오프셋/출력 피치 분리.
// sb는 [T][nstride] 슬래브(nseg=1), y는 [T][ny].
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer SB { float s[]; };
layout(binding = 1) readonly buffer SvhB { uint svh16[]; };
layout(binding = 2) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC {
    uint nchunks;
    uint nseg;
    uint nstride; // sb 행 피치(전체 n_total)
    uint n_off;   // 이 선형의 시작 열
    uint ny;      // y 행 피치(이 선형의 n)
} pc;

const float R_SCALE = 0.08838834764831845;

shared float smem[128];

void main() {
    uint chunk = gl_WorkGroupID.x;
    if (chunk >= pc.nchunks) return;
    uint row = gl_WorkGroupID.y;
    uint base = chunk * 128u;
    uint th = gl_LocalInvocationID.x;

    float v0 = 0.0;
    for (uint g = 0u; g < pc.nseg; g++)
        v0 += s[((row * pc.nseg) + g) * pc.nstride + pc.n_off + base + th];
    smem[th] = v0;
    barrier();
    for (uint w = 1u; w < 128u; w <<= 1u) {
        uint grp = th / w;
        uint blk = (grp >> 1u) * 2u * w;
        uint i = blk + (th % w);
        float a = smem[i];
        float b = smem[i + w];
        barrier();
        smem[i] = a + b;
        smem[i + w] = a - b;
        barrier();
    }
    uint j = base + th;
    float sv = unpackHalf2x16(svh16[j >> 1u])[j & 1u];
    y[row * pc.ny + j] = smem[th] * R_SCALE * sv;
}
