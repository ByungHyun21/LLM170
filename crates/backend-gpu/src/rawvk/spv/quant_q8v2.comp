#version 450

// quant_q8 v2 (plans/95) — f32 x → q8 패킹 xq(qs워드|d워드|s0,s1워드).
// v1 대비: 1스레드=1블록(32원소 순차·인접 스레드 128B 스트라이드 → 29GB/s)
// 를 1스레드=1워드(4원소)로 재매핑 — vec4 판독·인접 스레드 연속(코얼레싱),
// 그룹 amax·합산은 LDS. 산술 비트 동일: amax는 max(순서 무관), 원소별
// round/clamp는 동일식, qs0/qs1은 정수 합(결합 순서 무관) — 게이트 무변.
// round-half-away 명시(trunc(x±0.5)) — Rust round()와 비트 일치.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer Xbuf { float xf[]; };
layout(binding = 1) buffer Qbuf { uint xq[]; };
layout(push_constant) uniform PC {
    uint n_in; uint t; uint xq_w;
} pc;

shared float sham[64];
shared uint shsd[64];

void main() {
    uint tok = gl_WorkGroupID.y;
    uint lb = gl_WorkGroupID.x * 8u + (gl_LocalInvocationID.x >> 3u); // 블록
    uint w = gl_LocalInvocationID.x & 7u;                             // 워드
    uint nblk = pc.n_in >> 5;
    // 주의: 배리어가 있으므로 조기 return 금지(비균일 흐름 UB) — 죽은
    // 스레드는 0 기여 + 쓰기 가드.
    bool live = lb < nblk;
    uint fb = tok * pc.n_in + lb * 32u + w * 4u;
    vec4 v = live ? vec4(xf[fb], xf[fb + 1u], xf[fb + 2u], xf[fb + 3u]) : vec4(0.0);

    // 그룹 amax — 8워드(=블록) 공유, 각 스레드가 8 LDS 값을 읊어 국소 계산.
    sham[gl_LocalInvocationID.x] = max(max(abs(v.x), abs(v.y)), max(abs(v.z), abs(v.w)));
    barrier();
    float amax = 0.0;
    uint g0 = gl_LocalInvocationID.x & ~7u;
    for (int i = 0; i < 8; i++) amax = max(amax, sham[g0 + uint(i)]);
    // f-리터럴 필수 — f64 승격 방지(quantize.cu 동일).
    float d = amax / 127.0f;
    float id = d != 0.0f ? 1.0f / d : 0.0f;

    // 원소 4개 양자화 → 1워드 팩.
    uint word = 0u;
    uint sd = 0u;
    float xs[4] = float[4](v.x, v.y, v.z, v.w);
    for (int k = 0; k < 4; k++) {
        float xv = xs[k] * id;
        float r = xv >= 0.0 ? float(int(xv + 0.5)) : -float(int(0.5 - xv));
        float c = clamp(r, -127.0, 127.0);
        int b8 = int(c);
        word |= (uint(b8) & 0xFFu) << uint(k * 8);
        sd += uint(b8 << 24 >> 24);
    }
    uint qbase = tok * pc.xq_w;
    if (live) xq[qbase + lb * 8u + w] = word;
    shsd[gl_LocalInvocationID.x] = sd;
    barrier();
    if (w == 0u && live) {
        xq[qbase + (pc.n_in >> 2) + lb] = floatBitsToUint(d);
        uint qsb = pc.n_in / 4u + pc.n_in / 32u;
        uint qs0 = 0u, qs1 = 0u;
        for (int i = 0; i < 8; i++) {
            if (i < 4) qs0 += shsd[g0 + uint(i)]; else qs1 += shsd[g0 + uint(i)];
        }
        xq[qbase + qsb + lb * 2u] = qs0;
        xq[qbase + qsb + lb * 2u + 1u] = qs1;
    }
}
