#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// tile_s32 (plans/40) — BM=32 변형: WG 수 4배 (gx=no/32)로 CU당 다중 WG 상주,
// k-루프 글로벌 로드 레이턴시 은폐. tile_llm과 동일한 q5_K 디양자화·f16 shmem 구조.
// 매핑: sg&1 = 행 슬래브(2×16=32행), sg>>1 = 토큰 반(2×32=64토큰).
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xbuf { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint xq_w; uint t;
} pc;

#define BK 32
#define BM 32
#define BN 64
#define SHMEM_STRIDE (BK / 2 + 4)   // 20 vec2

uint WG(uint idx) {
    uint c = idx >> 25u;
    uint o = idx & 0x1FFFFFFu;
    if (c == 0u) return w0c[o];
    if (c == 1u) return w1c[o];
    if (c == 2u) return w2c[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4c[o];
    if (c == 5u) return w5c[o];
    if (c == 6u) return w6c[o];
    return w7c[o];
}

shared f16vec2 buf_a[BM * SHMEM_STRIDE];
shared f16vec2 buf_b[BN * SHMEM_STRIDE];
shared float16_t Ctmp[32][17];

// q5_K 디양자화 → vec2. 스레드당 16k, tid<64만 (32행 × 2k-반).
void load_a(uint k0, int row0, int nrow, int blocks, uint tid) {
    int r = int(tid >> 1);              // 행 0..31
    int kc = int(tid & 1) * 16;         // 0/16
    int row = row0 + r;
    if (row >= nrow + row0) {
        for (int v = 0; v < 8; v++) buf_a[r * SHMEM_STRIDE + (kc >> 1) + v] = f16vec2(float16_t(0.0));
        return;
    }
    uint sb = k0 >> 5;                  // 이 반복의 32k 서브블록
    int js = int(sb & 7);
    int it = js >> 1;
    int halfb = js & 1;
    int wq = ((row * blocks + int(sb >> 3)) * 176) >> 2;
    uint w0 = WG(wq);
    float d = unpackHalf2x16(w0).x;
    float dm = unpackHalf2x16(w0).y;
    uint sc0 = WG(wq+1), sc1 = WG(wq+2), sc2 = WG(wq+3);
    uint r2 = (uint(js & 3)) * 8u;
    uint b_j   = js < 4 ? (sc0 >> r2) & 0xFFu : (sc1 >> r2) & 0xFFu;
    uint b_j4  = js < 4 ? (sc1 >> r2) & 0xFFu : (sc2 >> r2) & 0xFFu;
    uint b_jm4 = (sc0 >> r2) & 0xFFu;
    uint sc_v, m_v;
    if (js < 4) { sc_v = b_j & 63u; m_v = b_j4 & 63u; }
    else {
        sc_v = (b_j4 & 0xFu) | ((b_jm4 >> 6) << 4);
        m_v  = (b_j4 >> 4) | ((b_j >> 6) << 4);
    }
    float ds0 = d * float(sc_v);
    float ds1 = dm * float(m_v);
    uint nsh = uint(halfb << 2);
    int sh = 2 * it + halfb;
    int qbase = wq + 12 + it * 8;
    int qhbase = wq + 4;
    uint qlw[4]; uint qhw[4];
    for (int w = 0; w < 4; w++) {
        qlw[w] = WG(qbase + (kc >> 2) + w);
        qhw[w] = WG(qhbase + (kc >> 2) + w);
    }
    for (int e = 0; e < 16; e += 2) {
        int k0l = kc + e;
        float vals[2];
        for (int h = 0; h < 2; h++) {
            int k = k0l + h;
            uint qlwv = qlw[(k >> 2) & 3];
            uint qhwv = qhw[(k >> 2) & 3];
            uint byte_v = (qlwv >> uint((k & 3) * 8)) & 0xFFu;
            uint nib = (byte_v >> nsh) & 0xFu;
            uint hi = (qhwv >> uint((k & 3) * 8 + sh)) & 1u;
            float wv = float(nib) + (hi != 0u ? 16.0 : 0.0);
            vals[h] = wv * ds0 - ds1;
        }
        buf_a[r * SHMEM_STRIDE + (kc >> 1) + (e >> 1)] = f16vec2(float16_t(vals[0]), float16_t(vals[1]));
    }
}

// 활성 q8 → vec2. 64토큰×32k = 2048 / 256 = 8원소/스레드 (tile_llm 동일).
void load_b(uint k0, int nt, uint tid, int n_in) {
    int e0 = int(tid) * 8;
    int ti2 = e0 >> 5;
    int k2 = e0 & 31;
    if (ti2 >= nt) {
        for (int v = 0; v < 4; v++) buf_b[ti2 * SHMEM_STRIDE + (k2 >> 1) + v] = f16vec2(float16_t(0.0));
        return;
    }
    uint base = uint(ti2) * pc.xq_w;
    int xw = int(k0) >> 2;
    float yd = uintBitsToFloat(xq[base + uint((n_in >> 2) + (k0 >> 5))]);
    for (int e = 0; e < 8; e += 2) {
        float vals[2];
        for (int h = 0; h < 2; h++) {
            uint wv = xq[base + uint(xw + ((k2 + e + h) >> 2))];
            int b = int((wv >> uint(((k2 + e + h) & 3) * 8)) & 0xFFu) << 24 >> 24;
            vals[h] = float(b) * yd;
        }
        buf_b[ti2 * SHMEM_STRIDE + (k2 >> 1) + (e >> 1)] = f16vec2(float16_t(vals[0]), float16_t(vals[1]));
    }
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;   // 0..255
    uint sg = gl_SubgroupID;            // 0..3 (wave64)
    int n_in = int(pc.n_in);
    int nkb = n_in >> 5;
    int blocks = n_in >> 8;
    int row0 = int(bid) * BM;
    int nt = int(min(pc.t, BN));
    int nrow = int(min(BM, pc.n_out - uint(row0)));

    // sg: 행 슬래브 (sg&1)*16, 토큰 반 (sg>>1)*32.
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[2];
    for (int j = 0; j < 2; j++)
        acc[j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint kb = 0; kb < uint(nkb); kb++) {
        if (tid < 64u) load_a(kb * 32u, row0, nrow, blocks, tid);
        load_b(kb * 32u, nt, tid, n_in);
        barrier();
        int rbase = int(sg & 1u) * 16;
        int tbase = int(sg >> 1u) * 32;
        for (uint ks = 0; ks < BK / 16; ks++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
            coopMatLoad(fa, buf_a, (rbase)* SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            for (uint wn = 0; wn < 2; wn++) {
                if (nt > tbase + wn * 16) {
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fbb;
                    coopMatLoad(fbb, buf_b, (tbase + wn * 16) * SHMEM_STRIDE + ks * 8, SHMEM_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                    acc[wn] = coopMatMulAdd(fa, fbb, acc[wn]);
                }
            }
        }
        barrier();
    }

    // 드레인: 각 sg의 acc[wn] = 행 (sg&1)*16 × 토큰 (sg>>1)*32+wn*16.
    for (int q = 0; q < 4; q++) {
        if (nt <= q * 16) break;
        int wn = q - int(sg >> 1u) * 2;
        if (wn >= 0 && wn < 2) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> hf16 =
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[wn]);
            coopMatStore(hf16, Ctmp[(int(sg & 1u)) * 16], 0, 17, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        int ncols = min(nt - q * 16, 16);
        for (int i = int(tid); i < nrow * ncols; i += 256) {
            int r = i / ncols;
            int ti = i % ncols;
            outv[uint(q * 16 + ti) * pc.n_out + uint(row0 + r)] = float(Ctmp[r][ti]);
        }
        barrier();
    }
}
