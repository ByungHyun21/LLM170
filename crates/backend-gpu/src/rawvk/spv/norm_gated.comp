#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// norm_gated_silu — rawhip norm_gated_silu 미러 (kernels.rs:2554).
// 행 = (y·n_h + r) WorkGroupID 인덱싱 (GlobalID×32 오염 방지 — 2026-09-05 RCA).
// z 요소별 [row][d]. 결합: shared f32 부분합 → f64 결합 (rawhip p0..p31 순서).
layout(local_size_x = 32) in;
layout(binding = 0) readonly buffer O { float o[]; };    // [t·n_h][d]
layout(binding = 1) readonly buffer Z { float z[]; };    // [t·n_h][d] (요소별)
layout(binding = 2) readonly buffer W { float w[]; };    // [n_h][d]
layout(binding = 3) buffer Out { float outv[]; };        // [t·n_h][d]
layout(push_constant) uniform PC { float eps; int d; int n_h; } pc; // n_h=dt_rank
shared float sh[32]; // f32 저장 (RADV fp64 shared 우회) — 결합만 f64
void main() {
    int r = int(gl_WorkGroupID.x); // n_h 블록
    int y = int(gl_WorkGroupID.y); // 토큰
    int u = int(gl_LocalInvocationIndex);
    if (r >= pc.n_h) return;
    int row = y * pc.n_h + r;
    int xb = row * pc.d;
    int wb = r * pc.d;
    int chunk = (pc.d + 31) >> 5;
    float part = 0.0;
    int lo = u * chunk;
    if (lo < pc.d) {
        int hi = min(lo + chunk, pc.d);
        for (int i = lo; i < hi; i++) {
            float dv = o[xb + i];
            part += dv * dv;
        }
    }
    sh[u] = part;
    barrier();
    double dsum = 0.0;
    for (int j = 0; j < 32; j++) {
        if (j * chunk < pc.d) dsum += sh[j];
    }
    float inv = 1.0 / float(sqrt(dsum / double(pc.d) + double(pc.eps)));
    if (lo < pc.d) {
        int hi = min(lo + chunk, pc.d);
        for (int i = lo; i < hi; i++) {
            float zz = z[xb + i];
            outv[xb + i] = o[xb + i] * inv * w[wb + i] * (zz / (1.0 + exp(-zz)));
        }
    }
}
