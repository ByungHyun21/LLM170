#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

// fn_moe_tile_q4k_cm (plans/89 P1.1b) — MoE 그룹 프리필 q4_K coopmat 타일.
// 기하: 타일 = (전문가 16행 패딩블록) × (출력 128열) — 패딩 도메인이 16행
// 전문가 정렬(fn_moe_group)이므로 블록 내 전문가 균일(rowexp[r0e]). 스칼라
// 16×16 판([ts] 1602ms/청크)과 달리 전문가 행렬을 블록당 1회 판독해
// 가중 트래픽도 ~rows/블록밀도 절감.
//   · A: 전문가 가중 128출력행×64k f16 LDS(디양자화 q4_K, core deq_q4_k 동일).
//   · B: 16패딩행 xq 를 perm_pad 간접 f16 스테이징.
//   · MMA: acc(sg) = A(16행×16k)·B(16k×16행) — 서브그룹당 1 acc.
// 그리드 (⌈n_out/128⌉, ⌈bound/16⌉), 512스레드 = 8sg×16행.
// 수치계약: f16 스테이징 — 27B 타일/llama pp와 동일 계약.
layout(local_size_x = 512) in;
layout(binding = 0) readonly buffer W0 { uint w0c[]; };
layout(binding = 1) readonly buffer W1 { uint w1c[]; };
layout(binding = 2) readonly buffer W2 { uint w2c[]; };
layout(binding = 3) readonly buffer W3 { uint w3c[]; };
layout(binding = 4) readonly buffer W4 { uint w4c[]; };
layout(binding = 5) readonly buffer W5 { uint w5c[]; };
layout(binding = 6) readonly buffer W6 { uint w6c[]; };
layout(binding = 7) readonly buffer W7 { uint w7c[]; };
layout(binding = 8) readonly buffer Xbuf { uint xq[]; };
layout(binding = 9) buffer Obuf { float outv[]; };
layout(binding = 10) readonly buffer Rx { uint rowexp[]; };
layout(binding = 11) readonly buffer Rp { uint rows_pad[]; };
layout(binding = 12) readonly buffer Pp { uint perm_pad[]; };
layout(push_constant) uniform PC {
    uint n_in; uint n_out; uint per_expert_bytes; uint chunk_words; uint xq_w; uint mode; uint rows;
} pc;

shared float16_t A16[128][68];
shared float16_t B16[16][68];
shared float16_t Ctmp[128][17];

uint WG(uint idx) {
    uint c = idx >> 25u;
    uint o = idx & 0x1FFFFFFu;
    if (c == 0u) return w0c[o];
    if (c == 1u) return w1c[o];
    if (c == 2u) return w2c[o];
    if (c == 3u) return w3c[o];
    if (c == 4u) return w4c[o];
    if (c == 5u) return w5c[o];
    if (c == 6u) return w6c[o];
    return w7c[o];
}

// q4_K 32원소 서브블록 디양자화(core deq_q4_k 동일): 서브블록 sb는 슈퍼블록
// (sb>>3, 144B) 헤더 공유, it=(sb>>1)&3, hilo=sb&1, 스케일쌍 = it*2+hilo
// (scale_min_k4 충실 이식), 니블 = qs 바이트 it*32+l 의 hi/lo.
void stage_a(int sb, int colb, int row0, int nrow, uint ebase, uint row_words, int tid) {
    int r = int(tid >> 2);
    int kc = int(tid & 3) * 8;
    int row = row0 + r;
    if (row < row0 + nrow) {
        uint wq = ebase + uint(row) * row_words + uint(sb >> 3) * 36u;
        vec2 dd = unpackHalf2x16(WG(wq));
        float d = dd.x, dmin = dd.y;
        int it = (sb >> 1) & 3;
        int hilo = sb & 1;
        int sj = it * 2 + hilo;
        uint s_v, m_v;
        if (sj < 4) {
            s_v = (WG(wq + 1u + uint(sj >> 2)) >> uint((sj & 3) * 8)) & 63u;
            uint mb = sj + 4;
            m_v = (WG(wq + 1u + uint(mb >> 2)) >> uint((mb & 3) * 8)) & 63u;
        } else {
            uint sb_lo = (WG(wq + 1u + uint((sj + 4) >> 2)) >> uint(((sj + 4) & 3) * 8)) & 0xFFu;
            uint sb_jm4 = (WG(wq + 1u + uint((sj - 4) >> 2)) >> uint(((sj - 4) & 3) * 8)) & 0xFFu;
            uint sb_j = (WG(wq + 1u + uint(sj >> 2)) >> uint((sj & 3) * 8)) & 0xFFu;
            s_v = (sb_lo & 0xFu) | ((sb_jm4 >> 6) << 4);
            m_v = (sb_lo >> 4) | ((sb_j >> 6) << 4);
        }
        float ds0 = d * float(s_v);
        float ds1 = dmin * float(m_v);
        for (int e = 0; e < 8; e++) {
            int l = kc + e;
            uint qv = WG(wq + 4u + uint((it * 32 + l) >> 2));
            uint nib = (qv >> uint((((it * 32 + l) & 3) * 8) + (hilo << 2))) & 0xFu;
            A16[r][colb + l] = float16_t(float(nib) * ds0 - ds1);
        }
    } else {
        for (int e = 0; e < 8; e++) A16[r][colb + kc + e] = float16_t(0.0);
    }
}

// B: 16패딩행 × 32원소 = 512스레드 × 1원소. 행 = r0e + (tid>>5).
void stage_b(int sb, int colb, bool live, int nt16, int tid, int r0e) {
    int rb = int(tid >> 5);
    int k2 = int(tid & 31);
    if (live && rb < nt16) {
        uint base = perm_pad[uint(r0e + rb)] * pc.xq_w;
        int xw = sb << 3;
        float yd = uintBitsToFloat(xq[base + uint((int(pc.n_in) >> 2) + sb)]);
        uint wv = xq[base + uint(xw + (k2 >> 2))];
        int b = int((wv >> uint((k2 & 3) * 8)) & 0xFFu) << 24 >> 24;
        B16[rb][colb + k2] = float16_t(float(b) * yd);
    } else {
        B16[rb][colb + k2] = float16_t(0.0);
    }
}

void main() {
    uint bid = gl_WorkGroupID.x;
    uint tidy = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    int n_in = int(pc.n_in);
    int n_sub = n_in >> 5;
    int row0 = int(bid) * 128;                 // 출력열 기저
    int nrow = int(min(128u, pc.n_out - uint(row0)));
    int r0e = int(tidy) * 16;                  // 전문가 16행 패딩블록 기저
    uint rp = rows_pad[0];
    if (uint(r0e) >= rp) return;               // WG 균일 조기탈출(배리어 전)
    uint e = rowexp[uint(r0e)];
    int nt16 = int(min(16u, rp - uint(r0e)));
    uint row_words = uint(n_in >> 8) * 36u;
    uint ebase = e * (pc.per_expert_bytes >> 2);

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (int sb = 0; sb < n_sub; sb += 2) {
        stage_a(sb, 0, row0, nrow, ebase, row_words, int(tid));
        stage_b(sb, 0, true, nt16, int(tid), r0e);
        bool live2 = sb + 1 < n_sub;
        stage_a(sb + 1, 32, row0, nrow, ebase, row_words, int(tid));
        stage_b(sb + 1, 32, live2, nt16, int(tid), r0e);
        barrier();
        for (int ks = 0; ks < 4; ks++) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
            coopMatLoad(fa, A16[sg << 4], ks * 16, 68, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fbb;
            coopMatLoad(fbb, B16[0], ks * 16, 68, gl_CooperativeMatrixLayoutColumnMajor);
            acc = coopMatMulAdd(fa, fbb, acc);
        }
        barrier();
    }

    // 드레인: acc(16출력행×16패딩행) → Ctmp[128][17] → yg.
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> hf16 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc);
    coopMatStore(hf16, Ctmp[sg << 4], 0, 17, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (int i = int(tid); i < nrow * nt16; i += 512) {
        int r = i / nt16;        // 출력행 로컬
        int rb = i - r * nt16;   // 패딩행 로컬
        outv[uint(r0e + rb) * pc.n_out + uint(row0 + r)] = float(Ctmp[r][rb]);
    }
}
