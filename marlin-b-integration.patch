             ),
         )
     }
+
+    /// [marlin (b) 2026-10-12] marlin B 레이아웃 GEMM 발사 — t≤16은 m16
+    /// (M16×N256·128스레드 — 디코드·소형 청크), t≥17은 m64(M64×N128·256
+    /// 스레드). A = dx16 미러(불변식: cast_x32/norm_resid/ew 융합이 dx32와
+    /// 함께 기록 — 기존 mma 경로와 동일 계약). 값은 mma·GEMV 레인과
+    /// 비트동일(§3.1 배터리 판정 — 골든 불변).
+    pub(in crate::rawcuda::w4a16_dec) fn marlin_launch(
+        &mut self,
+        name: &str,
+        y_out: CUdeviceptr,
+        t: usize,
+    ) -> Result<(), String> {
+        let (dq, ds, n, k) = self.lin_spec(name)?;
+        if self.dx16.cap < t * k {
+            return Err(format!(
+                "marlin({name}): dx16 부족 {} < t×k={}",
+                self.dx16.cap,
+                t * k
+            ));
+        }
+        let (sym, gm, gn, blk) = if t <= 16 {
+            ("w4a16_gemm_g128_marlin_m16", 16usize, 256usize, 128u32)
+        } else {
+            ("w4a16_gemm_g128_marlin", GEMM_MMA_M, GEMM_MMA_N, 256u32)
+        };
+        let f = self.cc.function(sym)?;
+        let (mut p_q, mut p_s, mut p_x, mut p_y) = (dq, ds, self.dx16.ptr, y_out);
+        let (mut p_n, mut p_k, mut p_t) = (n as i32, k as i32, t as i32);
+        self.cc.launch(
+            f,
+            t.div_ceil(gm) as u32,
+            n.div_ceil(gn) as u32,
+            blk,
+            &mut crate::rawcuda::args::l7(
+                &mut p_q, &mut p_s, &mut p_x, &mut p_y, &mut p_n, &mut p_k, &mut p_t,
+            ),
+        )
+    }
+
+    /// [marlin (b)] 다중세그먼트(gemv_multi*)의 marlin 대체 — 원본 레이아웃
+    /// 전용 multi 커널을 쓸 수 없을 때 층 그룹 가중치를 개별 런치로.
+    /// group 0 = 풀어텐션 q/k/v(→d0,d1,d2) · GDN qkv/z(→d0,d1),
+    /// group 1 = ffn gate/up(→d0,d1). x는 dx16 미러(norm 융합 기록 전제 —
+    /// 호출부 불변식 그대로).
+    pub(in crate::rawcuda::w4a16_dec) fn lin_group_marlin(
+        &mut self,
+        il: usize,
+        group: usize,
+        d: [CUdeviceptr; 3],
+        t: usize,
+    ) -> Result<(), String> {
+        let interval = self.attn.attn.ok_or("attn: 형상 미등록")?.interval;
+        if group == 0 {
+            if (il + 1) % interval == 0 {
+                self.marlin_launch(&format!("blk.{il}.attn_q.weight"), d[0], t)?;
+                self.marlin_launch(&format!("blk.{il}.attn_k.weight"), d[1], t)?;
+                self.marlin_launch(&format!("blk.{il}.attn_v.weight"), d[2], t)?;
+            } else {
+                self.marlin_launch(&format!("blk.{il}.attn_qkv.weight"), d[0], t)?;
+                self.marlin_launch(&format!("blk.{il}.attn_gate.weight"), d[1], t)?;
+            }
+        } else {
+            self.marlin_launch(&format!("blk.{il}.ffn_gate.weight"), d[0], t)?;
+            self.marlin_launch(&format!("blk.{il}.ffn_up.weight"), d[1], t)?;
+        }
+        Ok(())
+    }
 }
