+    /// w4a16_gemm_g128_marlin 참조). 계약: k%128==0(커널 kg=k>>7 스케일
+    /// 인덱싱) · n%64==0(qm 타일).
+    pub fn upload_lin_marlin(
+        &mut self,
+        name: &str,
+        qm: &[u8],
+        s: &[u8],
+        n: usize,
+        k: usize,
+    ) -> Result<(), String> {
+        if s.len() != n * (k / 64) {
+            return Err(format!(
+                "upload_lin_marlin {name}: s={} != n{n} k{k} 계약",
+                s.len()
+            ));
+        }
+        if !k.is_multiple_of(128) || !n.is_multiple_of(64) {
+            return Err(format!(
+                "upload_lin_marlin {name}: k%128·n%64 계약 위반 k={k} n={n}"
+            ));
+        }
+        let want = (k / 16) * (n / 64) * 128 * 4;
+        if qm.len() != want {
+            return Err(format!(
+                "upload_lin_marlin {name}: qm={} != (k/16)(n/64)128×4 = {want}",
+                qm.len()
+            ));
+        }
+        // G2: alloc 전량 성공 → h2d 성공 시에만 상주 등록(재시도 처음부터).
+        let dq = self.cc.alloc(qm.len())?;
+        let ds = match self.cc.alloc(s.len()) {
+            Ok(p) => p,
+            Err(e) => {
+                let _ = self.cc.free(dq);
+                return Err(e);
+            }
+        };
+        let r = (|| {
+            Self::h2d_chunked(&self.cc, dq, qm)?;
+            Self::h2d_chunked(&self.cc, ds, s)
+        })();
+        if let Err(e) = r {
+            let _ = self.cc.free(dq);
+            let _ = self.cc.free(ds);
+            return Err(e);
+        }
+        // 모니터링은 원래 가중치 바이트 기준(qm과 동일 크기 + 스케일).
+        self.weights_bytes += (qm.len() + s.len()) as u64;
+        if let Some((oq, os, _, _)) = self.lins.insert(name.to_string(), (dq, ds, n, k)) {
+            let _ = self.cc.free(oq);
+            let _ = self.cc.free(os);
+        }
+        self.lin_marlin = true;
+        Ok(())
+    }
+
     
